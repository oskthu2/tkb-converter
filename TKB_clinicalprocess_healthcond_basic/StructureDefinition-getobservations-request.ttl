       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getobservations-request.time" ] ;
       fhir:ElementDefinition.path [ fhir:value "getobservations-request.time" ] ;
       fhir:ElementDefinition.short [ fhir:value "Begränsar sökningen till angivet tidsintervall (TimePeriodType)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till det angivna intervallet. Om tidsattributet Observation.Time i svaret är en tidpunkt innebär begränsningen att endast poster returneras där Observation.Time i svaret ligger inom sökintervallets start- och sluttidpunkt.\n\nOm tidsattributet Observation.Time i svaret är ett intervall innebär begränsningen att endast poster returneras där tidsintervallet som anges i attributet Observation.Time i svaret, överlappar med det angivna sökintervallet, dvs.\n\ndet bildade intervallets starttidpunkt ligger inom sökintervallets start- och sluttidpunkt\n\ndet bildade intervallets sluttidpunkt ligger inom sökintervallets start- och sluttidpunkt\n\ndet bildade intervallets starttidpunkt ligger före sökintervallets starttidpunkt och sluttidpunkt ligger efter sökintervallets sluttidpunkt" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `time` (`TimePeriodType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
