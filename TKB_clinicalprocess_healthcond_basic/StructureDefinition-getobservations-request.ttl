       fhir:ElementDefinition.short [ fhir:value "Identitet för en specifik observation (IIType)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ett unikt värde för själva observationen som också refererar till vilket källsystem informationen kommer ifrån. Motsvarar observation/id i svaret." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `observationId` (`IIType`, kardinalitet 0..*).\n\n**Modellanteckning:** Motsvarar observation/id i svaret.\n- root: källsystemets HSA-id.\n- extension: den i källsystemet unika identiteten för observationen." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
