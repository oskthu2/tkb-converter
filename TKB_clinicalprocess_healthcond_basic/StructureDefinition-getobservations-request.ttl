       fhir:ElementDefinition.definition [ fhir:value "Begränsning av sökning mha HSAid för (PDL) vårdenhet som har ansvar för dokumentationen av obdervationen/observationerna." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careUnitId` (`IIType`, kardinalitet 0..1).\n\n**Modellanteckning:** - root: OID för HSA-id, 1.2.752.129.2.1.4.1.\n- extension: HSA-id för PDL-vårdenheten." ] ;
