       fhir:ElementDefinition.path [ fhir:value "getobservations-request.time.start" ] ;
       fhir:ElementDefinition.short [ fhir:value "Startdatum. Format ÅÅÅÅMMDDttmmss (TimeStampType)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Startdatum. Format ÅÅÅÅMMDDttmmss." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `time.start` (`TimeStampType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
