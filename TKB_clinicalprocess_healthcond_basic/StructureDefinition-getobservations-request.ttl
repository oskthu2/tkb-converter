       fhir:ElementDefinition.short [ fhir:value "HSA-id för det källsystem inom vilket observationens id är unikt." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Används när man vill söka ur ett specifikt källsystem.\nVärdet måste överensstämma med logicalAddress i anropets tekniska kuvertering (SOAP-header).\nFältet är tvingande om observationId angivits.\nOID för HSA-id: 1.2.752.129.2.1.4.1" ] ;
