       fhir:ElementDefinition.short [ fhir:value "Begränsar sökningen till angivet tidsintervall (TimePeriodType)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Om Observation.time i svaret är en tidpunkt returneras poster där tidpunkten ligger inom sökintervallet.\nOm Observation.time är ett intervall returneras poster vars intervall överlappar sökintervallet." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
