       fhir:ElementDefinition.path [ fhir:value "getobservations-request.observationCodedValue" ] ;
       fhir:ElementDefinition.short [ fhir:value "Begränsning av sökning till ett visst kodat värde som är utfallet av en observation." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Filtrerar på observations/observationBody/value. Används då observationType inte\nkan användas för att begränsa sökmängden.\nFälten codeSystemVersion och displayName ska ignoreras i begäran och ej skickas." ] ;
