       fhir:ElementDefinition.path [ fhir:value "getobservations-request.observationId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Begränsning av sökning till en viss observation." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Filtrerar på observations/observationBody/id.\nIdentiteten ska garanterat vara unik inom vårdgivaren.\n- root: Den informationsägande vårdgivarens HSA-id\n- extension: Den inom vårdgivaren unika id-beteckningen för observationen\nOm observationId anges är sourceSystemHSAId tvingande." ] ;
