       fhir:ElementDefinition.short [ fhir:value "PatientType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den patient som observationsgruppen avser." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `patient` (`PatientType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
