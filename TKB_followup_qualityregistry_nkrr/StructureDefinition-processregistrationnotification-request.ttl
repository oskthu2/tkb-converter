       fhir:Element.id [ fhir:value "processregistrationnotification-request.type" ] ;
       fhir:ElementDefinition.path [ fhir:value "processregistrationnotification-request.type" ] ;
       fhir:ElementDefinition.short [ fhir:value "type" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den typ av registrering i kvalitetsregistret som notifieringen avses ge upphov till.\n\nSka anges enligt den informationsspecifikation som kvalitetsregistret tillhandahåller för att beskriva hanteringen av notifiering till registret." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `type` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "processregistrationnotification-request.type" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "processregistrationnotification-request.patientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "processregistrationnotification-request.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "patientId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för patienten där fältet extension sätts till patientens identitetsbeteckning. Anges med 12 tecken utan avskiljare.\n\nFältet root sätts till OID för typ av identifierare.\n\nFör personnummer ska Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas.\n\nFör samordningsnummer ska Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `patientId` (`IIType`, kardinalitet 1..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "processregistrationnotification-request.patientId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "processregistrationnotification-request.healthcareProviderId" ] ;
       fhir:ElementDefinition.path [ fhir:value "processregistrationnotification-request.healthcareProviderId" ] ;
       fhir:ElementDefinition.short [ fhir:value "healthcareProviderId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för informationsägande vårdgivare för informationen i notifieringen.\n\nAnges för att möjliggöra spårbarhet till informationsägande vårdgivare för informationen som lämnas ut och som hanteras av informationsmottaren eller andra parter.\n\nI första hand HSA-id alternativt i andra hand organisationsnummer.\n\nOm HSA-id används sätts fältet root till OID för HSA-katalogen (1.2.752.129.2.1.4.1) och fältet extension sätts till HSA-id.\n\nOm organisationsnummer används skall fältet root sättas till OID för organisationsnummer (1.2.752.29.4.3) och fältet extension sättas till organisationsnumret.\n\nEnskild näringsidkare har i rollen som juridisk person sitt personnummer som organisationsnummer." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `healthcareProviderId` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "processregistrationnotification-request.healthcareProviderId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "processregistrationnotification-request.registerUnitId" ] ;
       fhir:ElementDefinition.path [ fhir:value "processregistrationnotification-request.registerUnitId" ] ;
       fhir:ElementDefinition.short [ fhir:value "registerUnitId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för registerenhet.\n\nRegisterenhet är den minsta indelning av datatillhörighet som ett kvalitetsregister använder för registrering och analys av data. Inte sällan motsvarar en registerenhet en vårdenhet inom vårdgivaren, men inte alltid.\n\nSka anges enligt den informationsspecifikation som kvalitetsregistret tillhandahåller för att beskriva hanteringen av notifiering till registret." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `registerUnitId` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "processregistrationnotification-request.registerUnitId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "processregistrationnotification-request.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "processregistrationnotification-request.reference" ] ;
       fhir:ElementDefinition.short [ fhir:value "ReferenceType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information om referenser till tidigare registreringar i kvalitetsregistret. Informationen används för att ge rätt kontext på den avsedda registreringen.\n\nSka anges enligt den informationsspecifikation som kvalitetsregistret tillhandahåller för att beskriva hanteringen av notifiering till registret." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `reference` (`ReferenceType`, kardinalitet 0..*)." ] ;
