<wsdl:definitions 
	name='ProcessRegistrationNotificationInteraction' 
	xmlns:wsdl='http://schemas.xmlsoap.org/wsdl/' 
	xmlns:soap='http://schemas.xmlsoap.org/wsdl/soap/' 
	xmlns:xs='http://www.w3.org/2001/XMLSchema' 
	xmlns:tjsr='urn:riv:followup:qualityregistry:nkrr:ProcessRegistrationNotificationResponder:1' 
	xmlns:tjsi='urn:riv:followup:qualityregistry:nkrr:ProcessRegistrationNotificationInitiator:1' 
	xmlns:tns='urn:riv:followup:qualityregistry:nkrr:ProcessRegistrationNotification:1:rivtabp21' 
	targetNamespace='urn:riv:followup:qualityregistry:nkrr:ProcessRegistrationNotification:1:rivtabp21' 
	xmlns:itr='urn:riv:itintegration:registry:1'>

  <wsdl:documentation>
      Tjänsteinteraktionens namn: ProcessRegistrationNotificationInteraction
      Beskrivning: Hämtning av förifyllnadsunderlag  till kvalitetsregister
      Revisioner: 2022-05-02 Version 1.2
      Tjänstedomän: followup:qualityregistry:nkrr
      Tjänsteinteraktionstyp: Fråga-Svar
      RIV Teknisk Anvisning: RIVTABP21
      Förvaltas av: Sveriges Kommuner och Landsting
 </wsdl:documentation>
  <wsdl:types>
    <xs:schema targetNamespace='urn:riv:followup:qualityregistry:nkrr:ProcessRegistrationNotification:1:rivtabp21'>
      <xs:import schemaLocation='ProcessRegistrationNotificationResponder_1.0.xsd' namespace='urn:riv:followup:qualityregistry:nkrr:ProcessRegistrationNotificationResponder:1' />
      <xs:import schemaLocation='../../core_components/itintegration_registry_1.0.xsd' namespace='urn:riv:itintegration:registry:1' />
    </xs:schema>
  </wsdl:types>
  <wsdl:message name='ProcessRegistrationNotificationRequest'>
    <wsdl:part name='LogicalAddress' element='itr:LogicalAddress'>
      <wsdl:documentation>Den logiska adressen i anropet ska innehålla informationsägande enhets HSA-Id.</wsdl:documentation>
    </wsdl:part>
    <wsdl:part name='parameters' element='tjsr:ProcessRegistrationNotification' />
  </wsdl:message>
  <wsdl:message name='ProcessRegistrationNotificationResponse'>
    <wsdl:part name='parameters' element='tjsr:ProcessRegistrationNotificationResponse' />
  </wsdl:message>
  <wsdl:portType name='ProcessRegistrationNotificationResponderInterface'>
    <wsdl:operation name='ProcessRegistrationNotification'>
      <wsdl:input message='tns:ProcessRegistrationNotificationRequest' />
      <wsdl:output message='tns:ProcessRegistrationNotificationResponse' />
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name='ProcessRegistrationNotificationResponderBinding' type='tns:ProcessRegistrationNotificationResponderInterface'>
    <wsdl:documentation>Tjänsten tillämpar verksamhetsbaserad adressering. Det innebär att den logiska adressen i anropet ska innehålla informationsägande enhets HSA-Id. </wsdl:documentation>
    <soap:binding style='document' transport='http://schemas.xmlsoap.org/soap/http' />
    <wsdl:operation name='ProcessRegistrationNotification'>
      <soap:operation soapAction='urn:riv:followup:qualityregistry:nkrr:ProcessRegistrationNotificationResponder:1:ProcessRegistrationNotification' style='document' />
      <wsdl:input>
        <soap:header use='literal' message='tns:ProcessRegistrationNotificationRequest' part='LogicalAddress' />
        <soap:body use='literal' parts='parameters' />
      </wsdl:input>
      <wsdl:output>
        <soap:body use='literal' />
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name='ProcessRegistrationNotificationResponderService'>
    <wsdl:port name='ProcessRegistrationNotificationResponderPort' binding='tns:ProcessRegistrationNotificationResponderBinding'>
      <soap:address location='http://tempuri.org' />
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>