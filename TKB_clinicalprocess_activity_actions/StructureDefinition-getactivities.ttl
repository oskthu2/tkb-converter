       fhir:ElementDefinition.short [ fhir:value "Patientens födelsedatum" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Anger patientens födelseår, månad och dag. Ej personnummer! Format ÅÅÅÅMMDD.\nKardinalitet: Obligatorisk." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
