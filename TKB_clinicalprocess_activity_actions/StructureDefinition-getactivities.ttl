       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för tjänstekontraktet GetActivities\n(RIV-TA urn:riv:clinicalprocess:activity:actions:GetActivities:1).\nRepresenterar responsens informationsstruktur — en lista av activityGroup-element." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getactivities.activityGroup" ] ;
       fhir:ElementDefinition.path [ fhir:value "getactivities.activityGroup" ] ;
       fhir:ElementDefinition.short [ fhir:value "Grupp av aktiviteter" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Grupp av aktiviteter som delar samma patient, utförare, signerare, ytterligare deltagare,\nkällsystem, vårdprocess-id, utrustning, samt plats. Teknisk optimering för att minska\nredundant data i de fall då flera aktiviteter gjorts med samma medverkande.\nKardinalitet: Valfri, lista." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
