       fhir:ElementDefinition.short [ fhir:value "Id för patienten" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för patienten (IIType). Ska anges med 12 tecken utan avskiljare.\nroot = OID för typ av identifierare (personnummer: 1.2.752.129.2.1.3.1,\nsamordningsnummer: 1.2.752.129.2.1.3.3, reservnummer: lokalt OID).\nKardinalitet: Obligatorisk." ] ;
