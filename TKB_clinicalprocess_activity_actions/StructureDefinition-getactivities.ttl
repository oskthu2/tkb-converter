       fhir:ElementDefinition.short [ fhir:value "Patientens kön" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Anger patientens kön (CVType). Kodas enligt KV kön OID 1.2.752.129.2.2.1.1.\nKoder: 0=okänt, 1=man, 2=kvinna, 9=ej tillämpligt.\nKardinalitet: Valfri." ] ;
