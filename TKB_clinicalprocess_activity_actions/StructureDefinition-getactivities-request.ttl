       fhir:ElementDefinition.short [ fhir:value "Filter på vårdgivare" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till aktivitet från en specifik vårdgivare (IIType).\nroot = OID för HSA-id: 1.2.752.129.2.1.4.1. extension = HSA-id för vårdgivaren.\nKardinalitet: Valfri." ] ;
