       fhir:ElementDefinition.path [ fhir:value "getactivities-request.activityId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Filter på aktivitetsidentifierare" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Unikt värde för aktiviteten som också refererar till vilket källsystem informationen kommer ifrån.\nMotsvarar activity/id i svaret (IIType).\nroot = källsystemets HSA-id, extension = unikt id i källsystemet.\nKardinalitet: Valfri, lista." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
