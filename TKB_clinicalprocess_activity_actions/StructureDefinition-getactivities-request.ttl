       fhir:ElementDefinition.path [ fhir:value "getactivities-request.sourceSystemId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Filter på källsystem" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till aktivitet som är skapad i det angivna källsystemet (IIType).\nroot = OID för HSA-id: 1.2.752.129.2.1.4.1. extension = HSA-id för källsystemet.\nKardinalitet: Valfri." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
