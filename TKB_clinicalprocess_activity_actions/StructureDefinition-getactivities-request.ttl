       fhir:ElementDefinition.short [ fhir:value "CVType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till en viss typ av aktivitet. Motsvarar activity.code i svaret." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `activityCode` (`CVType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
