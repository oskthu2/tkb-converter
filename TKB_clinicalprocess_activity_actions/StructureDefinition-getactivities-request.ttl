       fhir:ElementDefinition.path [ fhir:value "getactivities-request.time" ] ;
       fhir:ElementDefinition.short [ fhir:value "Sökintervall (tidsperiod)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till det angivna tidsintervallet (TimePeriodType).\nOm sökningen begränsas med detta attribut ska poster som saknar Activity.Time inte returneras.\nstart och end är båda valfria (0..1 vardera) — format ÅÅÅÅMMDDttmmss.\nKardinalitet: Valfri." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Period" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getactivities-request.activityCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "getactivities-request.activityCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Filter på typ av aktivitet" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till en viss typ av aktivitet (CVType).\nMotsvarar activity.code i svaret.\ncode och codeSystem är obligatoriska; displayName, codeSystemName, codeSystemVersion ska ignoreras.\nKardinalitet: Valfri, lista." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "CodeableConcept" ]
       ]
