<wsdl:definitions name='EndConsentByPatientInteraction'
    xmlns:wsdl='http://schemas.xmlsoap.org/wsdl/'
    xmlns:soap='http://schemas.xmlsoap.org/wsdl/soap/'
    xmlns:xs='http://www.w3.org/2001/XMLSchema'
    xmlns:tjsr='urn:riv:informationsecurity:authorization:consent:EndConsentByPatientResponder:1'
    xmlns:itr='urn:riv:itintegration:registry:1'
    xmlns:tns='urn:riv:informationsecurity:authorization:consent:EndConsentByPatient:1:rivtabp21'
    targetNamespace='urn:riv:informationsecurity:authorization:consent:EndConsentByPatient:1:rivtabp21'>

    <wsdl:documentation>
         Tjänsteinteraktionens namn: EndConsentByPatient
         Beskrivning: 
           Tjänst som anslutar ett samtycke i samtyckestjänsten. Tjänsten är ämnad för patient att avsluta samtycke i förtid. Intyget raderas inte från samtyckestjänsten utan avslutas tidigare än tidigare dokumenterat (ej längre giltig) för historikens skull. Ett avslut kan ej återtas.
         Revisioner: 
         Tjänstedomän: informationsecurity:authorization:consent
         Tjänsteinteraktionstyp: Fråga-Svar
         WS-profil: RIVTABP21
         Förvaltas av: Inera AB
    </wsdl:documentation>
    
    <wsdl:types>
        <xs:schema targetNamespace='urn:riv:informationsecurity:authorization:consent:EndConsentByPatient:1:rivtabp21'>
            <xs:import schemaLocation='EndConsentByPatientResponder_1.0.xsd' namespace='urn:riv:informationsecurity:authorization:consent:EndConsentByPatientResponder:1' />
            <xs:import schemaLocation='../../core_components/itintegration_registry_1.0.xsd' namespace='urn:riv:itintegration:registry:1' />
        </xs:schema>
    </wsdl:types>
    
        
    <wsdl:message name='EndConsentByPatientRequest'>
        <wsdl:part name='LogicalAddress' element='itr:LogicalAddress'>
            <wsdl:documentation>Som logisk adress anges HSA-id för vårdgivaren som samtycket gäller för.</wsdl:documentation>
        </wsdl:part>
    
        <wsdl:part name='parameters' element='tjsr:EndConsentByPatient' />
    </wsdl:message>

    <wsdl:message name='EndConsentByPatientResponse'>
        <wsdl:part name='parameters' element='tjsr:EndConsentByPatientResponse' />
    </wsdl:message>

    <wsdl:portType name='EndConsentByPatientResponderInterface'>
        <wsdl:operation name='EndConsentByPatient'>
            <wsdl:input message='tns:EndConsentByPatientRequest' />
            <wsdl:output message='tns:EndConsentByPatientResponse' />
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name='EndConsentByPatientResponderBinding' type='tns:EndConsentByPatientResponderInterface'>
        <soap:binding style='document' transport='http://schemas.xmlsoap.org/soap/http' />
        <wsdl:operation name='EndConsentByPatient'>
            <soap:operation soapAction='urn:riv:informationsecurity:authorization:consent:EndConsentByPatientResponder:1:EndConsentByPatient' style='document' />
            <wsdl:input>
                <soap:header use='literal' message='tns:EndConsentByPatientRequest' part='LogicalAddress' />
                <soap:body use='literal' parts='parameters' />
            </wsdl:input>
            <wsdl:output>
                <soap:body use='literal' />
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name='EndConsentByPatientResponderService'>
        <wsdl:port name='EndConsentByPatientResponderPort' binding='tns:EndConsentByPatientResponderBinding'>
            <soap:address location='http://tempuri.org' />
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
