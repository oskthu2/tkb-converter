       fhir:ElementDefinition.short [ fhir:value "employeeId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "MedarbetarId. Om samtycket är personligt anges id för den medarbetare som samtycket skall gälla för. Om samtycket gäller all behörig personal på angiven vårdenhet, skall inget medarbetarid anges." ] ;
