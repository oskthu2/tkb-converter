       fhir:ElementDefinition.path [ fhir:value "registerextendedconsent-request.startDate" ] ;
       fhir:ElementDefinition.short [ fhir:value "startDate" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ej obligatoriskt startdatum för intygets giltighetstid. Om ett startdatum är angivet gäller intyget fr.o.m denna tidpunkt, annars gäller samtycket fr.o.m aktuell tidpunkt (registreringstidpunkt)." ] ;
