       fhir:ElementDefinition.path [ fhir:value "registerextendedconsent-request.assertionType" ] ;
       fhir:ElementDefinition.short [ fhir:value "assertionType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Typ av intyg som ger direktåtkomst till information från andra vård-/omsorgsgivare enligt SVOD. Kan vara patientens/brukarens samtycke eller nödsituation." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `assertionType` (`urn:riv:informationsecurity:authorization:consent:2:AssertionTypeType`, kardinalitet 1..1).\n\n**Modellanteckning:** assertionType Tillåtna värden: Consent, Emergency." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
