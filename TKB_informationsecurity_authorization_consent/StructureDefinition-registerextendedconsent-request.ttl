       fhir:ElementDefinition.short [ fhir:value "assertionId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Unik, global identifierare för intyget. Tjänstekonsumenten ansvarar för att generera id:et." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `assertionId` (`urn:riv:informationsecurity:authorization:consent:2:Id`, kardinalitet 1..1)." ] ;
