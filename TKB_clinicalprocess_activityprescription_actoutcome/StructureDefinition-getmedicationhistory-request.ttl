       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getmedicationhistory-request.careGiverHSAId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory-request.careGiverHSAId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careGiverHSAId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till angivna informationsägande vårdgivare. Anges I första hand HSAid, i andra hand organisationsnummer. Motsvarar careGiverHSAId i healthcareProfessionalType i svaret.\n\nOm HSAid används:\n\nroot sätts till OID för HSA-katalogen (1.2.752.129.2.1.4.1)\n\nextension sätts till HSA-id\n\nOm organisationsnummer används:\n\nroot sätts till OID för organisationsnummer (1.2.752.29.4.3)\n\nextension sätts till organisationsnumret. Enskild näringsidkare har i rollen som juridisk person sitt personnummer som organisationsnummer." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careGiverHSAId` (`HSAIdType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType>
         ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getmedicationhistory-request.patientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory-request.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "patientId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till angiven personidentifierare för en patient. Tjänsteproducenten ska i svaret leverera alla uppgifter kopplad till patienten, dvs. även uppgifter som har registrerats på andra, till individen, kopplade personidentifierare.\n\nid sätts till patientens identifierare. Anges med 12 tecken utan avskiljare.\n\ntype sätts till OID för typ av personidentifierare.\n\nFör personnummer ska Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas.\n\nFör samordningsnummer skall Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas.\n\nFör andra typer av personidentifierare sätts type till aktuell OID." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `patientId` (`PersonIdType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/PersonIdType" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getmedicationhistory-request.datePeriod" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory-request.datePeriod" ] ;
       fhir:ElementDefinition.short [ fhir:value "datePeriod" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till det angivna intervallet. Begränsningen innebär att endast poster returneras där datumintervallet, som bildas av ordinationstidpunkt (medicationMedicalRecordBody/medicationPrescription/prescriber/authorTime) och utsättningstidpunkt (medicationMedicalRecordBody/endOfTreatment) i svaret, helt eller delvis överlappar med det angivna sökintervallet, dvs.\n\ndet bildade intervallets startdatum ligger inom sökintervallets start- och slutdatum\n\ndet bildade intervallets slutdatum ligger inom sökintervallets start- och slutdatum\n\ndet bildade intervallets startdatum ligger före sökintervallets startdatum och slutdatum ligger efter sökintervallets slutdatum\n\nI de fall ordinationstidpunkt inte är angivet ersätts denna tidpunkt med insättningstidpunkt (medicationMedicalRecordBody/startOfTreatment). Om även insättningstidpunkt saknas ersätts denna tidpunkt med registreringstidpunkt (medicationMedicalRecordHeader/accountableHealthcareProfessional/authorTime).\n\nI de fall utsättningstidpunkt inte finns angivet är det bildade intervallet öppet från ordinationstidpunkten och framåt i tiden.\n\nNotera att sökintervallet beskrivs som ett datumintervall. Vid jämförelse konverteras datapostens tidpunkter till datum." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `datePeriod` (`DatePeriodType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/DatePeriodType" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "getmedicationhistory-request.sourceSystemHSAId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory-request.sourceSystemHSAId" ] ;
       fhir:ElementDefinition.short [ fhir:value "sourceSystemHSAId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till journalposter som är skapade i det angivna källsystemet. Tjänsteproducenten förväntas enbart returnera poster som tillhör efterfrågat källsystem.\n\nVärdet på detta fält måste överensstämma med värdet på logicalAddress i anropets tekniska kuvertering (ex. SOAP-header).\n\nDet innebär i praktiken att aggregerande tjänster inte används när detta fält anges.\n\nSka anges om careContactId angivits.\n\nSka anges vid begäran på LRID.\n\nOm sourceSystemHSAId och logicalAddress är olika ska ett svar endast innehålla en resultType med result.resultCode satt till ERROR samt result.errorCode satt till INVALID_REQUEST\n\nOm careContactId är satt och sourceSystemHSAId är tomt ska ett svar endast innehålla en resultType med  result.resultCode satt till ERROR samt result.errorCode satt till INVALID_REQUEST." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `sourceSystemHSAId` (`HSAIdType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType>
         ]
       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "getmedicationhistory-request.careContactId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory-request.careContactId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careContactId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till den läkemedelsinformation som föranletts av den vård- och omsorgskontakt som anges. Identiteten är unik inom källsystemet. Alla typer av ordinationer (insättningar, ändringar och utsättningar) som gjorts vid vård-och omsorgskontakten omfattas här." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careContactId` (`string`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "getmedicationhistory-request.prescriptionChainId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory-request.prescriptionChainId" ] ;
       fhir:ElementDefinition.short [ fhir:value "prescriptionChainId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ordinationskedje-id.\n\nAnvänds för att endast ge poster avseende en viss ordinationskedja. Om producenten saknar stöd för kedjor, så returneras alla poster med angiven status (och som möter övriga sökvillkor)" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `prescriptionChainId` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "getmedicationhistory-request.prescriptionStatus" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory-request.prescriptionStatus" ] ;
       fhir:ElementDefinition.short [ fhir:value "prescriptionStatus" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till endast de ordinationer som är aktiva eller inaktiva, om inget anges ska alla ordinationer returneras, om den är satt till Active ska enbart den ”aktuella läkemedelslistan” returneras." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `prescriptionStatus` (`PrescriptionStatusEnum`, kardinalitet 0..1).\n\n**Modellanteckning:** prescriptionStatus Tillåtna värden: Active, Inactive." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "code" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://fhir.inera.se/ig/clinicalprocess-activityprescription-actoutcome/ValueSet/prescriptionstatus-vs" ;
           fhir:link <https://fhir.inera.se/ig/clinicalprocess-activityprescription-actoutcome/ValueSet/prescriptionstatus-vs>
         ]
       ]
     ]
  ] .

