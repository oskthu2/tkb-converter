       fhir:ElementDefinition.short [ fhir:value "Utsättningstidpunkt" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Utsättningstidpunkt.\n\nDatum då patienten ska upphöra ta sitt läkemedel/då läkemedlet ska sluta administreras. OBS, kan anges både vid ordinationer av typ ”Insättning” och ”Utsättning”." ] ;
