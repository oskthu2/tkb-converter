       fhir:ElementDefinition.short [ fhir:value "Källsystemets HSA-id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Det källsystem som uppgiften lagras i. Sätts till källsystemets HSA-id." ] ;
