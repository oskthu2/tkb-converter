       fhir:ElementDefinition.short [ fhir:value "Ordinationstyp (I=insättning, U=utsättning)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ordinationstyp.\n\nUppgift som anger om aktuell ordination ska räknas som en insättningsordination eller utsättningsordination (utsättningsordination = ordination som beskriver avslut av läkemedelsbehandling). Insättning används när läkemedlet är insatt, dvs. även en ändrad eller förnyad ordination har typen insättning. Kodverk: I, U." ] ;
