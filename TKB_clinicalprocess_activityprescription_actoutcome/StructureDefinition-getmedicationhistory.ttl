         fhir:ElementDefinition.constraint.human [ fhir:value "Exakt ett av unstructuredDrugInformation, merchandise, drugArticle, drug och generics ska anges i läkemedelsvalet (DrugChoiceType, TKB 7.2)." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "unstructuredDrugInformation.count() + merchandise.count() + drugArticle.count() + drug.count() + generics.count() = 1" ] ;
