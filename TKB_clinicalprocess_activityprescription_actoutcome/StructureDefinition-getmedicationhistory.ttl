       fhir:ElementDefinition.definition [ fhir:value "Ordinationshuvudorsak.\n\nDen eller de viktigaste av de ordinationsorsaker som anges, om fler än en." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../principalPrescriptionReason` (`PrescriptionReasonType`, kardinalitet 0..*)." ] ;
