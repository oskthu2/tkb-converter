       fhir:ElementDefinition.short [ fhir:value "form" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Läkemedelsform.\n\nText som anger namn på den grupp som innehåller de läkemedel med den läkemedelsform som önskas i aktuell läkemedelsordination" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../../../../form` (`string`, kardinalitet 0..1)." ] ;
