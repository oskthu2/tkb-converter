       fhir:ElementDefinition.short [ fhir:value "prescriptionStatus" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ordinationsstatus.\n\nAnger ordinationens aktuella status [Active, Inactive]\n\nEn aktiv ordination är den sista i sin ordinationskedja. Alla andra ordinationer i samma ordinationskedja är inaktiva." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../prescriptionStatus` (`PrescriptionStatusEnum`, kardinalitet 1..1)." ] ;
