       fhir:ElementDefinition.short [ fhir:value "reason" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ordinationsorsak.\n\nSkäl till en viss ordination. Anges enligt Socialstyrelsens kodsystem för ordinationsorsaker (NKOO, Nationell källa för ordinationsorsak). Se [R8]." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../../reason` (`CVType`, kardinalitet 1..1)." ] ;
