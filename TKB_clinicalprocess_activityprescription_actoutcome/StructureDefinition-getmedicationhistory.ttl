       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../../../../../unit` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getmedicationhistory.medicationMedicalRecord.medicationMedicalRecordBody.medicationPrescription.administration.drug.generics.strength.unit" ] ;
