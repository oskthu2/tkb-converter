       fhir:Element.id [ fhir:value "getmedicationhistory.medicationMedicalRecord.medicationMedicalRecordHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory.medicationMedicalRecord.medicationMedicalRecordHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.short [ fhir:value "approvedForPatient" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ansvarig vårdpersonals beslut, alternativt verksamhetens policy och regler (men- och sekretessprövning), huruvida uppgiften får delas till patient för ändamålet patients åtkomst (Individens direktåtkomst).\n\nOm uppgiften beslutas delas sätts värdet till true, i annat fall till false. False innebär att uppgiften inte får delas till patient.\n\nNotera att värdet kan, för samma uppgift, förändras med tiden på grund av att rådrumstid har passerats, eller att verksamheten ändrat policy för vad som lämnas ut till patient. I sådana fall ska källsystemet uppdatera engagemangsindex." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../approvedForPatient` (`boolean`, kardinalitet 1..1)." ] ;
