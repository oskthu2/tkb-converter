       fhir:index 165 ;
       fhir:Element.id [ fhir:value "getmedicationhistory.medicationMedicalRecord.medicationMedicalRecordBody.medicationPrescription.dispensationAuthorization" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory.medicationMedicalRecord.medicationMedicalRecordBody.medicationPrescription.dispensationAuthorization" ] ;
       fhir:ElementDefinition.short [ fhir:value "Förskrivning" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivning.\n\nKälla: Socialstyrelsens termbank, Terminologirådet: recept, rekvisition, livsmedelsanvisning, hjälpmedelskort eller dosrecept.\n\nEn förskrivning föregås alltid av en ordination. Varje förskrivning (förutom den första) är per definition ett nytt beslut, och därmed en ny ordination. I slutenvård görs endast ordination, men i öppenvård krävs även en förskrivning.\n\nUtelämnas alltid om ordinationstypen är Utsättning." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../dispensationAuthorization` (`DispensationAuthorizationType`, kardinalitet 0..1).\n\n**Modellanteckning:** Se XSD DispensationAuthorizationType för fullständig struktur.\n// SAKNAS I KÄLLDOKUMENT - endast delvis extraherat — kontrollera manuellt" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
