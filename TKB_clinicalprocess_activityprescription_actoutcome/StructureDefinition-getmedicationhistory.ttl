     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getmedicationhistory.medicationMedicalRecord.medicationMedicalRecordHeader" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationhistory.medicationMedicalRecord.medicationMedicalRecordHeader" ] ;
       fhir:ElementDefinition.short [ fhir:value "PatientSummaryHeaderType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Innehåller basinformation om dokumentet, inklusive information om vid vilken vårdkontakt som ordinationen skedde.\n\nNotera: accountableHealthCareProfessional anges till den som registrerat informationen. Ordinatör, förskrivare och administrerande vårdpersonal anges i Bodyn." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../medicationMedicalRecordHeader` (`PatientSummaryHeaderType`, kardinalitet 1..1)." ] ;
