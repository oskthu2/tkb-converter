       fhir:ElementDefinition.short [ fhir:value "Information om administrering av läkemedel" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information om administrering av läkemedel. Bara administreringstillfällen som faktiskt ägt rum kan anges, planerade administreringstillfällen kan inte anges i detta kontrakt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../administration` (`AdministrationType`, kardinalitet 0..*).\n\n**Modellanteckning:** Bara administreringstillfällen som faktiskt ägt rum kan anges.\nSe XSD AdministrationType för fullständig struktur.\n// SAKNAS I KÄLLDOKUMENT - endast delvis extraherat — kontrollera manuellt" ] ;
