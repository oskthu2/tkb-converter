           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType>
         ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getvaccinationhistory-request.patientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getvaccinationhistory-request.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "patientId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till angiven personidentifierare för en patient. Tjänsteproducenten ska i svaret leverera alla uppgifter kopplade till patienten, dvs. även uppgifter som har registrerats på andra, till individen, kopplade personidentifierare.\n\nid sätts till patientens identifierare. Anges med 12 tecken utan avskiljare.\n\ntype sätts till OID för typ av personidentifierare.\n\nFör personnummer ska Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas.\n\nFör samordningsnummer skall Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas.\n\nFör andra typer av personidentifierare sätts type till aktuell OID." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `patientId` (`PersonIdType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/PersonIdType" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getvaccinationhistory-request.timePeriod" ] ;
       fhir:ElementDefinition.path [ fhir:value "getvaccinationhistory-request.timePeriod" ] ;
       fhir:ElementDefinition.short [ fhir:value "timePeriod" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till det angivna intervallet. Begränsningen innebär att endast poster returneras där tidpunkterna documentTime, authorTime, signatureTime eller registrationrecord.date i svaret ligger inom sökintervallets start- och slutdatum.\n\nNotera att sökintervallet beskrivs som ett datumintervall. Vid jämförelse med tidpunkter ska hela det dygn som anges i slutdatum betraktas som en del av sökintervallet." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `timePeriod` (`DatePeriodType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
