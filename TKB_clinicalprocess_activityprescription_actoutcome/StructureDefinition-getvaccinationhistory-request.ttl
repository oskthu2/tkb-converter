       fhir:ElementDefinition.path [ fhir:value "getvaccinationhistory-request.careUnitHSAid" ] ;
       fhir:ElementDefinition.short [ fhir:value "careUnitHSAid" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till angivna informationsägande vårdenheter. Anges med HSA-id. Motsvarar careUnitHSAid i HealthCareProfessionalType i svaret.\n\nroot sätts till OID för HSA-katalogen (1.2.752.129.2.1.4.1).\n\nextension sätts till HSA-id för informationsägande vårdenhet." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careUnitHSAid` (`HSAIdType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
