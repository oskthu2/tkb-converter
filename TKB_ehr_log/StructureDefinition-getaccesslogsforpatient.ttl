       fhir:ElementDefinition.short [ fhir:value "AccessLogsResultType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Resultatobjekt med status hurvida tjänsten returnerar ok eller om fel uppstått. Om tjänsten utförts korrekt returneras en lista med patientinformation och resultatkod OK.\n\nVid eventuella fel i tjänsteanropet returneras ingen patientinformation. Statuskod som beskriver orsaken till fel returneras då tillsammans med ett felmeddelande." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `AccessLogsResultType` (`logquerying:AccessLogsResultType`, kardinalitet 1..1)." ] ;
