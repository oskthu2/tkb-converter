  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getaccesslogsforpatient" ] ;
       fhir:ElementDefinition.path [ fhir:value "getaccesslogsforpatient" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetAccessLogsForPatient" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för tjänstekontraktet GetAccessLogsForPatient\n(RIV-TA urn:riv:ehr:log:querying:GetAccessLogsForPatientResponder:1).\nRepresenterar responsens informationsstruktur (log.querying:AccessLogsResult).\nReturnerar lista för angiven patient med vilka vårdaktörer som har haft åtkomst\ntill information, inklusive tidpunkt, syfte och resurstyp.\nStödjer aggregering — queuedReportId får inte användas vid aggregerande anrop." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getaccesslogsforpatient.AccessLogsResultType" ] ;
       fhir:ElementDefinition.path [ fhir:value "getaccesslogsforpatient.AccessLogsResultType" ] ;
       fhir:ElementDefinition.short [ fhir:value "AccessLogsResultType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Resultatobjekt med status hurvida tjänsten returnerar ok eller om fel uppstått. Om tjänsten utförts korrekt returneras en lista med patientinformation och resultatkod OK.\n\nVid eventuella fel i tjänsteanropet returneras ingen patientinformation. Statuskod som beskriver orsaken till fel returneras då tillsammans med ett felmeddelande." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `AccessLogsResultType` (`logquerying:AccessLogsResultType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
