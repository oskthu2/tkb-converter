       fhir:ElementDefinition.short [ fhir:value "Sekretessmarkering" ] ;
       fhir:ElementDefinition.definition [ fhir:value "true = personen har sekretessmarkering (J), false = personen har inte\nsekretessmarkering (N). Poster med sekretessmarkering innehåller normalt inte\nannan information än personnummer och detta fält.\nKardinalitet: Obligatorisk." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
