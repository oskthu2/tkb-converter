<wsdl:definitions name="DeviceObservationConsumer" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:ihe:pcd:dec:2010"
    xmlns:wsaw="http://www.w3.org/2005/08/addressing" xmlns:tns="urn:ihe:pcd:dec:2010">

    <wsdl:documentation>
        Tjänsteinteraktionens namn: DeviceObservationConsumerInteraction
        Beskrivning: 
        Revisioner: 
        Tjänstedomän: ihe.pcd.dec 
        Tjänsteinteraktionstyp: Fråga-Svar RIV
        Teknisk Anvisning: RIVTABP20
        Förvaltas av: Inera AB
    </wsdl:documentation>

    <wsdl:types>
        <xs:schema>
            <xs:import namespace="urn:ihe:pcd:dec:2010"
                schemaLocation="DeviceObservationConsumer.xsd"/>
            <xs:import schemaLocation="../../core_components/ws-addressing-1.0.xsd"
                namespace="http://www.w3.org/2005/08/addressing"/>
        </xs:schema>
    </wsdl:types>

    <wsdl:message name="CommunicatePCDData_Message">
        <wsdl:documentation>Communicate PCD Data</wsdl:documentation>
        <wsdl:part name="body" element="tns:CommunicatePCDData"/>
        <wsdl:part name="LogicalAddress" element="wsaw:To">
            <wsdl:documentation>The Logical Adress of the Device Observation Consumer, see TKB.</wsdl:documentation>
        </wsdl:part>
    </wsdl:message>

    <wsdl:message name="CommunicatePCDDataResponse_Message">
        <wsdl:documentation>Communicate PCD Data Response</wsdl:documentation>
        <wsdl:part name="body" element="tns:CommunicatePCDDataResponse"/>
    </wsdl:message>

    <wsdl:portType name="DeviceObservationConsumer_PortType">
        <wsdl:operation name="CommunicatePCDData">
            <wsdl:input message="tns:CommunicatePCDData_Message"
                wsaw:Action="urn:ihe:pcd:2010:CommunicatePCDData"/>
            <wsdl:output message="tns:CommunicatePCDDataResponse_Message"
                wsaw:Action="urn:ihe:pcd:2010:CommunicatePCDDataResponse"/>
        </wsdl:operation>
    </wsdl:portType>

    <!-- Binding Description -->
    <wsdl:binding name="DeviceObservationConsumer_Binding_Soap12"
        type="tns:DeviceObservationConsumer_PortType">
        <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsaw:UsingAddressing wsdl:required="true"/>
        <wsdl:operation name="CommunicatePCDData">
            <soap12:operation soapAction="urn:ihe:pcd:2010:CommunicatePCDData"/>
            <wsdl:input>
                <soap12:body use="literal" parts="body"/>
                <soap12:header use='literal' message='tns:CommunicatePCDData_Message' part='LogicalAddress' />
            </wsdl:input>
            <wsdl:output>
                <soap12:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <!-- Service Description -->
    <wsdl:service name="DeviceObservationConsumer_Service">
        <wsdl:port binding="tns:DeviceObservationConsumer_Binding_Soap12"
            name="DeviceObservationConsumer_Port_Soap12">
            <soap12:address location="http://www.example.org/"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
