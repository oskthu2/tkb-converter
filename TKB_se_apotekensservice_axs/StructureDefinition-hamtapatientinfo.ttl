         fhir:ElementDefinition.constraint.severity [ fhir:value "warning" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Om apoteket inte finns registrerat i EXPO (registrerad = false) saknar alla fält utom glnKod värden" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "registrerad = false implies (aktorsnamn.empty() and aktorsorgnr.empty() and allmantelefon.empty() and besoksadress.empty() and fax.empty() and huvudtypkod.empty() and namn.empty() and ort.empty() and slutdatum.empty() and startdatum.empty())" ] ;
