  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "hamtapatientinfo" ] ;
       fhir:ElementDefinition.path [ fhir:value "hamtapatientinfo" ] ;
       fhir:ElementDefinition.short [ fhir:value "HamtaPatientInfo — Response" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för svaret i HamtaPatientInfo\n(urn:riv:se.apotekensservice:axs:HamtaPatientInfoResponder:6, HamtaPatientInfoResponseType).\nSvaret samlar information om patienten från eHälsomyndighetens system: eventuellt dosapotek (EXPO),\ndosproducent, dosunderlagets status, om det finns aktuella recept i RDH, samt folkbokförings- och samtyckesinformation (FOLK)." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "hamtapatientinfo.apotek" ] ;
       fhir:ElementDefinition.path [ fhir:value "hamtapatientinfo.apotek" ] ;
       fhir:ElementDefinition.short [ fhir:value "Dosapotek" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ev. DOS-apotek som kunden är kopplad till. Om anrop mot underliggande system (FOLK, OR eller EXPO) misslyckas så lämnas fältet tomt. (se.apotekensservice:axs:4 ApoteksinformationResponse)" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "BackboneElement" ]
       ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "hamtapatientinfo-apotek-oregistrerat" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "warning" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Om apoteket inte finns registrerat i EXPO (registrerad = false) saknar alla fält utom glnKod värden" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "registrerad = false implies (aktorsnamn.empty() and aktorsorgnr.empty() and allmantelefon.empty() and besoksadress.empty() and fax.empty() and huvudtypkod.empty() and namn.empty() and ort.empty() and slutdatum.empty() and startdatum.empty())" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.inera.se/ig/se-apotekensservice-axs/StructureDefinition/hamtapatientinfo" ;
           fhir:link <https://fhir.inera.se/ig/se-apotekensservice-axs/StructureDefinition/hamtapatientinfo>
         ]
