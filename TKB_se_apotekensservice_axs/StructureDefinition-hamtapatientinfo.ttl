       fhir:ElementDefinition.short [ fhir:value "Dosapotek" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ev. DOS-apotek som kunden är kopplad till. Om anrop mot underliggande system (FOLK, OR eller EXPO) misslyckas så lämnas fältet tomt. (se.apotekensservice:axs:4 ApoteksinformationResponse)" ] ;
