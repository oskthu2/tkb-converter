// GENERERAD av scripts/sync_field_descriptions.py från fälttabellerna i
// input/pagecontent/ — redigera inte för hand, ändra tabellen och kör om skriptet.

RuleSet: GetFmbFieldDescriptions
* beslutsunderlag ^definition = "Beslutsunderlag innehåller information om beslutsunderlag som kan användas vid bedömning om sjukskrivning. Ett beslutunderlag kan användas som underlag för bedömning när samtliga villkor kopplades till klassen är uppfyllda."
* beslutsunderlag ^comment = "TKB-fält: `beslutsunderlag` (`BeslutsunderlagType`, kardinalitet 0..*)."
* beslutsunderlag.underlagsId ^definition = "Globalt unik identifierare för beslutsunderlaget."
* beslutsunderlag.underlagsId ^comment = "TKB-fält: `../underlagsId` (`IItype`, kardinalitet 1..1)."
* beslutsunderlag.giltighetstid ^definition = "Tid då en rekommendation är giltig. Starttiden i intervallet skall alltid anges. Om sluttid ej anges är beslutsrekommendationen aktiv. Ett beslutsunderlag som inte är aktiv skall innehålla ett slutdatum, som ligger tidigare än aktuellt datum, eller ett startdatum som ligger senare än aktuellt datum."
* beslutsunderlag.giltighetstid ^comment = "TKB-fält: `../giltighetstid` (`IVL`, kardinalitet 1..1)."
* beslutsunderlag.giltighetstid.start ^definition = "Starttid"
* beslutsunderlag.giltighetstid.start ^comment = "TKB-fält: `../../start` (`Date`, kardinalitet 1..1)."
* beslutsunderlag.giltighetstid.slut ^definition = "Sluttid"
* beslutsunderlag.giltighetstid.slut ^comment = "TKB-fält: `../../slut` (`Date`, kardinalitet 0..1)."
* beslutsunderlag.version ^definition = "Versionsnummer för ett beslutsunderlag. Versionen räknas upp när ett beslutsunderlag förändrats i sin innebörd eller ändrar giltighetstid."
* beslutsunderlag.version ^comment = "TKB-fält: `../version` (`int`, kardinalitet 1..1)."
* beslutsunderlag.textuelltUnderlag ^definition = "Varje beslutsunderlag beskrivs i textuell form, som omfattar alla villkor och rekommendationer som omfattas av beslutsunderlag samt annan information som är relevant i beslutsfattandet även om den informationen inte finns representerad i kodad form."
* beslutsunderlag.textuelltUnderlag ^comment = "TKB-fält: `../textuelltUnderlag` (`String`, kardinalitet 0..1)."
* beslutsunderlag.sjukskrivningstid ^definition = "Totala sjukskrivningstidens längd med början från första intygsdag. Anges ej om sjukskrivningstiden inte kan kvantifieras."
* beslutsunderlag.sjukskrivningstid ^comment = "TKB-fält: `../sjukskrivningstid` (`PQType`, kardinalitet 0..1)."
* beslutsunderlag.sjukskrivningstid.value ^definition = "Värde för tidsangivelsen"
* beslutsunderlag.sjukskrivningstid.value ^comment = "TKB-fält: `../../value` (`string`, kardinalitet 1..1)."
* beslutsunderlag.sjukskrivningstid.unit ^definition = "Enhet för tidsangivelsen enligt UCUM, månad=\"mo\", vecka = \"wk\", dag = \"d\""
* beslutsunderlag.sjukskrivningstid.unit ^comment = "TKB-fält: `../../unit` (`string`, kardinalitet 1..1)."
* beslutsunderlag.sjukskrivningsgrad ^definition = "Anger grad av sjukskrivning. Exempel på värden: Heltid, Deltid"
* beslutsunderlag.sjukskrivningsgrad ^comment = "TKB-fält: `../sjukskrivningsgrad` (`CVType`, kardinalitet 1..1)."
* beslutsunderlag.senastAndrad ^definition = "Anger när ett beslutsunderlag senast ändrats"
* beslutsunderlag.senastAndrad ^comment = "TKB-fält: `../senastAndrad` (`dateTime`, kardinalitet 1..1)."
* beslutsunderlag.rehabiliteringsInformation ^comment = "TKB-fält: `../rehabiliteringsInformation` (`RehabiliteringsInformationType`, kardinalitet 0..1)."
* beslutsunderlag.rehabiliteringsInformation.beskrivning ^definition = "Text som beskriver en rehabiliteringsåtgärd"
* beslutsunderlag.rehabiliteringsInformation.beskrivning ^comment = "TKB-fält: `../../beskrivning` (`String`, kardinalitet 1..1)."
* beslutsunderlag.villkor ^definition = "Villkor för att ett beslutsunderlag skall vara uppfyllt."
* beslutsunderlag.villkor ^comment = "TKB-fält: `../villkor*` (`VillkorType`, kardinalitet 1..1)."
* beslutsunderlag.villkor.urvalArbetsbelastning ^definition = "Anges om villkoret är beroende av en eller flera koder för arbetsbelastning"
* beslutsunderlag.villkor.urvalArbetsbelastning ^comment = "TKB-fält: `../../urvalArbetsbelastning` (`UrvalArbetsbelastningType`, kardinalitet 0..1)."
* beslutsunderlag.villkor.urvalArbetsbelastning.arbetsbelastning ^definition = "Anger koder för arbetsbelastning för vilka minst en måste vara sann."
