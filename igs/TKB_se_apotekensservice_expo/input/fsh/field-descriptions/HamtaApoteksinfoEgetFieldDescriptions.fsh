// GENERERAD av scripts/sync_field_descriptions.py från fälttabellerna i
// input/pagecontent/ — redigera inte för hand, ändra tabellen och kör om skriptet.

RuleSet: HamtaApoteksinfoEgetFieldDescriptions
* expeditionsstalleLista ^definition = "Lista innehållande en eller flera expeditionsstallen."
* expeditionsstalleLista ^comment = "TKB-fält: `expeditionsstalleLista` (`ExpeditionsstalleEgetResponse`, kardinalitet 1..*)."
* expeditionsstalleLista.aktorsnamn ^definition = "Aktörens namn."
* expeditionsstalleLista.aktorsnamn ^comment = "TKB-fält: `../aktorsnamn` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.allmTelefon ^definition = "Expeditionsställets allmänna telefonnummer."
* expeditionsstalleLista.allmTelefon ^comment = "TKB-fält: `../allmTelefon` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.apoteksId ^definition = "GLN-kod för unik identifiering av apotek."
* expeditionsstalleLista.apoteksId ^comment = "TKB-fält: `../apoteksId` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.besoksAdress ^definition = "Expeditionsställets besöksadress."
* expeditionsstalleLista.besoksAdress ^comment = "TKB-fält: `../besoksAdress` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.besoksort ^definition = "Expeditionsställets ort (besöksort)."
* expeditionsstalleLista.besoksort ^comment = "TKB-fält: `../besoksort` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.dosmottagareLista ^definition = "Information om dosmottagare."
* expeditionsstalleLista.dosmottagareLista ^comment = "TKB-fält: `../dosmottagareLista` (`DosmottagareResponse`, kardinalitet 0..*)."
* expeditionsstalleLista.dosmottagareLista.adress ^definition = "Adress till dosmottagare. Obligatorisk om typ = 'D'."
* expeditionsstalleLista.dosmottagareLista.adress ^comment = "TKB-fält: `../../adress` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.dosmottagareLista.apoteksIdDosmottagare ^definition = "Apoteks-id för dosmottagare om dosmottagare är av typen apotek."
* expeditionsstalleLista.dosmottagareLista.apoteksIdDosmottagare ^comment = "TKB-fält: `../../apoteksIdDosmottagare` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.dosmottagareLista.arbetsplatskod ^definition = "Arbetsplatskod till dosmottagare. Är aktuellt om dosmottagare t ex är en distriktsläkarmottagning."
* expeditionsstalleLista.dosmottagareLista.arbetsplatskod ^comment = "TKB-fält: `../../arbetsplatskod` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.dosmottagareLista.avdelning ^definition = "Avdelning inom dosmottagare."
* expeditionsstalleLista.dosmottagareLista.avdelning ^comment = "TKB-fält: `../../avdelning` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.dosmottagareLista.dosmottagarId ^definition = "Dosmottagarens identitet, dosproducentens identitet för dosmottagaren t ex kundnummer, GLN-kod. Unikt inom dosapoteket."
* expeditionsstalleLista.dosmottagareLista.dosmottagarId ^comment = "TKB-fält: `../../dosmottagarId` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.dosmottagareLista.kommunkod ^definition = "Kommunkod till vilken dosmottagarens tillhör. Kod enligt SCB."
* expeditionsstalleLista.dosmottagareLista.kommunkod ^comment = "TKB-fält: `../../kommunkod` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.dosmottagareLista.lanskod ^definition = "Länskod till vilken dosmottagaren tillhör. Kod enligt SCB."
* expeditionsstalleLista.dosmottagareLista.lanskod ^comment = "TKB-fält: `../../lanskod` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.dosmottagareLista.mottagarnamn ^definition = "Namn på dosmottagare."
* expeditionsstalleLista.dosmottagareLista.mottagarnamn ^comment = "TKB-fält: `../../mottagarnamn` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.dosmottagareLista.postnummer ^definition = "Postnummer till dosmottagare."
* expeditionsstalleLista.dosmottagareLista.postnummer ^comment = "TKB-fält: `../../postnummer` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.dosmottagareLista.postort ^definition = "Arbetsplatsort till dosmottagare. Obligatorisk om typ = 'D'."
* expeditionsstalleLista.dosmottagareLista.postort ^comment = "TKB-fält: `../../postort` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.dosmottagareLista.typ ^definition = "Typ av dosmottagare, kan antingen vara Apotek (där dospatienterna kan hämta sina dosleveranser) eller direktleverans, t ex vårdboende, distriktssköterska. Giltiga värden: D (direktleverans) eller A (apotek)."
* expeditionsstalleLista.dosmottagareLista.typ ^comment = "TKB-fält: `../../typ` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.eRecept ^definition = "Flagga som anger om expeditionsstället är ett apotek som kan hantera e-recept för besökande privat personer."
* expeditionsstalleLista.eRecept ^comment = "TKB-fält: `../eRecept` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.eReceptDjur ^definition = "Markering gällande om apoteket kan expediera elektroniska djurrecept."
* expeditionsstalleLista.eReceptDjur ^comment = "TKB-fält: `../eReceptDjur` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.faxnummer ^definition = "Expeditionsställets faxnummer."
* expeditionsstalleLista.faxnummer ^comment = "TKB-fält: `../faxnummer` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.huvudOrgTypKod ^definition = "Möjliga värden: ADM, AP, DIAP, DJUR, DX, OAP, SA, TVAP ADM En organisatiorisk enhet inom ett företag som har rent administrativa uppgifter. AP Apotek för allmänheten - enhet för detaljhandel med läkemedel med farmaceutisk bemanning under öppethållandet. DIAP Distansapotek - Större apoteksenhet med ansvar att kunna distribuera apoteksvaror direkt till avtalskunder, apoteksombud eller privatpersoner DJUR Ett apotek som har utökat djursortiment. DX Dosapotek - enhet för produktion av dosdispenserade läkemedel. OAP Övriga apotek - gammal definition av apotek. Bör ej användas. SA Sjukhusapotek - apotek som ger service till slutenvårdsenheter TVAP Enhet som på beställning tillverkar specifika individanpassade läkemedel."
* expeditionsstalleLista.huvudOrgTypKod ^comment = "TKB-fält: `../huvudOrgTypKod` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.kommun ^definition = "Expeditionsställets kommuntillhörighet, kod enligt SCB."
* expeditionsstalleLista.kommun ^comment = "TKB-fält: `../kommun` (`int`, kardinalitet 1..1)."
* expeditionsstalleLista.kortNamn ^definition = "Kortversion på apoteksnamn. Behövs i bla i vårdsystem."
* expeditionsstalleLista.kortNamn ^comment = "TKB-fält: `../kortNamn` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.lan ^definition = "Expeditionsställets länstillhörighet, kod enligt SCB."
* expeditionsstalleLista.lan ^comment = "TKB-fält: `../lan` (`int`, kardinalitet 1..1)."
* expeditionsstalleLista.namn ^definition = "Expeditionsställets officiella namn."
* expeditionsstalleLista.namn ^comment = "TKB-fält: `../namn` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.oppetHallandeLista ^definition = "När expeditionsstället har öppet."
* expeditionsstalleLista.oppetHallandeLista ^comment = "TKB-fält: `../oppetHallandeLista` (`OppethallandeResponse`, kardinalitet 0..*)."
* expeditionsstalleLista.oppetHallandeLista.dagBenamning ^definition = "Exempelvis \"Nyårsafton\"."
* expeditionsstalleLista.oppetHallandeLista.dagBenamning ^comment = "TKB-fält: `../../dagBenamning` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.oppetHallandeLista.lunchFrom ^definition = "Om lunchstängt, \"stänger för lunch\". Format: HHmm H=Timme (0-24) m=Minut"
* expeditionsstalleLista.oppetHallandeLista.lunchFrom ^comment = "TKB-fält: `../../lunchFrom` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.oppetHallandeLista.lunchTom ^definition = "Om lunchstängt, \"Öppnar igen efter lunch kl\". Format: HHmm H=Timme (0-24) m=Minut"
* expeditionsstalleLista.oppetHallandeLista.lunchTom ^comment = "TKB-fält: `../../lunchTom` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.oppetHallandeLista.oppnar ^definition = "Öppningstid vardagar/vekodagnr. Format: HHmm H=Timme (0-24) m=Minut"
* expeditionsstalleLista.oppetHallandeLista.oppnar ^comment = "TKB-fält: `../../oppnar` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.oppetHallandeLista.slutDatum ^definition = "Sista dagen i en period vid typ N, P eller S. Obligatorisk vid typ P, S eller D. Om typ D är slutdatum = startdatum."
* expeditionsstalleLista.oppetHallandeLista.slutDatum ^comment = "TKB-fält: `../../slutDatum` (`dateTime`, kardinalitet 0..1)."
* expeditionsstalleLista.oppetHallandeLista.stanger ^definition = "Stängningstid vardagar/vekodagnr. Format: HHmm H=Timme (0-24) m=Minut"
* expeditionsstalleLista.oppetHallandeLista.stanger ^comment = "TKB-fält: `../../stanger` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.oppetHallandeLista.startDatum ^definition = "Första dagen i en period vid typ N, P eller S. Vid typ D anges datum för aktuell dag exv 2010-12-24."
* expeditionsstalleLista.oppetHallandeLista.startDatum ^comment = "TKB-fält: `../../startDatum` (`dateTime`, kardinalitet 1..1)."
* expeditionsstalleLista.oppetHallandeLista.tfStangtOrsak ^definition = "Orsak till tillfällig stängning."
* expeditionsstalleLista.oppetHallandeLista.tfStangtOrsak ^comment = "TKB-fält: `../../tfStangtOrsak` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.oppetHallandeLista.typ ^definition = "Typ av öppethållande. N = Normalt P = avvikande under angiven period D = avvikande under angiven dag S = tillfälligt stängt under angiven period"
* expeditionsstalleLista.oppetHallandeLista.typ ^comment = "TKB-fält: `../../typ` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.oppetHallandeLista.veckodagnr ^definition = "Ett nummer för veckodagen 1-7 för Måndag till Söndag, V för vardagar."
* expeditionsstalleLista.oppetHallandeLista.veckodagnr ^comment = "TKB-fält: `../../veckodagnr` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.orgNr ^definition = "Aktörens organisationsnummer"
* expeditionsstalleLista.orgNr ^comment = "TKB-fält: `../orgNr` (`long`, kardinalitet 1..1).

**Modellanteckning:** Aktörens organisationsnummer (xs:long i schemat.)"
* expeditionsstalleLista.orgTypADM ^definition = "Kod ADM som beskriver typ av expeditionsställe. En organisatiorisk enhet inom ett företag som har rent administrativa uppgifter."
* expeditionsstalleLista.orgTypADM ^comment = "TKB-fält: `../orgTypADM` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.orgTypDIST ^definition = "Kod DIST som beskriver typ av expeditionsställe. Distansapotek - Större apoteksenhet med ansvar att kunna distribuera apoteksvaror direkt till avtalskunder, apoteksombud eller privatpersoner"
* expeditionsstalleLista.orgTypDIST ^comment = "TKB-fält: `../orgTypDIST` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.orgTypDJAP ^definition = "Kod DJAP som beskriver typ av expeditionsställe. Ett apotek som har utökat djursortiment."
* expeditionsstalleLista.orgTypDJAP ^comment = "TKB-fält: `../orgTypDJAP` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.orgTypDOS ^definition = "Kod DOS som beskriver typ av expeditionsställe. Dosapotek - enhet för produktion av dosdispenserade läkemedel."
* expeditionsstalleLista.orgTypDOS ^comment = "TKB-fält: `../orgTypDOS` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.orgTypEA ^definition = "Kod EA som beskriver typ av expeditionsställe. Apotek för allmänheten - enhet för detaljhandel med läkemedel med farmaceutisk bemanning under öppethållandet."
* expeditionsstalleLista.orgTypEA ^comment = "TKB-fält: `../orgTypEA` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.orgTypEH ^definition = "Kod EH som beskriver typ av expeditionsställe. En enhet som som kan lämna ut e-handel, dit man kan skicka e-handelspacket."
* expeditionsstalleLista.orgTypEH ^comment = "TKB-fält: `../orgTypEH` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.orgTypGSL ^definition = "Kod GSL som beskriver typ av expeditionsställe. Alla expeditionställen som säljer sortimentet på 80-listan (t ex shopar) ska ha flaggan satt. \"General Sales list\" - även kallad för \"80-listan\", enbart varor som ej är receptbelagda och som ingår i 80-sortimentet. Alla expeditionställen som säljer sortimentet på 80-listan (t ex shopar) ska ha flaggan satt."
* expeditionsstalleLista.orgTypGSL ^comment = "TKB-fält: `../orgTypGSL` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.orgTypSA ^definition = "Kod SA som beskriver typ av expeditionsställe. Sjukhusapotek - apotek som ger service till slutenvårdsenheter."
* expeditionsstalleLista.orgTypSA ^comment = "TKB-fält: `../orgTypSA` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.orgTypTILV ^definition = "Kod TILV som beskriver typ av expeditionsställe. Enhet som på beställning tillverkar individanpassade specifika läkemedel."
* expeditionsstalleLista.orgTypTILV ^comment = "TKB-fält: `../orgTypTILV` (`boolean`, kardinalitet 1..1)."
* expeditionsstalleLista.postAdress ^definition = "Expeditionsställets postAdress."
* expeditionsstalleLista.postAdress ^comment = "TKB-fält: `../postAdress` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.postNr ^definition = "Expeditionsställets postNr."
* expeditionsstalleLista.postNr ^comment = "TKB-fält: `../postNr` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.postort ^definition = "Expeditionsställets postort."
* expeditionsstalleLista.postort ^comment = "TKB-fält: `../postort` (`string`, kardinalitet 1..1)."
* expeditionsstalleLista.recepturtelefon ^definition = "Expeditionsställets receptur telefonnummer."
* expeditionsstalleLista.recepturtelefon ^comment = "TKB-fält: `../recepturtelefon` (`string`, kardinalitet 0..1)."
* expeditionsstalleLista.slutDatum ^definition = "Datum för avslut av verksamhet."
* expeditionsstalleLista.slutDatum ^comment = "TKB-fält: `../slutDatum` (`dateTime`, kardinalitet 0..1)."
* expeditionsstalleLista.startDatum ^definition = "Datum för start av verksamhet. Det datum som allmänheten kan använda Apoteket."
* expeditionsstalleLista.startDatum ^comment = "TKB-fält: `../startDatum` (`dateTime`, kardinalitet 1..1)."
