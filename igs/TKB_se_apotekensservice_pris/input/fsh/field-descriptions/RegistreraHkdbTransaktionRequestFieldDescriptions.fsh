// GENERERAD av scripts/sync_field_descriptions.py från fälttabellerna i
// input/pagecontent/ — redigera inte för hand, ändra tabellen och kör om skriptet.

RuleSet: RegistreraHkdbTransaktionRequestFieldDescriptions
* ackBrutto ^definition = "Om transaktionen avser föregående period skall alltså ackBrutto innehålla FPbrutto i kronor. Om transaktionen avser kommande period skall ackBrutto innehålla motsvarande KPbrutto. I normalfallet används alltså värdet från IPbrutto användas. ackBrutto och periodStart ersätter termerna IPbrutto från version 10.3.0."
* ackBrutto ^comment = "TKB-fält: `ackBrutto` (`double`, kardinalitet 0..1)."
* bruttobelopp ^definition = "Transaktionens högkostnadsgrundande bruttobelop i kronor och ören."
* bruttobelopp ^comment = "TKB-fält: `bruttobelopp` (`double`, kardinalitet 1..1)."
* expeditionsId ^definition = "Expeditionens unika id för spårbarhet."
* expeditionsId ^comment = "TKB-fält: `expeditionsId` (`string`, kardinalitet 1..1)."
* ipBrutto ^definition = "Ackumulerat bruttobelopp i högkostnadstrappan för innevarande period i kronor och ören. Används för att verifiera att ingen ny transaktion registrerats för personen efter att högkostnadsfrågan ställts. Skall inte används som indata från och version 10.3.0. Använd periodStart och ackBrutto i stället."
* ipBrutto ^comment = "TKB-fält: `ipBrutto` (`double`, kardinalitet 0..1)."
* klientinformation ^definition = "Objekt innehållande information om anropande klientsystem."
* klientinformation ^comment = "TKB-fält: `klientinformation` (`KlientinformationRequest`, kardinalitet 1..1)."
* klientinformation.anvandare ^definition = "Unikt användarid i anropande system."
* klientinformation.anvandare ^comment = "TKB-fält: `../anvandare` (`string`, kardinalitet 1..1)."
* klientinformation.session ^definition = "Sessionens id i anropande system."
* klientinformation.session ^comment = "TKB-fält: `../session` (`string`, kardinalitet 1..1)."
* klientinformation.system ^definition = "GLN-kod för anropande system."
* klientinformation.system ^comment = "TKB-fält: `../system` (`string`, kardinalitet 1..1)."
* kommentar ^definition = "Kommentar till kreditering."
* kommentar ^comment = "TKB-fält: `kommentar` (`string`, kardinalitet 0..1)."
* periodStart ^definition = "Startdatum för den högkostnadsperiod som transaktionen tillhör."
* periodStart ^comment = "TKB-fält: `periodStart` (`dateTime`, kardinalitet 0..1)."
* persNr ^definition = "Personnummer som transaktionen ska registreras för."
* persNr ^comment = "TKB-fält: `persNr` (`string`, kardinalitet 1..1)."
* transId ^definition = "Aktörens expeditions-ID."
* transId ^comment = "TKB-fält: `transId` (`string`, kardinalitet 1..1)."
* transTid ^definition = "Transaktionstidpunkt."
* transTid ^comment = "TKB-fält: `transTid` (`dateTime`, kardinalitet 1..1)."
* ursprungligtApoteksaktorsExpeditionsId ^definition = "Apoteksaktörens ursprungliga expeditionsid, ska anges vid kreditering"
* ursprungligtApoteksaktorsExpeditionsId ^comment = "TKB-fält: `ursprungligtApoteksaktorsExpeditionsId` (`string`, kardinalitet 0..1)."
* ursprungligtExpeditionsId ^definition = "Expeditionens ursprungliga expeditionsid, ska anges vid kreditering"
* ursprungligtExpeditionsId ^comment = "TKB-fält: `ursprungligtExpeditionsId` (`string`, kardinalitet 0..1)."
* ursprungligTransTid ^definition = "Ursprunglig transaktionstidpunkt. Ges vid kreditering. Avser tidpunkten när det ursprungliga köpet gjordes. Används för att avgöra om personen var över eller under 18 år vid köptillfället. Parametern blir obligatorisk i och med att lagen om kostnadsbefrielse för barn under 18 år trätt i kraft. (Refererat element ur RegistreraHkdbTransaktionResponder_1.1_ext.xsd, namnrymd urn:riv:se.apotekensservice:pris:RegistreraHkdbTransaktionResponder:1.1.)"
* ursprungligTransTid ^comment = "TKB-fält: `ursprungligTransTid` (`dateTime`, kardinalitet 0..1)."
