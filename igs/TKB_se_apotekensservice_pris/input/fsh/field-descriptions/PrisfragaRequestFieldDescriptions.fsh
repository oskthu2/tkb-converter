// GENERERAD av scripts/sync_field_descriptions.py från fälttabellerna i
// input/pagecontent/ — redigera inte för hand, ändra tabellen och kör om skriptet.

RuleSet: PrisfragaRequestFieldDescriptions
* klientinformation ^definition = "Objekt innehållande information om anropande klientsystem."
* klientinformation ^comment = "TKB-fält: `klientinformation` (`KlientinformationRequest`, kardinalitet 1..1)."
* klientinformation.anvandare ^definition = "Unikt användarid i anropande system."
* klientinformation.anvandare ^comment = "TKB-fält: `../anvandare` (`string`, kardinalitet 1..1)."
* klientinformation.session ^definition = "Sessionens id i anropande system."
* klientinformation.session ^comment = "TKB-fält: `../session` (`string`, kardinalitet 1..1)."
* klientinformation.system ^definition = "GLN-kod för anropande system."
* klientinformation.system ^comment = "TKB-fält: `../system` (`string`, kardinalitet 1..1)."
* periodStart ^definition = "Start av period. Om periodStart anges så avses normalt annan period än innevarande period. Innehållet är en periodstart och kan avse föregående period, innevarande period eller kommande period."
* periodStart ^comment = "TKB-fält: `periodStart` (`dateTime`, kardinalitet 0..1)."
* personnummer ^definition = "Personnummer för person som prisfrågan gäller. Om personnummer saknas, använd tjänsten AnonymPrisfraga"
* personnummer ^comment = "TKB-fält: `personnummer` (`string`, kardinalitet 1..1)."
* rader ^definition = "Rader"
* rader ^comment = "TKB-fält: `rader` (`PrisfragaRadRequest`, kardinalitet 1..*)."
* rader.antal ^definition = "Antal förpackningar av vara som expedieras. Vid kreditering sätts detta fält till ett negativt värde. Altenativt kan fälten pris och prisUtbyte sättas till negativa värden."
* rader.antal ^comment = "TKB-fält: `../antal` (`int`, kardinalitet 1..1)."
* rader.formansVal ^definition = "Farmacevtens bedömning om vilken förmån som gäller för receptraden. Förmånstyp R, U, F, L kan förekomma."
* rader.formansVal ^comment = "TKB-fält: `../formansVal` (`string`, kardinalitet 1..1)."
* rader.pris ^definition = "Apoteksaktörs utpris inkl. eventuell moms per förpackning för vara som avses att expedieras."
* rader.pris ^comment = "TKB-fält: `../pris` (`double`, kardinalitet 1..1)."
* rader.prisUtbyte ^definition = "Apoteksaktörs utpris inkl. eventuell moms för billigare vara som ej expedieras vid möjligt byte inom högkostnadsskyddet. Anges om pristillägg skall gälla, dvs när kund motsätter sig byte och väljer förskriven vara."
* rader.prisUtbyte ^comment = "TKB-fält: `../prisUtbyte` (`double`, kardinalitet 0..1)."
* rader.radNr ^definition = "Radnr."
* rader.radNr ^comment = "TKB-fält: `../radNr` (`int`, kardinalitet 1..1)."
* transaktionstid ^definition = "Transaktionsdag som priset ska beräknas för. Om värdet inte anges används dagens datum. För att garantera korrekt prisberäkning för en efterföljande transaktionsregistrering skall denna parameter ha samma värde som parametern transTid i RegistreraHkdbTransaktion. Får inte vara mer än ett år och en dag bakåt i tiden, eller två timmar framåt i tiden."
* transaktionstid ^comment = "TKB-fält: `transaktionstid` (`dateTime`, kardinalitet 0..1)."
* ursprungligTransaktionstid ^definition = "Ursprunglig transaktionstidpunkt. Ges vid kreditering. Avser tidpunkten när det ursprungliga köpet gjordes. Används för att avgöra om personen var över eller under 18 år vid köptillfället. Parametern blir obligatorisk i och med att lagen om kostnadsbefrielse för barn under 18 år trätt i kraft. (Refererat element ur PrisfragaResponder_4.1_ext.xsd, namnrymd urn:riv:se.apotekensservice:pris:PrisfragaResponder:4.1.)"
* ursprungligTransaktionstid ^comment = "TKB-fält: `ursprungligTransaktionstid` (`dateTime`, kardinalitet 0..1)."
