        "name": "Actor",
        "description": "Logisk modell för det gemensamma huvudelementet Actor\n(RIV-TA urn:riv:interoperability:headers:1, element Actor av typen ActorType).\nIdentifierar den aktör som ett anrop görs för räkning av, t.ex. invånaren själv eller ett ombud för invånaren.",
        "exampleBoolean": false
      },
      {
        "reference": {
          "reference": "CodeSystem/actortype-cs"
        },
        "name": "ActorType",
        "description": "Kodverk ActorTypeEnum enligt interoperability_headers_1.1.xsd (urn:riv:interoperability:headers:1). Anger vilken typ av aktör som anges i Actor.",
        "exampleBoolean": false
      },
      {
        "reference": {
          "reference": "ValueSet/actortype-vs"
        },
        "name": "ActorType — ValueSet",
        "description": "Tillåtna värden för Actor.actorType enligt ActorTypeCS.",
        "exampleBoolean": false
      },
      {
        "reference": {
          "reference": "CodeSystem/causingagent-cs"
        },
        "name": "CausingAgent",
        "description": "Kodverk CausingAgentEnum enligt interoperability_headers_1.1.xsd (urn:riv:interoperability:headers:1). Identifierar den komponent som felade vid en misslyckad synkronisering.",
        "exampleBoolean": false
      },
      {
        "reference": {
          "reference": "ValueSet/causingagent-vs"
        },
        "name": "CausingAgent — ValueSet",
        "description": "Tillåtna värden för ProcessingStatus.processingStatusList.lastUnsuccessfulSynchError.causingAgent enligt CausingAgentCS.",
        "exampleBoolean": false
      },
      {
        "reference": {
          "reference": "StructureDefinition/processingstatus"
        },
        "name": "ProcessingStatus",
        "description": "Logisk modell för det gemensamma huvudelementet ProcessingStatus\n(RIV-TA urn:riv:interoperability:headers:1, element ProcessingStatus av typen ProcessingStatusType).\nAnvänds av aggregerande tjänster för att rapportera tillbaka till konsumenten hur giltiga de returnerade\nuppgifterna är, med en statuspost per logisk adress (källsystem).",
        "exampleBoolean": false
      },
      {
        "reference": {
          "reference": "CodeSystem/processingstatuscode-cs"
        },
        "name": "ProcessingStatusCode",
        "description": "Kodverk StatusCodeEnum enligt interoperability_headers_1.1.xsd (urn:riv:interoperability:headers:1). Beskriver kvaliteten på de uppgifter som en aggregerande tjänst returnerat för en logisk adress.",
        "exampleBoolean": false
      },
