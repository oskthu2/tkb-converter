* medicationPrescriptionList.medicationDispenseAuthorization.MedicationDispenseAuthorizationForDoseDispensing_attr.dosage.occasions.dose.max.fraction.denominator 1..1 integer "denominator" "denominator"
* medicationPrescriptionList.medicationDispenseAuthorization.MedicationDispenseAuthorizationForDoseDispensing_attr.dosage.occasions.time 1..1 Base "TimeWithinDay" "den tid eller det tillfälle under dygnet när läkemedlet ska intas eller appliceras"
* medicationPrescriptionList.medicationDispenseAuthorization.MedicationDispenseAuthorizationForDoseDispensing_attr.dosage.occasions.time.event 0..1 code "event" "{ff, tf, mo, fl, tl, fm, tm, kv, tn, un, xx}ff = före frukost (morgonmål)tf = till frukostmo = på morgonenfl = före lunch (måltid mitt på dagen)tl= till lunchfm = före middagentm = till middagen (måltid på kvällen)kv = på kvällentn = till nattenun = under nattenxx= ospecificerad Tillåtna värden: ff, tf, mo, fl, tl, fm, tm, kv, tn, un, xx."
* medicationPrescriptionList.medicationDispenseAuthorization.MedicationDispenseAuthorizationForDoseDispensing_attr.dosage.occasions.time.time 0..1 Base "Time" "time"
