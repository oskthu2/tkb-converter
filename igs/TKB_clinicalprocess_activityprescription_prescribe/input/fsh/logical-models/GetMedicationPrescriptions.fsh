* medicationList.medicationPrescriptionSequences.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForDoseDispensing_attr.dosage.occasions.dose.min.decimalNumber 0..1 Base "DecimalNumber" "decimalNumber"
* medicationList.medicationPrescriptionSequences.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForDoseDispensing_attr.dosage.occasions.dose.min.decimalNumber.value 1..1 decimal "value" "value"
* medicationList.medicationPrescriptionSequences.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForDoseDispensing_attr.dosage.occasions.dose.min.decimalNumber.decimals 1..1 integer "decimals" "decimals"
