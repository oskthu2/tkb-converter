<xs:schema xmlns:xs='http://www.w3.org/2001/XMLSchema' 
    xmlns:tns='urn:riv:strategicresourcemanagement:persons:person:UpdatePersonContactInformationResponder:4'
    xmlns:strategicresourcemanagementpersonsperson='urn:riv:strategicresourcemanagement:persons:person:5'
    targetNamespace='urn:riv:strategicresourcemanagement:persons:person:UpdatePersonContactInformationResponder:4'
    elementFormDefault='qualified'
    attributeFormDefault='unqualified'
    version='4.0'>

    <xs:import schemaLocation='../../core_components/strategicresourcemanagement_persons_person_5.0.xsd' namespace='urn:riv:strategicresourcemanagement:persons:person:5' />

    <xs:element name='UpdatePersonContactInformation' type='tns:UpdatePersonContactInformationType'/>

    <xs:complexType name='UpdatePersonContactInformationType'>
        <xs:annotation>
            <xs:documentation>
                Tjänst för att skapa/uppdatera information om kontaktinformation. Antingen via någon tjänst med vilken patienten själv har matat in eller av en vårdaktör via vårdaktörens journalsystem/eTjänst efter uppgivande av personen. Kontaktuppgifterna består dels av vilka kontaktvägar (telefon, mail etc) som personen själv i fråga kan nås på. Dels av kontaktpersoner och dess kontaktuppgifter som personen uppger. Kontaktpersoner kan t.ex vara anhöriga som vårdens aktörer kan ha behov av att kontakta kring personens vård. En konsument av denna tjänst kan således dels vara en patienttjänst såsom Journalen, dels ett vårdsystem.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="actor" type="strategicresourcemanagementpersonsperson:ActorType"/>
            <xs:element name="personId" type="strategicresourcemanagementpersonsperson:IIType"/>
            <xs:element name="versionToUpdate" type="strategicresourcemanagementpersonsperson:Timestamp" minOccurs="0"/>
            <xs:element name="contactInformation" type="strategicresourcemanagementpersonsperson:ContactInformationType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="contactPerson" type="strategicresourcemanagementpersonsperson:ContactPersonType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="optoutPaperNotification" type="xs:boolean" minOccurs="0"/>
			<xs:any maxOccurs="unbounded" minOccurs="0" namespace="##other" processContents="lax"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name='UpdatePersonContactInformationResponse' type='tns:UpdatePersonContactInformationResponseType'/>

    <xs:complexType name='UpdatePersonContactInformationResponseType'>
        <xs:annotation>
            <xs:documentation>
                Tjänst för att skapa/uppdatera information om kontaktinformation. Antingen via någon tjänst med vilken patienten själv har matat in eller av en vårdaktör via vårdaktörens journalsystem/eTjänst efter uppgivande av personen. Kontaktuppgifterna består dels av vilka kontaktvägar (telefon, mail etc) som personen själv i fråga kan nås på. Dels av kontaktpersoner och dess kontaktuppgifter som personen uppger. Kontaktpersoner kan t.ex vara anhöriga som vårdens aktörer kan ha behov av att kontakta kring personens vård. En konsument av denna tjänst kan således dels vara en patienttjänst såsom Journalen, dels ett vårdsystem.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="updatePersonContactInformationResult" type="strategicresourcemanagementpersonsperson:UpdatePersonContactInformationResultType"/>
            <xs:any maxOccurs="unbounded" minOccurs="0" namespace="##other" processContents="lax"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>