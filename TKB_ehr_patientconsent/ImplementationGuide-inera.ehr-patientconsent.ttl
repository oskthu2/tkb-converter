       fhir:ImplementationGuide.definition.resource.name [ fhir:value "AssertionType" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Typ av intyg som ger direktåtkomst till information från andra vårdgivare enligt PDL. Kan vara patientens samtycke eller nödsituation." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
