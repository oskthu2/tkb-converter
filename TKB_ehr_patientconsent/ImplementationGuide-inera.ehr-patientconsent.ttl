         fhir:link <https://fhir.inera.se/ig/ehr-patientconsent/StructureDefinition/checkconsent> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/checkconsent" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CheckConsent" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Logisk modell för tjänstekontraktet CheckConsent\n(RIV-TA urn:riv:ehr:patientconsent:accesscontrol:CheckConsentResponder:1).\nRepresenterar responsens informationsstruktur.\n\nTjänst som kontrollerar om det finns ett giltigt samtycke, alternativt intyg om nödsituation,\ngällande åtkomst för viss aktör (vårdenhet eller medarbetare). Med giltigt samtycke avses ett\nsamtycke som fortfarande är giltigt, ej makulerat eller återkallat." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
