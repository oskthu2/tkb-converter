       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "CancelExtendedConsent — Request" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Logisk modell för requestparametrar i CancelExtendedConsent." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
