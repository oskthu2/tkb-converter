       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Logisk modell för requestparametrar i CheckConsent." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
