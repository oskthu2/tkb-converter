       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Logisk modell för requestparametrar i GetConsentsForCareProvider." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
