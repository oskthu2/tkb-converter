       fhir:ElementDefinition.definition [ fhir:value "De Bild-resultat(dokument) som matchar begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `imagingOutcome` (`ImagingOutcomeType`, kardinalitet 0..*)." ] ;
