       fhir:ElementDefinition.path [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.laboratoryOrderOutcomeHeader.documentId" ] ;
       fhir:ElementDefinition.short [ fhir:value "documentId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Unik identifierare för undersökningsresultatet. Identitet ska vara unik inom källsystemet\n\nIdentifieraren ska vara konsistent och beständigt mellan olika majorversioner av ett kontrakt. Ett exempel på detta är att en vårdkontakt ska ha samma identifierare i majorversion 3 och 4 av ett tjänstekontrakt för att läsa vårdkontakter.\n\nIdentifieraren ska vara konsistent och beständigt mellan olika kontrakt. Ett exempel på detta är att samma remiss-identitet ska användas i ett tjänstekontrakt för att läsa remisser, samt tjänstekontraktet som läser remissvar som refererar till den ursprungliga remissen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../documentId` (`string`, kardinalitet 1..1)." ] ;
