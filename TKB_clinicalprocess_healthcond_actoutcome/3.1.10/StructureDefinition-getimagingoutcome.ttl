       fhir:ElementDefinition.short [ fhir:value "Ansvarig hälso- och sjukvårdsperson" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ansvarig hälso- och sjukvårdsperson. Ansvarig för undersökningsresultatet. Avser person som är ansvarig för det samlade dokumentet.\nRIV-TA-typ: HealthcareProfessionalType. Kardinalitet i TKB: 1..1." ] ;
