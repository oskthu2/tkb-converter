       fhir:ElementDefinition.short [ fhir:value "timestamp" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den tidpunkt då uppgiften skapades i tjänsteproducentens källsystem. Denna information ska vara beständig även om tjänsteproducenten migrerat uppgiften från ett källsystem till en annat.\n\nMotsvarar Laboratoriesvar.svarstidpunkt i informationsspecifikationen [R6]" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `//*:header/*:record/*:timestamp` (`TimeStampType`, kardinalitet 1..1)." ] ;
