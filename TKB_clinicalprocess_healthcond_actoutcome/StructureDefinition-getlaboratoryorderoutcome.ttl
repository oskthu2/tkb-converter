         ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.accessControlHeader.lockTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.accessControlHeader.lockTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "lockTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "lockTime" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `.//*:header/*:accessControlHeader/*:lockTime` (`TimeStampType`, kardinalitet 0..0).\n\n**Regel 2.2:** Detta element skall ej användas. Enligt SOSFS 2016:40 ska det ej längre finnas möjlighet att låsa osignerade journalanteckningar" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType>
         ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "blockComparisonTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den tidpunkt mot vilken spärrkontroll sker vid åtkomst med syftet sammanhållen journalföring. Gäller både yttre (mellan vårdgivare) och inre (mellan vårdenheter) spärr.\n\nI detta fält anges provtagningstidpunkt. Om ett svar innehåller analyser utförda på olika prov anges tidpunkt för det senast tagna provet." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `//*:header/*:accessControlHeader/*:blockComparisonTime` (`TimeStampType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType>
         ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.accessControlHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.accessControlHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.short [ fhir:value "approvedForPatient" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ansvarig vårdpersonals beslut, alternativt verksamhetens policy och regler (men- och sekretessprövning), huruvida uppgiften får delas till patient för ändamålet patients åtkomst (Individens direktåtkomst).\n\nOm uppgiften beslutas delas sätts värdet till true, i annat fall till false. False innebär att uppgiften inte får delas till patient.\n\nNotera att värdet kan, för samma uppgift, förändras med tiden på grund av att rådrumstid har passerats, eller att verksamheten ändrat policy för vad som lämnas ut till patient. I sådana fall skall källsystemet uppdatera engagemangsindex." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `//*:header/*:accessControlHeader/*:approvedForPatient` (`boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.accessControlHeader.patientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.accessControlHeader.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "patientId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Personidentifierare för patienten.\n\nroot sätts till OID för typ av personidentifierare.\n\nFör personnummer ska Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas.\n\nFör samordningsnummer skall Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas.\n\nFör andra typer av personidentifierare sätts root till aktuell OID.\n\nextension sätts till patientens identifierare. Anges med 12 tecken utan avskiljare.\n\nObligatorisk vid nyanslutning" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `//*:header/*:accessControlHeader/*:patientId` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/clinicalprocess-healthcond-actoutcome/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.sourceSystemId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlaboratoryorderoutcome.laboratoryOrderOutcome.header.sourceSystemId" ] ;
       fhir:ElementDefinition.short [ fhir:value "sourceSystemId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Det källsystem som uppgiften lagras i.\n\nroot sätts till OID för HSA-katalogen (1.2.752.129.2.1.4.1)\n\nextension sätts till källsystemets HSA-id" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `//*:header/*:sourceSystemId` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/clinicalprocess-healthcond-actoutcome/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 13 ;
