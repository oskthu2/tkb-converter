       fhir:ElementDefinition.definition [ fhir:value "Ett eller flera laboratoriesvar som matchar begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `//*:laboratoryOrderOutcome` (`LaboratoryOrderOutcomeType`, kardinalitet 0..*)." ] ;
