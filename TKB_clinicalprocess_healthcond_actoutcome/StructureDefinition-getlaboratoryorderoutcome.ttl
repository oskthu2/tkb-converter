       fhir:ElementDefinition.definition [ fhir:value "Information avseende uppgiften som tillgängliggörs." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `//*:header/*:record` (`RecordType`, kardinalitet 1..1)." ] ;
