     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getlaboratoryorderoutcome-request.careGiverHSAId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlaboratoryorderoutcome-request.careGiverHSAId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careGiverHSAId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Filtrering på vårdgivare vilket motsvarar accountableCareGiver i svaret.\n\nroot sätts till OID (1.2.752.129.2.1.4.1) för HSA\n\nextension sätts till HSA-id på vårdgivare" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `//*:careGiverHSAId` (`IIType`, kardinalitet 0..*)." ] ;
