       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 50 ;
       fhir:Element.id [ fhir:value "processrequestoutcome.requestOutcome.attachment.id" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequestoutcome.requestOutcome.attachment.id" ] ;
       fhir:ElementDefinition.short [ fhir:value "id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Bilaga id\n\nIdentitet på bilagan. Används för inbäddade bilagor vid referenser inom en tjänsteinteraktion.\n\nFormat remissvar: requestOutcomeId#löpnummer =Källsystem-Id(HSA-ID)#lokalt-id#löpnummer\n\nObligatoriskt för inbäddade bilagor" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `requestOutcome.attachment.id` (`String`, kardinalitet 0..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** (.*)#(.*)#(.*)\n\nMaxlängd 256 tecken" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 51 ;
       fhir:Element.id [ fhir:value "processrequestoutcome.requestOutcome.attachment.mediaType" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequestoutcome.requestOutcome.attachment.mediaType" ] ;
       fhir:ElementDefinition.short [ fhir:value "mediaType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Multimediatyp\n\nTyp av multimedia, se urval med tillåtna format.\n\ncode: se urval_mediatyper_elektronisk_remiss\n\ncodeSystem: (1.2.752.129.5.1.59, se nedan)\n\nUnder codeSystem anges identifieraren för det kodverk från vilken den angivna koden hämtats. Detta medför att det kan skickas olika identifierare under codeSystem, beroende på vilket kodverk den skickade koden tillhör.\n\nUrvalet kan komma att kompletteras över tid vilket medför att konsumenter och producenter av tjänstekontrakten behöver vara förberedda på att nya koder kan tillkomma utan att versionen på tjänstekontraktet uppdateras." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `requestOutcome.attachment.mediaType` (`CVType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** urval_mediatyper_elektronisk_\n\nremiss" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/clinicalprocess-activity-request/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 52 ;
       fhir:Element.id [ fhir:value "processrequestoutcome.requestOutcome.attachment.value" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequestoutcome.requestOutcome.attachment.value" ] ;
       fhir:ElementDefinition.short [ fhir:value "value" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Binärdata\n\nAnvänds vid inbäddad bilaga och innehåller då bilagans binärdata, kodat enligt base64. Om bilagan innehåller avkodad text ska denna vara avkodad från UTF-8-format. Obligatoriskt när referens inte används." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `requestOutcome.attachment.value` (`Base64Binary`, kardinalitet 0..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** Ett meddelande med bilagor får inte vara större än 10MB" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
