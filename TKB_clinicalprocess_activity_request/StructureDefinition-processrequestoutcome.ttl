       fhir:ElementDefinition.short [ fhir:value "reference" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Referens\n\nAnvänds vid refererad bilaga, och innehåller då den URL där bilagan kan hämtas. OBS! Används inte i denna version." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `requestOutcome.attachment.reference` (`AnyURI`, kardinalitet 0..0)." ] ;
