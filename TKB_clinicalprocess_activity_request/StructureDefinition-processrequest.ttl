       fhir:ElementDefinition.short [ fhir:value "Patient" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Patient" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.patient` (`PatientType`, kardinalitet 1..1).\n\n**Modellanteckning:** Patient (PatientType)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
