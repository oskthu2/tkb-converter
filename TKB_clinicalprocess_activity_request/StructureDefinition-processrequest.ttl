       fhir:ElementDefinition.definition [ fhir:value "Kön\n\nAnger administrativt kön, dvs. det kön patienten har registrerat hos Skatteverket.\n\nOID för kodsystem: 1.2.752.129.2.2.1.1\n\nGiltiga värden är:\n\n0 = okänt\n\n1 = man\n\n2 = kvinna\n\n9 = ej tillämpligt" ] ;
