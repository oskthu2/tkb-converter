       fhir:ElementDefinition.path [ fhir:value "processrequest.attachment.description" ] ;
       fhir:ElementDefinition.short [ fhir:value "Beskrivning" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Beskrivning\n\nBeskrivning av bilaga, t ex innehåll" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.attachment.description` (`String`, kardinalitet 0..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** Maxlängd 256 tecken\n\n**Modellanteckning:** Beskrivning av bilaga. Maxlängd 256 tecken." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
