       fhir:ElementDefinition.path [ fhir:value "processrequest.request.attachment" ] ;
       fhir:ElementDefinition.short [ fhir:value "MultimediaType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Bilaga\n\nMöjlighet att skicka med en eller flera bilagor i något av de tillåtna formaten" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.attachment` (`MultimediaType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
