       fhir:ElementDefinition.short [ fhir:value "PersonIdType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Person id\n\nPatientens identitet" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.patient.personId` (`PersonIdType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
