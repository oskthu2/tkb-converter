       fhir:ElementDefinition.path [ fhir:value "processrequest.requestId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Remiss id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remiss id\n\nRemissens identitet. Format: Källsystem-Id(HSA-ID)#lokalt-id\n\nExempel: SE2321000012-0001#987" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.requestId` (`RequestIdType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** (.*)#(.*)\n\nMaxlängd 256 tecken" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "processrequest.requestId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "processrequest.typeOfRequest" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.typeOfRequest" ] ;
       fhir:ElementDefinition.short [ fhir:value "Remisstyp" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remisstyp\n\nAnger typ av remiss.\n\nI denna version är den giltiga koden ”4” – allmänremiss" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.typeOfRequest` (`CodeForRequestType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** codes:codeRequestOutcomeType" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "processrequest.typeOfRequest" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "code" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://fhir.inera.se/ig/clinicalprocess-activity-request/ValueSet/requesttype-vs" ;
           fhir:link <https://fhir.inera.se/ig/clinicalprocess-activity-request/ValueSet/requesttype-vs>
         ]
       ]
     ], [
       fhir:index 3 ;
