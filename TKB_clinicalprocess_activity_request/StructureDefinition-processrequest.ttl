       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.paymentCommitment.approvedBy.id` (`HsaIdType`, kardinalitet 0..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** Maxlängd 64 tecken\n\n**Modellanteckning:** HSA-id för person. RIV-TA: approvedBy.id." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ]
       ]
     ], [
       fhir:index 79 ;
       fhir:Element.id [ fhir:value "processrequest.paymentCommitment.approvedBy.healthcareProfessionalName" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.paymentCommitment.approvedBy.healthcareProfessionalName" ] ;
       fhir:ElementDefinition.short [ fhir:value "Personal namn" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Personal namn" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.paymentCommitment.approvedBy.name` (`String`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** Maxlängd 64 tecken\n\n**Modellanteckning:** Maxlängd 64 tecken. RIV-TA: approvedBy.name." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 80 ;
       fhir:Element.id [ fhir:value "processrequest.attachment" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.attachment" ] ;
       fhir:ElementDefinition.short [ fhir:value "Bilaga" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Bilaga\n\nMöjlighet att skicka med en eller flera bilagor i något av de tillåtna formaten" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.attachment` (`MultimediaType`, kardinalitet 0..*).\n\n**Modellanteckning:** Bilaga (MultimediaType) i något av de tillåtna formaten. Totala meddelandestorleken får inte överstiga 10 MB." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "BackboneElement" ]
       ]
     ], [
       fhir:index 81 ;
       fhir:Element.id [ fhir:value "processrequest.attachment.attachmentId" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.attachment.attachmentId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Bilaga id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Bilaga id\n\nIdentitet på bilagan. Används för inbäddade bilagor vid referenser inom en tjänsteinteraktion.\n\nFormat bilaga remiss: requestId#löpnummer = Källsystem-Id(HSA-ID)#lokalt-id#löpnummer\n\nObligatoriskt för inbäddade bilagor" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.attachment.id` (`String`, kardinalitet 0..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** (.*)#(.*)#(.*)\n\nMaxlängd 256 tecken" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 82 ;
       fhir:Element.id [ fhir:value "processrequest.attachment.mediaType" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.attachment.mediaType" ] ;
       fhir:ElementDefinition.short [ fhir:value "Multimediatyp" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Multimediatyp\n\nTyp av multimedia, se urval med tillåtna format.\n\ncode: se urval_mediatyper_elektronisk_remiss\n\ncodeSystem: (1.2.752.129.5.1.59, se nedan)\n\nUnder codeSystem anges identifieraren för det kodverk från vilken den angivna koden hämtats. Detta medför att det kan skickas olika identifierare under codeSystem, beroende på vilket kodverk den skickade koden tillhör.\n\nKodverket kan komma att kompletteras över tid vilket medför att konsumenter och producenter av tjänstekontrakten behöver vara förberedda på att nya koder kan tillkomma utan att versionen på tjänstekontraktet uppdateras." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.attachment.mediaType` (`CVType`, kardinalitet 1..1).\n\n**Modellanteckning:** Filformat enligt urval_mediatyper_elektronisk_remiss (codeSystem 1.2.752.129.5.1.59): pdf, jpeg, png, html, txt, gif, bmp." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "CodeableConcept" ]
       ]
     ], [
       fhir:index 83 ;
       fhir:Element.id [ fhir:value "processrequest.attachment.attachmentValue" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.attachment.attachmentValue" ] ;
       fhir:ElementDefinition.short [ fhir:value "Binärdata" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Binärdata\n\nAnvänds vid inbäddad bilaga och innehåller då bilagans binärdata, kodat enligt base64. Om bilagan innehåller avkodad text ska denna vara avkodad från UTF-8-format.\n\nObligatoriskt när referens inte används." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.attachment.value` (`Base64Binary`, kardinalitet 0..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** Ett meddelande med bilagor får inte vara större än 10MB" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "base64Binary" ]
       ]
     ], [
       fhir:index 84 ;
       fhir:Element.id [ fhir:value "processrequest.attachment.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.attachment.reference" ] ;
       fhir:ElementDefinition.short [ fhir:value "Referens" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Referens\n\nAnvänds vid refererad bilaga, och innehåller då den URL där bilagan kan hämtas.\n\nOBS! Används inte i denna version." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.attachment.reference` (`AnyURI`, kardinalitet 0..0)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "uri" ]
       ]
     ], [
       fhir:index 85 ;
       fhir:Element.id [ fhir:value "processrequest.attachment.description" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.attachment.description" ] ;
       fhir:ElementDefinition.short [ fhir:value "Beskrivning" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Beskrivning\n\nBeskrivning av bilaga, t ex innehåll" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.attachment.description` (`String`, kardinalitet 0..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** Maxlängd 256 tecken\n\n**Modellanteckning:** Beskrivning av bilaga. Maxlängd 256 tecken." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 86 ;
       fhir:Element.id [ fhir:value "processrequest.careProcessId" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.careProcessId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Vårdprocess id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vårdprocess id\n\nIdentifierare som unikt identifierar den individanpassade vårdprocess som denna remiss är en del av. Används för att kunna hålla samman information över aktörsgränser och koppling till patientens hälsoärende. Producentsystemet bör registrera all information som registreras kring patienten kopplat till detta id." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.careProcessId` (`String`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ]
  ] .

