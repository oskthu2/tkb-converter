       fhir:ElementDefinition.path [ fhir:value "processrequest.request.reasonForVersion.typeOfReason.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "code" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Anger varför en ny version skapats.\n\nVärden enligt Kv e-remiss versionsorsak, se [R5]. Giltiga värden är:\n\nNR = Ny remiss\n\nAR = Ändrad remiss\n\nVR = Vidareskickad remiss\n\nAB = Ändrat betalningsansvar" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.reasonForVersion.typeOfReason.code` (`CodeVersionReason_values`, kardinalitet 1..1).\n\n**Modellanteckning:** code (XML-attribut) Tillåtna värden: NR, AR, VR, AB." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
