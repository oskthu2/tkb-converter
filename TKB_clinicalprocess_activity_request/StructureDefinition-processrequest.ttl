       fhir:ElementDefinition.path [ fhir:value "processrequest.request.patient.personId.extension" ] ;
       fhir:ElementDefinition.short [ fhir:value "extension" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Personidentifierare för patienten.\n\nOm identiteten är av typ personnummer, samordningsnummer eller nationellt reservId skall denna anges med 12 tecken utan skiljetecken." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.patient.personId.extension` (`String`, kardinalitet 1..1).\n\n**Modellanteckning:** extension (XML-attribut)" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
