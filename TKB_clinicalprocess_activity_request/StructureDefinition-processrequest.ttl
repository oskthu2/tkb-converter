         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ]
  ] ;
  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "processrequest" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest" ] ;
       fhir:ElementDefinition.short [ fhir:value "ProcessRequest — Remiss (begäran)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för begäran i ProcessRequest (RIV-TA urn:riv:clinicalprocess:activity:request:ProcessRequestResponder:2, element request av typen RequestType). Remittenten skickar en allmänremiss till remissmottagaren. Svaret är enbart ett resultat, se ProcessResult." ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "processrequest-vr-intermediary" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Om versionsorsak är VR (vidareskickad remiss) måste intermediaryParticipant anges (schematron Verify intermediaryParticipant)" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "reasonForVersion.typeOfReason = 'VR' implies intermediaryParticipant.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.inera.se/ig/clinicalprocess-activity-request/StructureDefinition/processrequest" ;
           fhir:link <https://fhir.inera.se/ig/clinicalprocess-activity-request/StructureDefinition/processrequest>
         ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "processrequest.requestId" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.requestId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Remiss id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remiss id\n\nRemissens identitet. Format: Källsystem-Id(HSA-ID)#lokalt-id\n\nExempel: SE2321000012-0001#987" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.requestId` (`RequestIdType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** (.*)#(.*)\n\nMaxlängd 256 tecken" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "processrequest.typeOfRequest" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.typeOfRequest" ] ;
       fhir:ElementDefinition.short [ fhir:value "Remisstyp" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remisstyp\n\nAnger typ av remiss.\n\nI denna version är den giltiga koden ”4” – allmänremiss" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.typeOfRequest` (`CodeForRequestType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** codes:codeRequestOutcomeType" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "code" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://fhir.inera.se/ig/clinicalprocess-activity-request/ValueSet/requesttype-vs" ;
           fhir:link <https://fhir.inera.se/ig/clinicalprocess-activity-request/ValueSet/requesttype-vs>
         ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "processrequest.versionTimeStamp" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.versionTimeStamp" ] ;
       fhir:ElementDefinition.short [ fhir:value "Versionstidpunkt" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Versionstidpunkt\n\nTidpunkt då versionen skapades.\n\nDenna tidpunkt kan skilja sig från tidpunkten då remissen skickas." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.versionTimeStamp` (`TimeStampType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** ÅÅÅÅMMDDttmmss" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "dateTime" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "processrequest.versionNumber" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.versionNumber" ] ;
       fhir:ElementDefinition.short [ fhir:value "Versionsnummer" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Versionsnummer\n\nRemissens versionsnummer.\n\nVersion startar alltid på 1 och räknas sekventiellt upp för varje ny version.\n\nDenna räknas upp vid:\n\nÄndrad remiss\n\nVidareskickad remiss\n\nÄndrat betalnings-ansvar" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.versionNumber` (`VersionNumberType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** (0*[1-9]+|[1-9])\\d*" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "positiveInt" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "processrequest.reasonForVersion" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.reasonForVersion" ] ;
       fhir:ElementDefinition.short [ fhir:value "Versionsorsak" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Versionsorsak" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.reasonForVersion` (`ReasonForVersionType`, kardinalitet 1..1).\n\n**Modellanteckning:** Anger varför en ny version skapats." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
