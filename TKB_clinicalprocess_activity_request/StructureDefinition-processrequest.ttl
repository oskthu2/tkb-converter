     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "processrequest.request.reasonForVersion.typeOfReason" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.request.reasonForVersion.typeOfReason" ] ;
       fhir:ElementDefinition.short [ fhir:value "codeVersionReason" ] ;
       fhir:ElementDefinition.definition [ fhir:value "typeOfReason" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.reasonForVersion.typeOfReason` (`CodeVersionReason`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
