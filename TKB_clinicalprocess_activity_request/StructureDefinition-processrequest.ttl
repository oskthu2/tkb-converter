       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 111 ;
       fhir:Element.id [ fhir:value "processrequest.request.careProcessId" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.request.careProcessId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careProcessId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vårdprocess id\n\nIdentifierare som unikt identifierar den individanpassade vårdprocess som denna remiss är en del av. Används för att kunna hålla samman information över aktörsgränser och koppling till patientens hälsoärende. Producentsystemet bör registrera all information som registreras kring patienten kopplat till detta id." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.careProcessId` (`String`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "processrequest.request.careProcessId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ]
  ] ;
  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "processrequest" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest" ] ;
       fhir:ElementDefinition.short [ fhir:value "ProcessRequest — Remiss (begäran)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för begäran i ProcessRequest (RIV-TA urn:riv:clinicalprocess:activity:request:ProcessRequestResponder:2, element request av typen RequestType). Remittenten skickar en allmänremiss till remissmottagaren. Svaret är enbart ett resultat, se ProcessResult." ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "processrequest-vr-intermediary" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Om versionsorsak är VR (vidareskickad remiss) måste intermediaryParticipant anges (schematron Verify intermediaryParticipant)" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "request.reasonForVersion.typeOfReason.code = 'VR' implies request.intermediaryParticipant.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.inera.se/ig/clinicalprocess-activity-request/StructureDefinition/processrequest" ;
           fhir:link <https://fhir.inera.se/ig/clinicalprocess-activity-request/StructureDefinition/processrequest>
         ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "processrequest.request" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.request" ] ;
       fhir:ElementDefinition.short [ fhir:value "RequestType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remiss" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `Request` (`RequestType`)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
