       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "processrequest.request.versionTimeStamp" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.request.versionTimeStamp" ] ;
       fhir:ElementDefinition.short [ fhir:value "TimeStampType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Versionstidpunkt\n\nTidpunkt då versionen skapades.\n\nDenna tidpunkt kan skilja sig från tidpunkten då remissen skickas." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.versionTimeStamp` (`TimeStampType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** ÅÅÅÅMMDDttmmss" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
