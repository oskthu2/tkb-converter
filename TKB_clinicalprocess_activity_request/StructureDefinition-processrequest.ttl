         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 16 ;
       fhir:Element.id [ fhir:value "processrequest.request.patient.personId.root" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.request.patient.personId.root" ] ;
       fhir:ElementDefinition.short [ fhir:value "root" ] ;
       fhir:ElementDefinition.definition [ fhir:value "OID för typ av personidentifierare.\n\nFör personnummer ska Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas.\n\nFör samordningsnummer ska Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas.\n\nFör nationellt reservId ska OID för nationellt reservId (1.2.752.74.9.1) användas.\n\nFör andra typer av personidentifierare sätts root till aktuell OID." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.patient.personId.root` (`String`, kardinalitet 1..1).\n\n**Modellanteckning:** root (XML-attribut)" ] ;
