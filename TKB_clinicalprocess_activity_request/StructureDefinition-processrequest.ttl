       fhir:ElementDefinition.path [ fhir:value "processrequest.request.typeOfRequest" ] ;
       fhir:ElementDefinition.short [ fhir:value "codeForRequestType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remisstyp\n\nAnger typ av remiss.\n\nI denna version är den giltiga koden ”4” – allmänremiss" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.typeOfRequest` (`CodeForRequestType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** codes:codeRequestOutcomeType" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
