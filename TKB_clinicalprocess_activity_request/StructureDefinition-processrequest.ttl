       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "processrequest.reasonForVersion.typeOfReason" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.reasonForVersion.typeOfReason" ] ;
       fhir:ElementDefinition.short [ fhir:value "Versionsorsak kod" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kv e-remiss versionsorsak [R5]: NR, AR, VR, AB. RIV-TA: typeOfReason.code." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.reasonForVersion.typeOfReason` (`CodeVersionReason`, kardinalitet 1..1).\n\n**Modellanteckning:** Kv e-remiss versionsorsak [R5]: NR, AR, VR, AB. RIV-TA: typeOfReason.code." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
