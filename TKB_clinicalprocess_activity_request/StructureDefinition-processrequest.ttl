       fhir:ElementDefinition.path [ fhir:value "processrequest.versionNumber" ] ;
       fhir:ElementDefinition.short [ fhir:value "Versionsnummer" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Versionsnummer\n\nRemissens versionsnummer.\n\nVersion startar alltid på 1 och räknas sekventiellt upp för varje ny version.\n\nDenna räknas upp vid:\n\nÄndrad remiss\n\nVidareskickad remiss\n\nÄndrat betalnings-ansvar" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.versionNumber` (`VersionNumberType`, kardinalitet 1..1).\n\n**Kodverk/värde-mängd /ev begränsningar:** (0*[1-9]+|[1-9])\\d*" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "processrequest.versionNumber" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "positiveInt" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "processrequest.reasonForVersion" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.reasonForVersion" ] ;
       fhir:ElementDefinition.short [ fhir:value "Versionsorsak" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Versionsorsak" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.reasonForVersion` (`ReasonForVersionType`, kardinalitet 1..1).\n\n**Modellanteckning:** Anger varför en ny version skapats." ] ;
