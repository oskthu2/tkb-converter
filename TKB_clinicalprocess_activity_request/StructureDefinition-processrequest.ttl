           fhir:link <https://fhir.inera.se/ig/clinicalprocess-activity-request/ValueSet/versionreason-vs>
         ]
       ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "processrequest.request.careResponsibilityRemains" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequest.request.careResponsibilityRemains" ] ;
       fhir:ElementDefinition.short [ fhir:value "careResponsibilityRemains" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vårdansvar kvarstår\n\nAnger om remittent vill att vårdansvar ska kvarstå hos remitterande enhet eller om man vill att vårdansvar överförs till remissmottagande enhet.\n\nTvå alternativ:\n\nTrue = Vårdansvar kvarstår\n\nFalse = Begäran om övertagande av vårdansvar" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `request.careResponsibilityRemains` (`Boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
