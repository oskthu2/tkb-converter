  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "processrequestconfirmation" ] ;
       fhir:ElementDefinition.path [ fhir:value "processrequestconfirmation" ] ;
       fhir:ElementDefinition.short [ fhir:value "ProcessRequestConfirmation — Remissbekräftelse (begäran)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för begäran i ProcessRequestConfirmation (RIV-TA urn:riv:clinicalprocess:activity:request:ProcessRequestConfirmationResponder:2, element requestConfirmation av typen RequestConfirmationType). Remissmottagaren skickar bekräftelse, besked om vidareskickning, kompletteringsbegäran, avbrott eller avvisning till remittenten. Svaret är enbart ett resultat, se ProcessResult." ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "processrequestconfirmation-forwarding-vid" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "forwardingRecipient ska anges om och endast om typeOfRequestConfirmation = VID" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "forwardingRecipient.exists() = (typeOfRequestConfirmation = 'VID')" ] ;
         fhir:ElementDefinition.constraint.source [
