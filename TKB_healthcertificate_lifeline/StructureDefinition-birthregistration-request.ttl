       fhir:Element.id [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.Levande" ] ;
       fhir:ElementDefinition.path [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.Levande" ] ;
       fhir:ElementDefinition.short [ fhir:value "Levande" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Då barnet var levande vid födelsen anges värdet \"JA\" annars anges värdet \"NEJ\".\n\nEndast ett värde får anges:\n\nFår endast ha värde\n\n\"JA\"\n\n\"NEJ\"" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `Levande` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
