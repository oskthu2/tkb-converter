       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `/BirthRegistration/Arendeuppgifter/Barn` (kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
