         ]
       ]
     ], [
       fhir:index 59 ;
       fhir:Element.id [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.OrdningsNr" ] ;
       fhir:ElementDefinition.path [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.OrdningsNr" ] ;
       fhir:ElementDefinition.short [ fhir:value "OrdningsNr" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Födelseordningsnummer för barnet i förhållande till övriga syskon som fötts vid samma förlossningstillfä lle.\n\nDet har ingen betydelse om barnen (syskonen) var levande eller döda vid förlossningen. OrdningsNr ska beskriva i vilken ordning det aktuella barnet föddes fram.\n\nEx 1: Om modern fött trillingar och detta är det andra barnet av de tre anges värdet \"2\" som OrdningsNr för det aktuella barnet.\n\nEx 2: Om födelsen avser en singel födelse anges värdet \"1\" som OrdningsNr. *(Figur saknas: bilden i originalets tabellcell kan inte extraheras ur .doc-filen.)*\n\n1 tecken. Värdet ska finnas i intervallet 1-9." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `OrdningsNr` (`int`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.OrdningsNr" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "integer" ]
       ]
     ], [
       fhir:index 60 ;
       fhir:Element.id [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.AntalBarn" ] ;
       fhir:ElementDefinition.path [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.AntalBarn" ] ;
       fhir:ElementDefinition.short [ fhir:value "AntalBarn" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Totalt antal födda barn av samma moder vid förlossningen. Det har ingen betydelse om barnen var levande eller döda vid förlossningen. Samtliga barn ska ingå.\n\nEx 1: Om modern fött trillingar anges värdet \"3\" för elementet AntalBarn.\n\nEx 2: Om det är en singel födelse anges värdet \"1\".\n\nOBS: förhållandet mellan de värden som levereras i elementen OrdningsNr och AntalBarn måste vara rimligt. Det kan t ex aldrig förekomma OrdningsNr \"3\" tillsammans med AntalBarn \"2\".\n\nOrdningsNr kan bara vara mindre eller lika med AntalBarn.\n\n1 tecken. Värdet ska finnas i intervallet 1-9." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `AntalBarn` (`int`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.AntalBarn" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "integer" ]
       ]
     ], [
       fhir:index 61 ;
       fhir:Element.id [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.FodelseKommun" ] ;
       fhir:ElementDefinition.path [ fhir:value "birthregistration-request.Arendeuppgifter.Barn.FodelseKommun" ] ;
       fhir:ElementDefinition.short [ fhir:value "FodelseKommun" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Namnet på den kommun där barnet förlöstes I klartext.\n\nT.ex kommun där födelsekliniken är belägen eller den kommun där taxin befann sig då förlossningen skedde i en taxi.\n\nMax 30 tecken" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `FodelseKommun` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
