       fhir:ElementDefinition.short [ fhir:value "MeddelandeTYPE" ] ;
       fhir:ElementDefinition.definition [ fhir:value "I de fall ett personnummer inte kunde tilldelas barnet levererar Skatteverket ett orsaksmeddelande istället." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `/BirthRegistrationResponse/Meddelande` (kardinalitet 1..1).\n\nObs: modellen anger 0..1 där TKB:n anger 1..1.\n\n**Modellanteckning:** Indikerar orsaken till att personnummer ej tilldelats." ] ;
