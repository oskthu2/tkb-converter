       fhir:ElementDefinition.short [ fhir:value "Tilldelat personnummer" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Barnets fullständiga personnummer som Skatteverket tilldelat det nyfödda barnet..\n\nSekel inkluderat. 12 tecken.\n\nÅÅÅÅMMDDXXXX." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `PersonNummer` (`long`, kardinalitet 1..1).\n\nObs: modellen anger 0..1 där TKB:n anger 1..1." ] ;
