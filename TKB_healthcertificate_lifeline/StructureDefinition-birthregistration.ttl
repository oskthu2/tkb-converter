       fhir:ElementDefinition.short [ fhir:value "Kod som indikerar orsaken till att personnummer ej returneras. datatyp = number" ] ;
       fhir:ElementDefinition.definition [ fhir:value "MeddelandeKod indikerar orsaken till att ett personnummer inte returnerats.\n\nFörteckning över förekommande koder och beskrivning, se rubrik \"Lista över meddelandekoder\".\n\nVärde inom intervallet givet av tabell med meddlandekoder." ] ;
