       fhir:ElementDefinition.short [ fhir:value "Svarskod för åtgärden" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Anger svarskod för åtgärden enligt ResultCode-kodverket.\nKardinalitet: Obligatorisk." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
