     fhir:CodeSystem.concept.display [ fhir:value "INFO" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Transaktionen har utförts enligt begäran, men det finns ett meddelande som konsumenten måste visa upp för användaren (om tillämpbart). Exempel: uppdrag ej valt." ]
  ], [
