<https://fhir.inera.se/ig/ehr-commission/CodeSystem/resultcode-cs> a fhir:CodeSystem ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "resultcode-cs"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem resultcode-cs</b></p><a name=\"resultcode-cs\"> </a><a name=\"hcresultcode-cs\"> </a><p>This case-sensitive code system <code>https://fhir.inera.se/CodeSystem/resultcode-cs</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">OK<a name=\"resultcode-cs-OK\"> </a></td><td>Transaktionen har utförts enligt uppdraget.</td></tr><tr><td style=\"white-space:nowrap\">INFO<a name=\"resultcode-cs-INFO\"> </a></td><td>Transaktionen har utförts enligt begäran, men det finns ett meddelande som konsumenten måste visa upp för användaren (om tillämpbart). Exempel: uppdrag ej valt.</td></tr><tr><td style=\"white-space:nowrap\">ERROR<a name=\"resultcode-cs-ERROR\"> </a></td><td>Transaktionen har INTE kunnat utföras p.g.a ett logiskt fel. Det finns ett meddelande som konsumenten måste visa upp. Exempel: personen finns inte i HSA.</td></tr><tr><td style=\"white-space:nowrap\">VALIDATION_ERROR<a name=\"resultcode-cs-VALIDATION_ERROR\"> </a></td><td>En eller flera inparametrar innehåller felaktiga värden. Angiven tjänst utfördes ej.</td></tr><tr><td style=\"white-space:nowrap\">ACCESSDENIED<a name=\"resultcode-cs-ACCESSDENIED\"> </a></td><td>Behörighet saknas för att utföra begärd tjänst. Angiven tjänst utfördes ej.</td></tr></table></div>"
  ] ;
  fhir:CodeSystem.url [ fhir:value "https://fhir.inera.se/CodeSystem/resultcode-cs"] ;
