       fhir:ElementDefinition.short [ fhir:value "healthcareFacilityHSAId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den valda listningsbara mottagningens HSAId.\n\nEn producent bör kunna hantera HSAId:n som uttrycks både med versaler eller gemener.\n\nExempelvis är:\n\n”se12345-xyz” = ”SE12345-XYZ”" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `healthcareFacilityHSAId` (`HSAIdType / (string)`, kardinalitet 1..1)." ] ;
