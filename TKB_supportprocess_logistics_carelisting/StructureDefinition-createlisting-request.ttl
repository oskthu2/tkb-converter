       ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "createlisting-request.listingType.cVCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "createlisting-request.listingType.cVCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "cVCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kod för listningstypen. Om listningstypen motsvarar den nationella listningstypen för primärvård (i enlighet med det fria vårdvalet) ska värdet vara PV. Regioner har möjlighet att definiera egna regionala listningstyper. Det är i sådant fall upp till regionen att upprätta och förvalta det regionala kodverket." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listingType.code` (`string`, kardinalitet 1..1).\n\n**Modellanteckning:** cVCode Heter code i schemat." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 13 ;
       fhir:Element.id [ fhir:value "createlisting-request.listingType.codeSystem" ] ;
       fhir:ElementDefinition.path [ fhir:value "createlisting-request.listingType.codeSystem" ] ;
       fhir:ElementDefinition.short [ fhir:value "codeSystem" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Sätts till den OID, urn eller liknande som visar på från vilket kodverk den angivna koden innefattas i.\n\nOm listningstypen motsvarar den nationella listningstypen för primärvård (i enlighet med det fria vårdvalet) ska värdet vara 1.2.752.129.5.1.27.\n\nhttps://inera.atlassian.net/wiki/download/attachments/2648506471/Kv%20nationella%20listningstyper.xlsx?api=v2" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listingType.codeSystem` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
