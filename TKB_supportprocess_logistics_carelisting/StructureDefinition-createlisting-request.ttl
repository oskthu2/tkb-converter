       fhir:ElementDefinition.definition [ fhir:value "Den aktör som utför handlingen. Aktören kan exempelvis vara invånaren eller vårdnadshavare som utför åtgärden åt invånaren. Inga andra aktörer tillåts nyttja detta tjänstekontakt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `actor` (`ActorType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
