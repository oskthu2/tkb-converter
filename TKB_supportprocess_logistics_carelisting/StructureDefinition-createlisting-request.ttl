       fhir:ElementDefinition.definition [ fhir:value "actorType Tillåtna värden: CITIZEN, GUARDIAN, REGION, PRIVATE_CAREGIVER, SELF_OWNED_CAREGIVER, HEALTHCARE_ADVISER." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../actorType` (`ActorTypeEnum`, kardinalitet 1..1).\n\n**Modellanteckning:** actorType Tillåtna värden: CITIZEN, GUARDIAN, REGION, PRIVATE_CAREGIVER, SELF_OWNED_CAREGIVER, HEALTHCARE_ADVISER." ] ;
