       fhir:ElementDefinition.path [ fhir:value "createlisting-request.healthcarePersonnel" ] ;
       fhir:ElementDefinition.short [ fhir:value "healthcarePersonnel" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vald vårdpersonals-/husläkares HSAId.\n\nDet är frivilligt för mottagningen att dessutom erbjuda val av vårdpersonal. Mottagningens valbara vårdpersonal fås genom tjänstekontraktet GetAvailableHealthcarePersonnel.\n\nObservera:\n\nOm invånaren redan är listad på mottagningen sedan tidigare ska detta anrop ses som att invånaren endast vill förändra sitt val av fast läkarkontakt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `healthcarePersonnel` (`HSAIdType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "createlisting-request.healthcarePersonnel" ] ;
