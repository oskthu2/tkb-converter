       fhir:ElementDefinition.path [ fhir:value "createlisting-request.listingType" ] ;
       fhir:ElementDefinition.short [ fhir:value "listingType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kod för listningstyp. Denna kod har tidigare hämtats från de listningstyper som vald region stödjer, exempelvis via tjänstekontraktet GetListingTypes." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listingType` (`CVType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
