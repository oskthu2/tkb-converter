       fhir:ElementDefinition.path [ fhir:value "createlisting-request.newListingCounty" ] ;
       fhir:ElementDefinition.short [ fhir:value "newListingCounty" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Pålistningsregion, d v s den region där vald mottagning har ett vårdavtal och är listningsbar i.\n\nKan utelämnas om listningen gäller i hemregionen (folkbokföringsregionen)" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `newListingCounty` (`IIType`, kardinalitet 0..1)." ] ;
