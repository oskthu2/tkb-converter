       fhir:ElementDefinition.short [ fhir:value "displayName" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Fältet kan utelämnas av konsument. Det är producentens (regionens listningssystem) ansvar att tillhandahålla listningstypens namn. En producent kan ignorera detta värde om konsument ändå skickar med ett namn på listningtyp." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listingType.displayName` (`string`, kardinalitet 0..1)." ] ;
