       fhir:ElementDefinition.path [ fhir:value "createlisting-request.listingType.codeSystem" ] ;
       fhir:ElementDefinition.short [ fhir:value "codeSystem" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Sätts till den OID, urn eller liknande som visar på från vilket kodverk den angivna koden innefattas i.\n\nOm listningstypen motsvarar den nationella listningstypen för primärvård (i enlighet med det fria vårdvalet) ska värdet vara 1.2.752.129.5.1.27.\n\nhttps://inera.atlassian.net/wiki/download/attachments/2648506471/Kv%20nationella%20listningstyper.xlsx?api=v2" ] ;
