     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "createlisting-request.healthcarePersonnel" ] ;
       fhir:ElementDefinition.path [ fhir:value "createlisting-request.healthcarePersonnel" ] ;
       fhir:ElementDefinition.short [ fhir:value "healthcarePersonnel" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vald vårdpersonals-/husläkares HSAId.\n\nDet är frivilligt för mottagningen att dessutom erbjuda val av vårdpersonal. Mottagningens valbara vårdpersonal fås genom tjänstekontraktet GetAvailableHealthcarePersonnel.\n\nObservera:\n\nOm invånaren redan är listad på mottagningen sedan tidigare ska detta anrop ses som att invånaren endast vill förändra sitt val av fast läkarkontakt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `healthcarePersonnel` (`HSAIdType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType>
         ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "createlisting-request.addToQueue" ] ;
       fhir:ElementDefinition.path [ fhir:value "createlisting-request.addToQueue" ] ;
       fhir:ElementDefinition.short [ fhir:value "addToQueue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förmedlar om invånare vill ställa sig i kö om den tilltänkta listningsbara mottagningen inte tillåts ta emot mer än ett maximalt antal listade invånare och om mottagningen erbjuder möjlighet att ställa sig i listningskö. Huruvida en mottagning erbjuder listningskö eller inte kan hämtas via tjänstekontraktet GetAvailableHealthcareFacilities.\n\n”TRUE” = Invånare vill ställa sig i listningskö.\n\n”FALSE” eller att attributet är utelämnat = Invånare vill inte ställa sig i listningskö eller vill gå ur kön.\n\nObservera:\n\nOm invånaren redan står i kö på denna mottagning och addToQueue = FALSE ska detta tolkas som att invånaren vill gå ur kön." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `addToQueue` (`boolean`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "createlisting-request.homeCounty" ] ;
       fhir:ElementDefinition.path [ fhir:value "createlisting-request.homeCounty" ] ;
       fhir:ElementDefinition.short [ fhir:value "homeCounty" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Invånares folkbokföringsregion.\n\nKan utelämnas om listningen gäller i hemregionen (folkbokföringsregionen), d v s om\n\nlogicalAddress = folkbokföringsregion\n\noch\n\nhealthcareFacilityHSAId pekar på en mottagning som har vårdavtal med regionen och är listningsbar där.\n\nAnnars är fältet obligatoriskt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `homeCounty` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
