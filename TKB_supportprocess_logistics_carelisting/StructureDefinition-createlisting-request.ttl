       fhir:ElementDefinition.short [ fhir:value "addToQueue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förmedlar om invånare vill ställa sig i kö om den tilltänkta listningsbara mottagningen inte tillåts ta emot mer än ett maximalt antal listade invånare och om mottagningen erbjuder möjlighet att ställa sig i listningskö. Huruvida en mottagning erbjuder listningskö eller inte kan hämtas via tjänstekontraktet GetAvailableHealthcareFacilities.\n\n”TRUE” = Invånare vill ställa sig i listningskö.\n\n”FALSE” eller att attributet är utelämnat = Invånare vill inte ställa sig i listningskö eller vill gå ur kön.\n\nObservera:\n\nOm invånaren redan står i kö på denna mottagning och addToQueue = FALSE ska detta tolkas som att invånaren vill gå ur kön." ] ;
