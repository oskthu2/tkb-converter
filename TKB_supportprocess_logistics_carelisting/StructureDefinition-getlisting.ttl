       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för svaret i GetListing\n(urn:riv:supportprocess:logistics:carelisting:GetListingResponder:2, GetListingResponseType)." ]
     ], [
       fhir:index 1 ;
