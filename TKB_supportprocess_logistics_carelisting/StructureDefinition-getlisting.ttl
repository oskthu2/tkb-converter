       fhir:ElementDefinition.path [ fhir:value "getlisting.resultText" ] ;
       fhir:ElementDefinition.short [ fhir:value "resultText" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kan utelämnas om resultCode = OK.\n\nProducent förväntas skicka ett tillräckligt informativt meddelande som kan presenteras för slutanvändare i ett användargränssnitt i de fall resultCode == ERROR." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `resultText` (`string`, kardinalitet 0..1)." ] ;
