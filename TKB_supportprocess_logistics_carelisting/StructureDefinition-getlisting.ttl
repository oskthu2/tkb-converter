       fhir:ElementDefinition.short [ fhir:value "remainingChanges" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nytt fält fr o m v2.1.\n\nFörmedlar hur många omlistningar som invånare har kvar att kunna göra.\n\nFör listning till primärvård får invånare lista om sig maximalt 3 ggr under en 12-månaders period enligt Socialstyrelsens föreskrifter." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.remainingChanges` (`integer`, kardinalitet 0..1)." ] ;
