       fhir:ElementDefinition.short [ fhir:value "title" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vårdpersonals titel" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcarePersonnel.title` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 17 ;
       fhir:Element.id [ fhir:value "getlisting.listings.isInQueue" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.isInQueue" ] ;
       fhir:ElementDefinition.short [ fhir:value "isInQueue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Flagga för att visa om invånare står i kö för att lista sig på mottagningen eller om invånare har en aktiv listning.\n\nTRUE = Invånare står i kö\n\nFALSE = Invånare har en aktiv listning på mottagningen" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.isInQueue` (`boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 18 ;
       fhir:Element.id [ fhir:value "getlisting.listings.queuePosition" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.queuePosition" ] ;
       fhir:ElementDefinition.short [ fhir:value "queuePosition" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nytt fält fr o m v2.1.\n\nFörmedlar vilken plats i listningskön som invånaren har om invånaren tidigare har valt att ställa sig i kö på mottagningen" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.queuePosition` (`integer`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "integer" ]
       ]
     ], [
       fhir:index 19 ;
       fhir:Element.id [ fhir:value "getlisting.listings.estimatedWaitInQueue" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.estimatedWaitInQueue" ] ;
       fhir:ElementDefinition.short [ fhir:value "estimatedWaitInQueue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nytt fält fr o m v2.1.\n\nFörmedlar hur lång uppskattad återstående väntetid invånaren kan förvänta sig om invånaren tidigare ställt sig i listningskön på mottagningen. Den uppskattade väntetiden ska återge ungefär hur länge till invånare uppskattas behöva vänta innan invånaren blir listad på mottagningen.\n\nUppskattad väntetid anges i antal dagar." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.estimatedWaitInQueue` (`integer`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "integer" ]
       ]
     ], [
       fhir:index 20 ;
       fhir:Element.id [ fhir:value "getlisting.listings.remainingChanges" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.remainingChanges" ] ;
       fhir:ElementDefinition.short [ fhir:value "remainingChanges" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nytt fält fr o m v2.1.\n\nFörmedlar hur många omlistningar som invånare har kvar att kunna göra.\n\nFör listning till primärvård får invånare lista om sig maximalt 3 ggr under en 12-månaders period enligt Socialstyrelsens föreskrifter." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.remainingChanges` (`integer`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "integer" ]
       ]
     ], [
       fhir:index 21 ;
       fhir:Element.id [ fhir:value "getlisting.resultCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.resultCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "resultCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kod för listningstypen. Om listningstypen motsvarar den nationella listningstypen för primärvård (i enlighet med det fria vårdvalet) ska värdet vara PV. Regioner har möjlighet att definiera egna regionala listningstyper. Det är i sådant fall upp till regionen att upprätta och förvalta det regionala kodverket." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.listingType.code` (`string`, kardinalitet 1..1).\n\n**Modellanteckning:** resultCode Tillåtna värden: OK, ERROR, INFO, ERROR_MAXIMUM_ANNUAL_UPDATES_EXCEEDED, ERROR_MAXIMUM_CITIZEN_REACHED_ON_CAREUNIT, ERROR_GUARDIAN_CONSENT_NEEDED, ERROR_AGE_LIMIT." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "code" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://fhir.inera.se/ig/supportprocess-logistics-carelisting/ValueSet/carelisting-resultcode-vs" ;
           fhir:link <https://fhir.inera.se/ig/supportprocess-logistics-carelisting/ValueSet/carelisting-resultcode-vs>
         ]
       ]
     ], [
