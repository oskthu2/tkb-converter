       fhir:ElementDefinition.short [ fhir:value "hasQueue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Visar huruvida mottagningen erbjuder kö när mottagningens maximala kvot av listade invånare har nåtts.\n\nSkall endast sättas till TRUE om mottagningens maximala kvot uppnåtts och mottagningen erbjuder kö till listning, således:\n\nTRUE = Maximala antalet invånare som mottagningen får lista är uppnått samt listningskö erbjuds\n\nFALSE = För övrigt" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcareFacility.hasQueue` (`boolean`, kardinalitet 1..1)." ] ;
