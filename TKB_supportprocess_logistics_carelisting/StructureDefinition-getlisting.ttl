       fhir:ElementDefinition.path [ fhir:value "getlisting.resultCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "resultCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kod för listningstypen. Om listningstypen motsvarar den nationella listningstypen för primärvård (i enlighet med det fria vårdvalet) ska värdet vara PV. Regioner har möjlighet att definiera egna regionala listningstyper. Det är i sådant fall upp till regionen att upprätta och förvalta det regionala kodverket." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.listingType.code` (`string`, kardinalitet 1..1).\n\n**Modellanteckning:** resultCode Tillåtna värden: OK, ERROR, INFO, ERROR_MAXIMUM_ANNUAL_UPDATES_EXCEEDED, ERROR_MAXIMUM_CITIZEN_REACHED_ON_CAREUNIT, ERROR_GUARDIAN_CONSENT_NEEDED, ERROR_AGE_LIMIT." ] ;
