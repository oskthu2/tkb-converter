       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.estimatedWaitInQueue" ] ;
       fhir:ElementDefinition.short [ fhir:value "estimatedWaitInQueue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nytt fält fr o m v2.1.\n\nFörmedlar hur lång uppskattad återstående väntetid invånaren kan förvänta sig om invånaren tidigare ställt sig i listningskön på mottagningen. Den uppskattade väntetiden ska återge ungefär hur länge till invånare uppskattas behöva vänta innan invånaren blir listad på mottagningen.\n\nUppskattad väntetid anges i antal dagar." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.estimatedWaitInQueue` (`integer`, kardinalitet 0..1)." ] ;
