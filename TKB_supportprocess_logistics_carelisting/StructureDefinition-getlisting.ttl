     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "getlisting.listings.healthcareFacility.hasQueue" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.healthcareFacility.hasQueue" ] ;
       fhir:ElementDefinition.short [ fhir:value "hasQueue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Visar huruvida mottagningen erbjuder kö när mottagningens maximala kvot av listade invånare har nåtts.\n\nSkall endast sättas till TRUE om mottagningens maximala kvot uppnåtts och mottagningen erbjuder kö till listning, således:\n\nTRUE = Maximala antalet invånare som mottagningen får lista är uppnått samt listningskö erbjuds\n\nFALSE = För övrigt" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcareFacility.hasQueue` (`boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "getlisting.listings.healthcareFacility.supportedListingTypes" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.healthcareFacility.supportedListingTypes" ] ;
       fhir:ElementDefinition.short [ fhir:value "supportedListingTypes" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Lista med olika listningstyper som mottagningen erbjuder.\n\nOm attributet är utelämnat innebär det att mottagningen endast erbjuder listning av typen öppenvårdsmottagning/primärvård. Se listningstyper i Informationsspecifikationen R3." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcareFacility.supportedListingTypes` (`CVType`, kardinalitet 0..1).\n\nObs: modellen anger 0..* där TKB:n anger 0..1.\n\n**Modellanteckning:** Lista med listningstyper som vårdeneheten stödjer. Kan utelämnas om information saknas eller om informationen inte behövs i kontexten där entiteten är tänkt att användas i." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-logistics-carelisting/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "getlisting.listings.healthcareFacility.supportsHealthcarePersonnel" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.healthcareFacility.supportsHealthcarePersonnel" ] ;
       fhir:ElementDefinition.short [ fhir:value "supportsHealthcarePersonnel" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Visar huruvida mottagningen erbjuder möjlighet att i samband med listning även välja specifik vårdpersonal, d v s ”fast läkarkontakt\".\n\nDet är frivilligt för region att erbjuda denna möjlighet. Om möjligheten erbjuds behöver regionens listningssystem även stödja tjänstekontraktet GetAvailableHealthcarePersonnel som producent.\n\nTRUE = mottagningen erbjuder fast läkarkontakt.\n\nUtelämnas eller sätts till FALSE om mottagningen inte erbjuder fast läkarkontakt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcareFacility.supportsHealthcarePersonnel` (`boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "getlisting.listings.healthcareFacility.queueLength" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.healthcareFacility.queueLength" ] ;
       fhir:ElementDefinition.short [ fhir:value "queueLength" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nytt fält fr o m v2.1.\n\nOm mottagningen erbjuder kö kan mottagningen redovisa hur många invånare som för tillfället står i listningskö till mottagningen. Fältet är frivilligt.\n\nObservera:\n\nDetta fält ingår i datatypen HealthcareFacilityType som återanvänds även i tjänstekontraktet GetAvailableHealthcareFacilities. I kontextet då en konsument hämtar listningsinformation om en invånare (GetListing) är det inte lika relevant för listningssystemet att förmedla detta värde, då invånaren redan är listad på mottagningen eller står i listningskö till mottagningen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcareFacility.queueLength` (`integer`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "integer" ]
       ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "getlisting.listings.healthcareFacility.estimatedWaitInQueue" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.healthcareFacility.estimatedWaitInQueue" ] ;
       fhir:ElementDefinition.short [ fhir:value "estimatedWaitInQueue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nytt fält fr o m v2.1.\n\nOm mottagningen erbjuder kö kan mottagningen redovisa hur lång väntetid som invånare kan förvänta sig. Fältet är frivilligt.\n\nObservera:\n\nDetta fält ingår i datatypen HealthcareFacilityType som återanvänds även i tjänstekontraktet GetAvailableHealthcareFacilities. I kontextet då en konsument hämtar listningsinformation om en invånare (GetListing) är det inte lika relevant för listningssystemet att förmedla detta värde, då invånaren redan är listad på mottagningen eller står i listningskö till mottagningen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcareFacility.estimatedWaitInQueue` (`integer`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "integer" ]
       ]
     ], [
       fhir:index 13 ;
       fhir:Element.id [ fhir:value "getlisting.listings.healthcarePersonnel" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.healthcarePersonnel" ] ;
       fhir:ElementDefinition.short [ fhir:value "HealthcarePersonnelType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vårdpersonal som är kopplade till listningen. Det är frivilligt för mottagning att erbjuda invånare möjlighet att dessutom välja vårdpersonal i samband med listningen. Om regionen erbjuder denna möjlighet ska regionen även vara producent för tjänstekontraktet GetAvailableHealthcarePersonnel. Det är Regionen kan därefter välja att erbjuda denna funktionalitet per mottagning, genom flaggan supportsHealthcarePersonnel (i typen HealthCareFacilityType).\n\nObservera att en producent tillåts förmedla fast läkarkontakt genom att populera detta fält även om producent inte erbjuder invånaren möjlighet att digitalt välja fast läkarkontakt.\n\nEn konsument ska visa den förmedlade fasta läkarkontakten till invånaren, även om producent inte stödjer det frivilliga tjänstekontraktet GetAvailableHealthcarePersonnel." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcarePersonnel` (kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 14 ;
       fhir:Element.id [ fhir:value "getlisting.listings.healthcarePersonnel.id" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.healthcarePersonnel.id" ] ;
       fhir:ElementDefinition.short [ fhir:value "id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "HsaId för vårdpersonal" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcarePersonnel.id` (`HSAIdType / (string)`, kardinalitet 1..1)." ] ;
