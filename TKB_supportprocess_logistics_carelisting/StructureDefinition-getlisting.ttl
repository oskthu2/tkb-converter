       fhir:ElementDefinition.path [ fhir:value "getlisting.listings.healthcarePersonnel.name" ] ;
       fhir:ElementDefinition.short [ fhir:value "name" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Namn (för- och efternamn) för vårdpersonal" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings.healthcarePersonnel.name` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
