       fhir:ElementDefinition.short [ fhir:value "ListingHealthcareFacilityType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Lista med listningsdetaljer för mottagningar som invånare är listad på. Om en region erbjuder sina invånare att kunna lista sig på mer än en listningstyp kan denna lista innehålla mer än en instans med listningsdetaljer (kopplade till en mottagning)." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `listings` (`ListingHealthcareFacilityType`, kardinalitet 0..*)." ] ;
