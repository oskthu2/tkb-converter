       fhir:ElementDefinition.short [ fhir:value "isInQueue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Flagga för att visa om invånare står i kö för att lista sig på mottagningen eller om invånare har en aktiv listning.\n\nTRUE = Invånare står i kö\n\nFALSE = Invånare har en aktiv listning på mottagningen" ] ;
