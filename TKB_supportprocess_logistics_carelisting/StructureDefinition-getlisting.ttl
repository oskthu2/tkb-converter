       fhir:ElementDefinition.definition [ fhir:value "HSAId för mottagningen\n\nEn tjänstekonsument bör kunna hantera HSAId:n som uttrycks både med versaler och gemener.\n\nExempelvis är:\n\n”se12345-xyz” = ”SE12345-XYZ”" ] ;
