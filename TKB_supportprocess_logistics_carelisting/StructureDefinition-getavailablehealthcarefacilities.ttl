       fhir:ElementDefinition.path [ fhir:value "getavailablehealthcarefacilities.healthcareFacilities.queueLength" ] ;
       fhir:ElementDefinition.short [ fhir:value "queueLength" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nytt attribut fr o m version 2.1.\n\nOm mottagningens maxtak på antalet listade invånare har uppnåtts kan mottagningen meddela hur lång kön är just nu." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `healthcareFacilities.queueLength` (`integer`, kardinalitet 0..1)." ] ;
