       fhir:ElementDefinition.short [ fhir:value "eRecept" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Flagga som anger om expeditionsstället är ett apotek som kan hantera e-recept för besökande privat personer. Om eRecept är satt så är termerna kortNamn och recepturtelefon obligatoriska." ] ;
