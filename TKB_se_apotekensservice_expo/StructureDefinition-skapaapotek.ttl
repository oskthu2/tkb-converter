       fhir:ElementDefinition.short [ fhir:value "exportId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Obligatorisk för identitet med glnKod. Måste vara true om eRecept och/eller eReceptDjur är true. ExportId får ej sättas till true för en butikskod (används bara för GLN)." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../exportId` (`boolean`, kardinalitet 0..1)." ] ;
