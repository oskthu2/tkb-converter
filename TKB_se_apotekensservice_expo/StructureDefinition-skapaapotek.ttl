       fhir:ElementDefinition.short [ fhir:value "Expeditionsställets GLN-kod Måste sättas på en av identiteterna. Endast en glnkod per expeditionsställe är tillåtet." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Expeditionsställets GLN-kod Måste sättas på en av identiteterna. Endast en glnkod per expeditionsställe är tillåtet." ] ;
