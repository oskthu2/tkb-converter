       fhir:index 6 ;
       fhir:Element.id [ fhir:value "skapaapotek.faxnummer" ] ;
       fhir:ElementDefinition.path [ fhir:value "skapaapotek.faxnummer" ] ;
       fhir:ElementDefinition.short [ fhir:value "Expeditionsställets faxnummer. Obligatoriskt om huvudorganisationskod = DX eller om Organisationskod = DOS" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Expeditionsställets faxnummer. Obligatoriskt om huvudorganisationskod = DX eller om Organisationskod = DOS" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `faxnummer` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
