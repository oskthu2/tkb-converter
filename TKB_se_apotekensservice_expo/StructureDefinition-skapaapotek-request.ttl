       fhir:ElementDefinition.path [ fhir:value "skapaapotek-request.eReceptDjur" ] ;
       fhir:ElementDefinition.short [ fhir:value "eReceptDjur" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Markering om apoteket kan expediera elektroniska djurrecept eller ej. Om eReceptDjur är satt så är termerna kortNamn och recepturtelefon obligatoriska." ] ;
