       fhir:ElementDefinition.short [ fhir:value "faxnummer" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Expeditionsställets faxnummer. Obligatoriskt om huvudorganisationskod = DX eller om Organisationskod = DOS" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
