  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getseals" ] ;
       fhir:ElementDefinition.path [ fhir:value "getseals" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetSeals — Response" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för svaret i GetSeals\n(urn:riv:informationsecurity:authorization:pip:GetSealsResponder:1, GetSealsResponseType)." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getseals.seal" ] ;
       fhir:ElementDefinition.path [ fhir:value "getseals.seal" ] ;
       fhir:ElementDefinition.short [ fhir:value "SealType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "En försegling beskriver vårdgivarens beslut om att begränsa den enskildes åtkomst till sin egen information. Försegling handlar inte om att informationen kan vara till men i medicinskt hänseende för den enskilde, utan om att informationen inte ska vara tillgänglig via självbetjäning på grund av att den enskilde befinner sig i vanmaktssituation. Vårdgivaren kan även använda försegling för att stänga ute vårdnadshavares digitala åtkomst till barns (under 13 år) journaluppgifter. I praktiken förseglas barnets konto, vilket resulterar i att vårdnadshavarna inte kan se barnets information i tjänster som erbjuder vårdnadshavare åtkomst till vårdnadstagarens journaluppgifter. En försegling kan ha olika verksamhetsmässig omfattning, vilket representeras av respektive komposit element." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `seal` (`SealType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "getseals-seal-updated-after-created" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "ÖR5: timeLastUpdated får inte vara äldre än timeCreated." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "timeLastUpdated.toDecimal() >= timeCreated.toDecimal()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.inera.se/ig/informationsecurity-authorization-pip/StructureDefinition/getseals" ;
           fhir:link <https://fhir.inera.se/ig/informationsecurity-authorization-pip/StructureDefinition/getseals>
         ]
       ], [
         fhir:index 1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "getseals-seal-valid-period" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "ÖR4: validTo får inte vara äldre än validFrom." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "(validFrom.exists() and validTo.exists()) implies validTo.toDecimal() >= validFrom.toDecimal()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.inera.se/ig/informationsecurity-authorization-pip/StructureDefinition/getseals" ;
           fhir:link <https://fhir.inera.se/ig/informationsecurity-authorization-pip/StructureDefinition/getseals>
         ]
       ], [
         fhir:index 2 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "getseals-seal-one-scope" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "ÖR1–ÖR3: exakt en av fullSeal, careProviderSeal och orgUnitSeal ska anges i en försegling." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "fullSeal.count() + careProviderSeal.count() + orgUnitSeal.count() = 1" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.inera.se/ig/informationsecurity-authorization-pip/StructureDefinition/getseals" ;
           fhir:link <https://fhir.inera.se/ig/informationsecurity-authorization-pip/StructureDefinition/getseals>
         ]
       ]
     ], [
