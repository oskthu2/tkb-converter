       fhir:ElementDefinition.short [ fhir:value "Källsystem (HSA-id)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "HSA-id för källsystemet som innehåller den information som EI-posten pekar ut.\nI regel det vårdsystem som skapade informationen eller det system hos vårdgivaren\nsom är master för informationen.\nSystem: urn:oid:1.2.752.129.2.1.4.1 (HSA-id OID).\nKardinalitet: Obligatorisk." ] ;
