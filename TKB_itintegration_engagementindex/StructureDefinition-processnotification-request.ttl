  fhir:StructureDefinition.url [ fhir:value "https://fhir.inera.se/ig/itintegration-engagementindex/StructureDefinition/processnotification-request"] ;
  fhir:StructureDefinition.version [ fhir:value "1.0.9"] ;
  fhir:StructureDefinition.name [ fhir:value "ProcessNotificationRequest"] ;
  fhir:StructureDefinition.title [ fhir:value "ProcessNotification — Request"] ;
  fhir:StructureDefinition.status [ fhir:value "draft"] ;
  fhir:StructureDefinition.date [ fhir:value "2026-09-09T17:04:05+00:00"^^xsd:dateTime] ;
  fhir:StructureDefinition.contact [
