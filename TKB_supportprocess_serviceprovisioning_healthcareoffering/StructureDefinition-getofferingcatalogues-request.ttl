       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getofferingcatalogues-request.providingOrganization.publicProvider" ] ;
       fhir:ElementDefinition.path [ fhir:value "getofferingcatalogues-request.providingOrganization.publicProvider" ] ;
       fhir:ElementDefinition.short [ fhir:value "publicProvider" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Offentlig huvudman\n\nOm satt till ’true’ filtreras sökresultatet så att endast poster returneras där katalogansvarig organisation är en offentlig huvudman." ] ;
