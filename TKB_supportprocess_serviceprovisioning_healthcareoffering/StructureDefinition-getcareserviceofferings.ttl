       ]
     ], [
       fhir:index 13 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.description.text" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.description.text" ] ;
       fhir:ElementDefinition.short [ fhir:value "text" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Text\n\nDen textuella beskrivningen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../text` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 14 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.description.language" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.description.language" ] ;
       fhir:ElementDefinition.short [ fhir:value "language" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Språk\n\nAnger kod för det språk beskrivningen är skriven på.\n\nOm fältet inte används antas beskrivningen avse svenska.\n\nAnvänds för att returnera ett svar baserat på aktörens språk. Språk anges enligt ISO 639-3:2007 ”Codes for the representation of names of languages -- Part 3: Alpha-3 code for comprehensive coverage of languages”.\n\nExempel på code:\n\nswe (svenska)\n\neng (engelska)\n\ndeu (tyska)\n\nlanguage.code: swe\n\nlanguage.displayname: Swedish\n\nlanguage.codesystem: 1.0.639.3" ] ;
