       fhir:ElementDefinition.short [ fhir:value "purpose" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Syfte\n\nAngivelse av syftet med kontaktuppgiften.\n\nExempelvis avbokning, ombokning, receptförnyelse." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../purpose` (`String`, kardinalitet 0..1)." ] ;
