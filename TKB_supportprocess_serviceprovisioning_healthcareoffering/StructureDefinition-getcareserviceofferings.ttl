       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.availableTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "availableTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kalendertid\n\nDen tid som kontaktuppgiften är tillgänglig.\n\nDet kan vara möjligt att ringa mån – fre 08.00-17.00 på ett telefonnummer.\n\nSe avsnitt 5.2.2 för beskrivning av format." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../availableTime` (`CalendarType`, kardinalitet 0..*)." ] ;
