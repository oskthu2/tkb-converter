       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.location.description" ] ;
       fhir:ElementDefinition.short [ fhir:value "DescriptionType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Beskrivning av platsen (län, kommun, fysisk eller virtuell plats).\n\nOm beskrivning anges ska den åtminstone finnas på svenska och vara anpassad för invånare.\n\nDet får endast finnas en beskrivning med samma kombination av språk och roll." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../description*` (`DescriptionType`, kardinalitet 0..*)." ] ;
