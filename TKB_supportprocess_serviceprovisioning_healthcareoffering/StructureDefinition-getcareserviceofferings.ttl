       fhir:ElementDefinition.short [ fhir:value "IndicatorType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Indikator\n\nIndikator håller referenser till mätningar från SKRs (Sveriges kommuner och regioner) öppna jämförelser som kan kopplas till en viss vård- och omsorgstjänst. Kan exempelvis vara väntetid eller kvalitetsindikator kopplat till den specifika vård- och omsorgstjänsten." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../indicator` (`IndicatorType`, kardinalitet 0..*)." ] ;
