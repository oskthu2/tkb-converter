     ], [
       fhir:index 110 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.interferenceInformation.description" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.interferenceInformation.description" ] ;
       fhir:ElementDefinition.short [ fhir:value "DescriptionType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Beskrivning\n\nYtterligare information om avvikelser.\n\nDet ska åtminstone finnas beskrivning på svenska och vara anpassad för invånare.\n\nDet får endast finnas en beskrivning med samma kombination av språk och roll." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../description*` (`DescriptionType`, kardinalitet 1..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 111 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.interferenceInformation.description.text" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.interferenceInformation.description.text" ] ;
       fhir:ElementDefinition.short [ fhir:value "text" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Text\n\nDen textuella beskrivningen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../text` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 112 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.interferenceInformation.description.language" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.interferenceInformation.description.language" ] ;
       fhir:ElementDefinition.short [ fhir:value "language" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Språk\n\nAnger kod för det språk beskrivningen är skriven på. Om fältet inte används antas beskrivningen avse svenska.\n\nSpråk anges enligt ISO 639-3:2007 ”Codes for the representation of names of languages -- Part 3: Alpha-3 code for\n\ncomprehensive coverage of languages”.\n\nExempel på code:\n\nswe (svenska)\n\neng (engelska)\n\ndeu (tyska)\n\nlanguage.code: swe\n\nlanguage.displayname: Swedish\n\nlanguage.codesystem: 1.0.639.3" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../language*` (`CVType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 113 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.interferenceInformation.description.role" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.interferenceInformation.description.role" ] ;
       fhir:ElementDefinition.short [ fhir:value "role" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Roll\n\nAnger vilken målgrupp beskrivningen riktas till. Kan vara till invånare, personal inom socialtjänsten  eller hälso- och sjukvårdspersonal.\n\nOm beskrivning anges, ska minst en beskrivning för invånare anges.\n\nUrval ur Snomed CT:\n\nrole.code: 223366009\n\nrole.displayname: hälso- och sjukvårdspersonal\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.code: 257513009\n\nrole.displayname: enskild person\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.code: 224611006\n\nrole.displayname: personal inom socialtjänsten\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.displayName returnerar endast text på svenska även om annat språk är angivet i begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../role*` (`CVType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
