       fhir:ElementDefinition.short [ fhir:value "publicProvider" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Offentlig huvudman\n\nAnger om den katalogansvariga organisationen är offentlig huvudman.\n\nTrue=offentlig huvudman" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../publicProvider` (`Boolean`, kardinalitet 1..1)." ] ;
