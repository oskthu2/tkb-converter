     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.typeOfCareServiceDescription.role" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.typeOfCareServiceDescription.role" ] ;
       fhir:ElementDefinition.short [ fhir:value "role" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Roll\n\nAnger vilken målgrupp beskrivningen riktas till. Kan vara till invånare, personal inom socialtjänsten eller hälso- och sjukvårdspersonal.\n\nOm roll inte anges, riktas beskrivningen till samtliga roller.\n\nUrval ur Snomed CT:\n\nrole.code: 223366009\n\nrole.displayname: hälso- och sjukvårdspersonal\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.code: 257513009\n\nrole.displayname: enskild person\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.code: 224611006\n\nrole.displayname: personal inom socialtjänsten\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.displayName returnerar endast text på svenska även om annat språk är angivet i begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../role*` (`CVType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.validity" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.validity" ] ;
       fhir:ElementDefinition.short [ fhir:value "validity" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Giltighet\n\nGiltighetstiden för vård- och omsorgstjänsten.\n\nExempelvis höftledsoperation som utförs av den organisatoriska enheten x på platsen y erbjuds under perioden 20160101-20171231.\n\nMinst ett av periodens start och end i DatePeriodType ska anges." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../validity*` (`DatePeriodType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/DatePeriodType" ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.careServiceStatus" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.careServiceStatus" ] ;
       fhir:ElementDefinition.short [ fhir:value "careServiceStatus" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Status\n\nStatus för vård- och omsorgstjänsten.\n\nEn av följande:\n\nINACTIVE = innan vård- och omsorgstjänsten är färdig att erbjudas.\n\nACTIVE = vård- och omsorgstjänsten är färdigbeskriven och kan erbjudas.\n\nDEPRECATED = vård- och omsorgstjänsten ska ej längre erbjudas" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../careServiceStatus` (`CareServiceStatusEnum`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "code" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/ValueSet/healthcareoffering-careservicestatus-vs" ;
           fhir:link <https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/ValueSet/healthcareoffering-careservicestatus-vs>
         ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.careOption" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.careOption" ] ;
       fhir:ElementDefinition.short [ fhir:value "careOption" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vårdval\n\nSätts till true om vård- och omsorgstjänsten ingår i valfrihetssystem." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../careOption` (`boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.referralRequired" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.referralRequired" ] ;
       fhir:ElementDefinition.short [ fhir:value "referralRequired" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remisskrav\n\nAnger om det finns krav på remiss för att uppsöka/ta del av vård- och omsorgstjänsten.\n\nFör hälso- och sjukvården: Observera att den information som anges här är det eventuella krav på remiss från den organisation/region som ansvarar för att tillhandahålla vård- och omsorgstjänsten. Om remisskrav INTE finns för vård- och omsorgstjänsten, kan det ändå finnas krav från patientens hemregion för denna typ av vård- och omsorgstjänst. Om så är fallet behöver patienten en remiss från hemregionen för att utförare av den erbjudna vård- och omsorgstjänsten ska få ersättning från hemregionen.\n\nReglerna för detta beskrivs i \"Riksavtalet för utomlänsvård från och med 1 januari 2015\" [R7] sidan 17 under rubriken \"Hemlandstingets remissregler tillämpas också i andra landsting\" och \"Vårdlandstingets remissregler tillämpas också för utomlänspatienter\"." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../referralRequired` (`boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.description" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.description" ] ;
       fhir:ElementDefinition.short [ fhir:value "DescriptionType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Beskrivning av vård- och omsorgstjänsten som är ett lokalt tillägg till den nationellt överenskomna. Detta kan exempelvis i text detaljera hur en viss aktivitet utförs eller om det finns några tillägg till det nationellt överenskomna innehållet i en vård- och omsorgstjänst.\n\nOm beskrivning anges ska den åtminstone finnas på svenska och vara anpassad för invånare.\n\nDet får endast finnas en beskrivning med samma kombination av språk och roll." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../description*` (`DescriptionType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
