       fhir:ElementDefinition.short [ fhir:value "DescriptionType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Beskrivning av den katalogansvariga organisationen. Om beskrivning anges ska den åtminstone finnas på svenska och vara anpassad för invånare.\n\nDet får endast finnas en beskrivning med samma kombination av språk och roll." ] ;
