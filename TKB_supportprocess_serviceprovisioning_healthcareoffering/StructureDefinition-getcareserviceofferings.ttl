       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.description" ] ;
       fhir:ElementDefinition.short [ fhir:value "DescriptionType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Beskrivning\n\nYtterligare information om kontaktuppgiften.\n\nOm beskrivning anges ska den åtminstone finnas på svenska och vara anpassad för invånare.\n\nDet får endast finnas en beskrivning med samma kombination av språk och roll." ] ;
