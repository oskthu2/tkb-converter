       fhir:ElementDefinition.short [ fhir:value "id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Enhets-id\n\nEtt enhets-id på den utförande enheten ska returneras.\n\nId på organisatoriska enheten kan vara HSA-id.\n\nExempelvis HSA-id, organisationsnummer\n\neller lokala id:n.\n\nOm HSA-id (exempel):\n\nid.root =1.2.752.129.2.1.4.1\n\nid.extension = SE2321000115-094882" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../id` (`IIType`, kardinalitet 1..*)." ] ;
