       fhir:ElementDefinition.short [ fhir:value "RequestTemplateType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remissanvisning\n\nOm vårdtjänsten har en fastställd remissanvisning som kan användas vid remittering, anges den adress som remissanvisningen kan hämtas ifrån. Remissanvisningen är ett stöd för att säkerställa att nödvändig information bifogas en remiss." ] ;
