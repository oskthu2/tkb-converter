  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetCareServiceOfferings — Response" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för svaret i GetCareServiceOfferings\n(urn:riv:supportprocess:serviceprovisioning:healthcareoffering:GetCareServiceOfferingsResponder:3, GetCareServiceOfferingsResponseType)." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService" ] ;
       fhir:ElementDefinition.short [ fhir:value "CareServiceType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vård- och omsorgstjänst\n\nDen tjänst som erbjuds av en organisatorisk enhet för att tillgodose behov av hälso- och sjukvård eller socialtjänst hos invånare." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careService` (`CareServiceType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.careServiceId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.careServiceId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careServiceId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vård- och omsorgstjänstens id\n\nInnehåller vård- och omsorgstjänstens unika identifierare.\n\nOm HSA-id används:\n\ncareServiceId.root: 1.2.752.129.2.1.4.1\n\ncareServiceId.extension: `<hsa-id>`\n\nOm ej HSA-id:\n\ncareServiceId.root: `<UUID>`\n\ncareServiceId.extension: Anges ej" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../careServiceId` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.typeOfCareService" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.typeOfCareService" ] ;
       fhir:ElementDefinition.short [ fhir:value "typeOfCareService" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Typ av vård- och omsorgstjänst.\n\nDen specifika vård- och omsorgstjänsten som erbjuds.\n\nExempel inom hälso- och sjukvård:\n\n- insättning av totalprotes i höftled\n\n- rehabiliteringsmedicinsk konsultation\n\nExempel inom socialtjänsten:\n\n- hjälp med inköp\n\n- tillredning av måltider m.m.\n\nDå Snomed CT används:\n\ntypeOfCareService.codesystem: 1.2.752.116.2.1.1\n\n/ I första hand ska koder från det nationella utbudkodsurvalet användas men Snomed CT-koder från lokalt urval kan förekomma.\n\n/ Då verksamhetskod används: typeOfCareService.codesystem: 1.2.752.129.2.2.1.3\n\nKod väljs från HSA verksamhetskodverk.\n\nDå en verksamhetskod används ska konsumenten logiskt lägga till prefixet ”Vårdtjänster inom verksamhetsområdet …” till klartexten för verksamhetskoden.\n\ntypeOfCareService.displayName returnerar endast text på svenska även om annat språk är angivet i begäran.\n\nFramtagande av nationellt kodverk pågår." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../typeOfCareService` (`CVType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.typeOfCareServiceDescription" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.typeOfCareServiceDescription" ] ;
       fhir:ElementDefinition.short [ fhir:value "DescriptionType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Nationellt överenskommen beskrivning av vård- och omsorgstjänsten.\n\nOm beskrivning anges ska den åtminstone finnas på svenska och vara anpassad för invånare.\n\nDet får endast finnas en beskrivning med samma kombination av språk och roll." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../typeOfCareServicedescription*` (`DescriptionType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
