       fhir:ElementDefinition.short [ fhir:value "address" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Adress till remissanvisning\n\nAdress som anger var en remissanvisning finns. Kan vara en URL." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../address` (`anyURI`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
