       fhir:ElementDefinition.short [ fhir:value "cooperation" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Samverkan\n\nHåller information om vilken organisatorisk enhet som samverkar med annan organisatorisk enhet kring en vård- och omsorgstjänst och vad samverkan avser.\n\nEtt exempel på samverkan är när två organisatoriska enheter samverkar kring öppettider avseende en viss typ av vård- ocn omsorgstjänst så att en patient kan hänvisas rätt utanför normala öppettider, exempelvis från vårdcentral till närakut." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../cooperation` (`CooperationType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
