       fhir:ElementDefinition.short [ fhir:value "descriptionText" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Text\n\nDen textuella beskrivningen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../text` (`string`, kardinalitet 1..1).\n\n**Modellanteckning:** descriptionText Heter text i schemat." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
