     ], [
       fhir:index 76 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.location.description.language" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.location.description.language" ] ;
       fhir:ElementDefinition.short [ fhir:value "language" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Språk\n\nAnger kod för det språk beskrivningen är skriven på. Om fältet inte används antas beskrivningen avse svenska.\n\nSpråk anges enligt ISO 639-3:2007 ”Codes for the representation of names of languages -- Part 3: Alpha-3 code for\n\ncomprehensive coverage of languages”.\n\nExempel på code:\n\nswe (svenska)\n\neng (engelska)\n\ndeu (tyska)\n\nlanguage.code: swe\n\nlanguage.displayname: Swedish\n\nlanguage.codesystem: 1.0.639.3" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../language*` (`CVType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 77 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.location.description.role" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.location.description.role" ] ;
       fhir:ElementDefinition.short [ fhir:value "role" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Roll\n\nAnger vilken målgrupp beskrivningen riktas till. Kan vara till invånare (enskild person) eller hälso- och sjukvårdspersonal.\n\nrole.code: 223366009\n\nrole.displayname: hälso- och sjukvårdspersonal\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.code: 257513009\n\nrole.displayname: enskild person\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.code: 224611006\n\nrole.displayname: personal inom socialtjänsten\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.displayName returnerar endast text på svenska även om annat språk är angivet i begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../role*` (`CVType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 78 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.contactInformation" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation" ] ;
       fhir:ElementDefinition.short [ fhir:value "ContactInformationType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kontaktuppgift till den organisatoriska enhet som erbjuder en viss vård- och omsorgstjänst." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../contactInformation` (`ContactInformationType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 79 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.contactInformation.ranking" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.ranking" ] ;
       fhir:ElementDefinition.short [ fhir:value "ranking" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Rangordning för kontaktuppgifterna. Om det finns flera kontaktuppgifter används rangordning för att visa vilken som föredras framför en annan.\n\nAnges med siffror där 1 innebär högst rangordning osv.\n\nExempelvis om en e-postadress ska användas i första hand och ett telefonnummer ska användas i andra hand, används rangordning 1 för e-postadressen och rangordning 2 för telefonnumret." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../ranking` (`integer`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "integer" ]
       ]
     ], [
       fhir:index 80 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.contactInformation.forRole" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.forRole" ] ;
       fhir:ElementDefinition.short [ fhir:value "forRole" ] ;
       fhir:ElementDefinition.definition [ fhir:value "För roll\n\nAttributet anger om kontaktuppgiften avser en viss roll.\n\nEn roll kan vara en invånare (enskild person), personal inom socialtjänst eller hälso- och sjukvårdspersonal.\n\nEtt telefonnummer som finns registrerat för en vård- och omsorgstjänst ska i vissa fall endast användas för invånare och ett annat telefonnummer, avseende samma vård- och omsorgstjänst, ska användas av hälso- och sjukvårdspersonal.\n\nrole.code: 223366009\n\nrole.displayname: hälso- och sjukvårdspersonal\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.code: 257513009\n\nrole.displayname: enskild person\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.code: 224611006\n\nrole.displayname: personal inom socialtjänsten\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.displayName returnerar endast text på svenska även om annat språk är angivet i begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../forRole` (`CVType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 81 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.contactInformation.purpose" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.purpose" ] ;
       fhir:ElementDefinition.short [ fhir:value "purpose" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Syfte\n\nAngivelse av syftet med kontaktuppgiften.\n\nExempelvis avbokning, ombokning, receptförnyelse." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../purpose` (`String`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 82 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.contactInformation.address" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.address" ] ;
       fhir:ElementDefinition.short [ fhir:value "address" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Postadress\n\nDen adress som kan användas för att kontakta en organisatorisk enhet gällande en vård- och omsorgstjänst. Kan exempelvis vara adress dit en pappersremiss ska skickas.\n\nObservera att detta ej är besöksadress (återfinns i Fysisk plats).\n\nAdress är obligatoriskt om det är möjligt att remittera till vård- och omsorgstjänsten." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../address` (`Address`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 83 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.contactInformation.availableTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.availableTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "availableTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kalendertid\n\nDen tid som kontaktuppgiften är tillgänglig.\n\nDet kan vara möjligt att ringa mån – fre 08.00-17.00 på ett telefonnummer.\n\nSe avsnitt 5.2.2 för beskrivning av format." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../availableTime` (`CalendarType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 84 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.contactInformation.telecom" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.telecom" ] ;
       fhir:ElementDefinition.short [ fhir:value "TelecomType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Adress för telekommunikation\n\nInnehåller den elektroniska adressinformation som ska användas för att kontakta en organisatorisk enhet gällande en viss vård- och omsorgstjänst." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../telecom` (`TelecomType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 85 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.contactInformation.telecom.typeOfTelecom" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.telecom.typeOfTelecom" ] ;
       fhir:ElementDefinition.short [ fhir:value "typeOfTelecom" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Typ av medium\n\nVilken typ av medium för telekommunikation som avses.\n\nAnges med kod från kodverket Kv tele ekom typ (OID: 1.2.752.129.2.2.1.30) [R14].\n\nObservera att kodverk kan komma att kompletteras över tid vilket medför att nyttjare av tjänstekontraktet behöver vara förberedda på att nya koder kan tillkomma utan att versionen på tjänstekontraktet uppdateras.\n\ntypeOfTelecom.displayName returnerar endast text på svenska även om annat språk är angivet i begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../typeOfTelecom` (`CVType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 86 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings.careService.contactInformation.telecom.contactPoint" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings.careService.contactInformation.telecom.contactPoint" ] ;
       fhir:ElementDefinition.short [ fhir:value "contactPoint" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Värde\n\nAngivelse av värde i klartext för typen av medium.\n\nExempelvis 070-707070 som telefonnummer, epost@epost.se som e-postadress etc." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../contactPoint*` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
