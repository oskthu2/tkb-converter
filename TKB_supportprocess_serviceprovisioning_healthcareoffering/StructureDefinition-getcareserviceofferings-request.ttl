       ]
     ], [
       fhir:index 14 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.targetGroupGender" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.targetGroupGender" ] ;
       fhir:ElementDefinition.short [ fhir:value "targetGroupGender" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kön\n\nFiltrerar sökresultatet så att endast poster med angivet kön returneras.\n\nKönet avser den person som söker hälso- och sjukvård eller socialtjänst.\n\nKodverk:\n\nKv_kon\n\n1=man\n\n2=kvinna\n\nKoden ”Övrig” ej tillåten i detta attribut.\n\nExempel\n\ntargetGroupGender.code: 1\n\ntargetGroupGender.codesystem: 1.2.752.129.2.2.1.1" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `targetGroupGender*` (`CVType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 15 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.targetGroupAttribute" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.targetGroupAttribute" ] ;
       fhir:ElementDefinition.short [ fhir:value "TargetGroupAttributeType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Egenskap\n\nFiltrerar sökresultatet så att endast poster med angiven egenskap returneras. Egenskap avser ytterligare information om den person som söker hälso- och sjukvård eller socialtjänst." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `,,/targetGroupAttribute` (`TargetGroupAttributeType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 16 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.targetGroupAttribute.typeOfPersonalAttribute" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.targetGroupAttribute.typeOfPersonalAttribute" ] ;
       fhir:ElementDefinition.short [ fhir:value "typeOfPersonalAttribute" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Typ av egenskap\n\nFiltrerar sökresultatet så att endast poster med angiven typ av egenskap returneras.\n\nExempel:\n\nGraviditetsvecka\n\nKod från Snomed CT hierarkin 363787002 | observerbar företeelse |" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../ typeOfPersonalAttribute*` (`CVType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
