     ], [
       fhir:index 67 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.location" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.location" ] ;
       fhir:ElementDefinition.short [ fhir:value "location" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Sökområde\n\nFiltrerar sökresultatet så att endast poster med angivet sökområde för vård- och omsorgstjänsten returneras.\n\nSökområdet kan vara ett geografiskt område, län eller kommun.\n\nI de fall flera sökområden anges ska samtliga vård- och omsorgstjänster med något av de angivna sökområdena returneras." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `location` (`SearchLocationType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
