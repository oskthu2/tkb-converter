       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.targetGroupGender" ] ;
       fhir:ElementDefinition.short [ fhir:value "targetGroupGender" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kön\n\nFiltrerar sökresultatet så att endast poster med angivet kön returneras.\n\nKönet avser den person som söker hälso- och sjukvård eller socialtjänst.\n\nKodverk:\n\nKv_kon\n\n1=man\n\n2=kvinna\n\nKoden ”Övrig” ej tillåten i detta attribut.\n\nExempel\n\ntargetGroupGender.code: 1\n\ntargetGroupGender.codesystem: 1.2.752.129.2.2.1.1" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `targetGroupGender*` (`CVType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
