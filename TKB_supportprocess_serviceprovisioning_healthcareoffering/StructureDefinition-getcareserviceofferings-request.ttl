       fhir:ElementDefinition.short [ fhir:value "typeOfBusiness" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Typ av verksamhet\n\nFiltrerar sökresultatet så att endast poster med angiven typ av verksamhet returneras.\n\nOm HSA verksamhetskod\n\ntypeOfBusiness.codeSystem:\n\n1.2.752.129.2.2.1.3" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `typeOfBusiness*` (`CVType`, kardinalitet 0..*)." ] ;
