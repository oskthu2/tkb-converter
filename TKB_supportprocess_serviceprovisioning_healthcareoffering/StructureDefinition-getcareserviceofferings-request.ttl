       fhir:ElementDefinition.short [ fhir:value "typeOfPlace" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Typ av plats\n\nFiltrerar sökresultatet så att endast poster med angiven typ av plats som vård-och omsorgstjänsten erbjuds på returneras.\n\nEn av följande:\n\nPHYSICAL – endast fysisk plats\n\nVIRTUAL – endast virtuell plats\n\nALL - både fysisk och virtuell plats" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `typeOfPlace` (`TypeOfPlaceType`, kardinalitet 1..1)." ] ;
