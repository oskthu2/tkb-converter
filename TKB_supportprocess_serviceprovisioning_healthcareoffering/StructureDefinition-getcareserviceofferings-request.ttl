       fhir:ElementDefinition.short [ fhir:value "SearchProvidingOrganizationType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Katalogansvarig organisation" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `providingOrganization` (`searchProvidingOrganizationType`, kardinalitet 0..1)." ] ;
