       fhir:Element.id [ fhir:value "getcareserviceofferings-request.location.county" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.location.county" ] ;
       fhir:ElementDefinition.short [ fhir:value "county" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Länskod\n\nFiltrerar sökresultatet så att endast poster med angivet län returneras. Länskod enligt SCB:s lista över län och ekomer, se referens R13.  Tvåställig kod.\n\nExempel:\n\ncounty.code = 05\n\ncounty.codeSystem = 1.2.752.129.2.2.1.18\n\ncounty.displayName = Östergötlands län" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../county*` (`CVType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getcareserviceofferings-request.location.county" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 25 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.location.municipality" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.location.municipality" ] ;
       fhir:ElementDefinition.short [ fhir:value "municipality" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kommunkod\n\nSökning på kommun. Kommunkod enligt SCB’s lista över län och kommuner, se referens R13. Fyrställig kod.\n\nExempel:\n\nmunicipality.code = 0126\n\nmunicipality.codeSystem = 1.2.752.129.2.2.1.17\n\nmunicipality.displayName = Huddinge" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../municipality*` (`CVType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getcareserviceofferings-request.location.municipality" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 26 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.searchTerm" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.searchTerm" ] ;
       fhir:ElementDefinition.short [ fhir:value "searchTerm" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Fritextsökning för att filtrera på vård- och omsorgstjänst baserat på text i nedan listade fritextfält.\n\nFör de beskrivande texter nedan som förekommer i flera språk ska sökningen ske i texten som motsvarar det språk som anges i actorLanguage.\n\nAnges inte actorLanguage ska texter för samtliga språk användas i sökningen.\n\nSökningen ska innehålla minst 3 tecken. Vård- och omsorgstjänst där sökbegreppet överensstämmer med del av text i nedanstående fält ska returneras.\n\nI det fall fler sökbegrepp skickas med i begäran ska samtliga sökbegrepp återfinnas i något av nedanstående fält för att vård- och omsorgstjänsten ska returneras.\n\nFritextsökning ska ske i fälten:\n\ncareService.description.text\n\ncareService.typeOfCareService.displayName\n\ncareService.providingOrganization. Name\n\ncareService.providingOrganization.description\n\ncareService.performingOrganization.name\n\ncareService.performingOrganization.description.text\n\ncareService.performingOrganization.responibleOrganization.name\n\ncareService. performingOrganization.responibleOrganization.description.text\n\ncareService.location.geographicalLocation.municipality.displayName\n\ncareService.location.geographicalLocation.county.displayName" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `searchTerm` (`string`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getcareserviceofferings-request.searchTerm" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ]
  ] ;
  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetCareServiceOfferings — Request" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för begäran i GetCareServiceOfferings\n(urn:riv:supportprocess:serviceprovisioning:healthcareoffering:GetCareServiceOfferingsResponder:3, GetCareServiceOfferingsType), inklusive SOAP-huvuden enligt WSDL." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.careServiceId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.careServiceId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careServiceId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vård- och omsorgstjänstens id\n\nBegränsar sökningen så att endast poster med angivet id för vård- och omsorgstjänst returneras.\n\nOm HSA-id används:\n\ncareServiceId.root: 1.2.752.129.2.1.4.1\n\ncareServiceId.extension: `<hsa-id>`\n\nOm ej HSA-id:\n\ncareServiceId.root: `<UUID>`\n\ncareServiceId.extension: Anges ej" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careServiceId` (`IIType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.typeOfCareService" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.typeOfCareService" ] ;
       fhir:ElementDefinition.short [ fhir:value "typeOfCareService" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Typ av vård- och omsorgstjänst\n\nBegränsar sökningen så att endast poster med angiven typ av vård- och omsorgstjänst returneras.\n\nExempel:\n\nAllergologisk konsultation\n\nKognitiv beteendeterapi via internet\n\nDå Snomed CT används:\n\ntypeOfCareService.codesystem: 1.2.752.116.2.1.1\n\nI första hand ska koder från det nationella utbudkodsurvalet användas men Snomed CT-koder från lokalt urval kan förekomma.\n\nDå verksamhetskod används: typeOfCareService.codesystem: 1.2.752.129.2.2.1.3\n\nKod väljs från HSA verksamhetskodverk. Då en verksamhetskod används ska konsumenten logiskt lägga till prefixet ”Vårdtjänster inom verksamhetsområdet …” till klartexten för verksamhetskoden." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `typeOfCareService*` (`CVType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.typeOfPlace" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.typeOfPlace" ] ;
       fhir:ElementDefinition.short [ fhir:value "TypeOfPlaceType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Typ av plats\n\nFiltrerar sökresultatet så att endast poster med angiven typ av plats som vård-och omsorgstjänsten erbjuds på returneras.\n\nEn av följande:\n\nPHYSICAL – endast fysisk plats\n\nVIRTUAL – endast virtuell plats\n\nALL - både fysisk och virtuell plats" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `typeOfPlace` (`TypeOfPlaceType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.typeOfPlace.typeOfPlaceEnum" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.typeOfPlace.typeOfPlaceEnum" ] ;
       fhir:ElementDefinition.short [ fhir:value "typeOfPlaceEnum" ] ;
       fhir:ElementDefinition.definition [ fhir:value "typeOfPlaceEnum Tillåtna värden: ALL, PHYSICAL, VIRTUAL." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../typeOfPlaceEnum` (`TypeOfPlaceEnum`, kardinalitet 1..1).\n\n**Modellanteckning:** typeOfPlaceEnum Tillåtna värden: ALL, PHYSICAL, VIRTUAL." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
