       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.targetGroupAge" ] ;
       fhir:ElementDefinition.short [ fhir:value "targetGroupAge" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ålder\n\nFiltrerar sökresultatet så att endast poster med angiven ålder returneras.\n\nÅldern avser den person som söker hälso- och sjukvård eller socialtjänst." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `targetGroupAge` (`int`, kardinalitet 0..1)." ] ;
