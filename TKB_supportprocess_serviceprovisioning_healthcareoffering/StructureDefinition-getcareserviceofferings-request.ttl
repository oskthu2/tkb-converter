       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.targetGroupAttribute.attributeValue" ] ;
       fhir:ElementDefinition.short [ fhir:value "attributeValue" ] ;
       fhir:ElementDefinition.definition [ fhir:value "attributeValue" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../attributeValue` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 18 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.location" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.location" ] ;
       fhir:ElementDefinition.short [ fhir:value "SearchLocationType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Sökområde\n\nFiltrerar sökresultatet så att endast poster med angivet sökområde för vård- och omsorgstjänsten returneras.\n\nSökområdet kan vara ett geografiskt område, län eller kommun.\n\nI de fall flera sökområden anges ska samtliga vård- och omsorgstjänster med något av de angivna sökområdena returneras." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `location` (`SearchLocationType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 19 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.location.geographicalLocation" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.location.geographicalLocation" ] ;
       fhir:ElementDefinition.short [ fhir:value "SearchGeographicalLocationType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Geografiskt område\n\nFiltrerar sökresultatet så att endast poster med angivet geografiskt område returneras. Till geografiskt område hör geografiska koordinater och radie som bildar en area. Producenter behöver inte svara baserat på polygoner i Övrigt område (otherLocation).\n\nSvaret ska returnera vård- och omsorgstjänster med utförandeplats inom den arean." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../geographicalLocation` (`SearchGeographicalLocationType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 20 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.location.geographicalLocation.geographicalCoordinates" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.location.geographicalLocation.geographicalCoordinates" ] ;
       fhir:ElementDefinition.short [ fhir:value "GeoLocationType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Geografiska koordinater\n\nGeografisk lokalisering, dvs den punkt på en karta sökningen ska utgå ifrån." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../geographicalCoordinates` (`GeoLocationType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 21 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.location.geographicalLocation.geographicalCoordinates.north" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.location.geographicalLocation.geographicalCoordinates.north" ] ;
       fhir:ElementDefinition.short [ fhir:value "north" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Exempel\n\ngeoLocation.north = 5407869" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../north` (`long`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
