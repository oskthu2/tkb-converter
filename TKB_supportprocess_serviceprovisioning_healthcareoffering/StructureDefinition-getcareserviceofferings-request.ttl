     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.providingOrganization.providingOrganizationId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.providingOrganization.providingOrganizationId" ] ;
       fhir:ElementDefinition.short [ fhir:value "providingOrganizationId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id på katalogansvarig organisation\n\nFiltrerar sökresultatet så att endast poster med angivet id för katalogansvarig organisation returneras.\n\nFör Region, Kommun, Aktiebolag, Handelsbolag anges organisationsnummer (id.root: 1.3.7)\n\nFör Enskild firma anges personnummer (id.root: 1.2.752.129.2.1.3.1)" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../providingOrganizationId` (`IIType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.providingOrganization.management" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.providingOrganization.management" ] ;
       fhir:ElementDefinition.short [ fhir:value "management" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ägarform\n\nFiltrerar sökresultatet så att endast poster med angiven ägarform för den katalogansvariga organisationen returneras.\n\nAnges med kod från kodverket HSA ägarform (OID 1.2.752.129.2.2.1.14) [R14].\n\nObservera att kodverk kan komma att kompletteras över tid vilket medför att nyttjare av tjänstekontraktet behöver vara förberedda på att nya koder kan tillkomma utan att versionen på tjänstekontraktet uppdateras." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../management` (`CVType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.providingOrganization.publicProvider" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.providingOrganization.publicProvider" ] ;
       fhir:ElementDefinition.short [ fhir:value "publicProvider" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Offentlig huvudman\n\nFiltrerar sökresultatet så att endast poster där vård- och omsorgstjänst som erbjuds av en offentlig huvudman returneras om fältet sätts till true.\n\nOm fältet ej anges returneras vård- och omsorgstjänster som erbjuds av både offentlig och ej offentlig huvudman." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../publicProvider` (`Boolean`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.actorLanguage" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.actorLanguage" ] ;
       fhir:ElementDefinition.short [ fhir:value "actorLanguage" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Språk för aktör\n\nFiltrerar sökresultat så att poster med angivet språk returneras.\n\nSpråk anges enligt ISO 639-3:2007 ”Codes for the representation of names of languages -- Part 3: Alpha-3 code for\n\ncomprehensive coverage of languages”.\n\nEndast texter som finns beskrivna på det angivna språket ska returneras. Om det saknas text för angivet språk, returneras texter på svenska.\n\nDet är endast beskrivningar som ska returneras på olika språk, ej displayName för CV-typerna.\n\nOm språk ej anges, ska samtliga texter returneras.\n\nExempel på code:\n\nswe (svenska)\n\neng (engelska)\n\ndeu (tyska)\n\nactorLanguage.code: swe\n\nactorLanguage.displayName: Swedish\n\nactorLanguage.codeSystem: 1.0.639.3" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `actorLanguage*` (`CVType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.actorRole" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.actorRole" ] ;
       fhir:ElementDefinition.short [ fhir:value "actorRole" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Roll för aktör\n\nFiltrerar sökresultatet så att poster med angiven roll returneras.\n\nEndast texter som finns beskrivna för den angivna rollen returneras. Om det saknas text för angiven roll, returneras texter anpassade för invånare (enskild person) som alltid ska finnas om beskrivningstext finns.\n\nOm roll ej anges, ska samtliga texter returneras.\n\nrole.code: 223366009\n\nrole.displayname: hälso- och sjukvårdspersonal\n\nrole.codesystem:  1.2.752.116.2.1.1\n\nrole.code: 257513009\n\nrole.displayname: enskild person\n\nrole.codesystem:  1.2.752.116.2.1.1" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `actorRole*` (`CVType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/supportprocess-serviceprovisioning-healthcareoffering/StructureDefinition/CVType" ]
       ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "getcareserviceofferings-request.performingOrganizationId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcareserviceofferings-request.performingOrganizationId" ] ;
       fhir:ElementDefinition.short [ fhir:value "performingOrganizationId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "performingOrganizationId" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `performingOrganizationId` (`IIType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
