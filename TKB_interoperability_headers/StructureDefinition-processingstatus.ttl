  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "processingstatus" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus" ] ;
       fhir:ElementDefinition.short [ fhir:value "ProcessingStatus" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för det gemensamma huvudelementet ProcessingStatus\n(RIV-TA urn:riv:interoperability:headers:1, element ProcessingStatus av typen ProcessingStatusType).\nAnvänds av aggregerande tjänster för att rapportera tillbaka till konsumenten hur giltiga de returnerade\nuppgifterna är, med en statuspost per logisk adress (källsystem)." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "processingstatus.processingStatusList" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus.processingStatusList" ] ;
       fhir:ElementDefinition.short [ fhir:value "Statuspost per logisk adress" ] ;
       fhir:ElementDefinition.definition [ fhir:value "XSD: ProcessingStatusList (ProcessingStatusRecordType), 0..unbounded.\nEn post per källsystem (logisk adress) som den aggregerande tjänsten har hämtat eller försökt hämta uppgifter från." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "BackboneElement" ]
       ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "processingstatus-statuscode-consistency" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "statusCode ska stämma med isResponseFromCache och isResponseInSynch enligt tabellen i ProcessingStatus-dokumentationen" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "(statusCode = 'DataFromSource' implies (isResponseFromCache = false and isResponseInSynch = true)) and (statusCode = 'DataFromCache' implies (isResponseFromCache = true and isResponseInSynch = true)) and (statusCode = 'DataFromCacheSynchFailed' implies (isResponseFromCache = true and isResponseInSynch = false)) and (statusCode = 'NoDataSynchFailed' implies (isResponseFromCache = false and isResponseInSynch = false))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.inera.se/ig/interoperability-headers/StructureDefinition/processingstatus" ;
           fhir:link <https://fhir.inera.se/ig/interoperability-headers/StructureDefinition/processingstatus>
         ]
       ], [
         fhir:index 1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "processingstatus-unsuccessful-only-when-not-in-synch" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "lastUnsuccessfulSynch och lastUnsuccessfulSynchError anges bara när isResponseInSynch är false" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "isResponseInSynch = true implies (lastUnsuccessfulSynch.empty() and lastUnsuccessfulSynchError.empty())" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.inera.se/ig/interoperability-headers/StructureDefinition/processingstatus" ;
           fhir:link <https://fhir.inera.se/ig/interoperability-headers/StructureDefinition/processingstatus>
         ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "processingstatus.processingStatusList.logicalAddress" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus.processingStatusList.logicalAddress" ] ;
       fhir:ElementDefinition.short [ fhir:value "Logisk adress för källsystemet" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk adress till det källsystem som statusposten gäller." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "processingstatus.processingStatusList.statusCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus.processingStatusList.statusCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Statuskod för de returnerade uppgifterna" ] ;
       fhir:ElementDefinition.definition [ fhir:value "XSD: statusCode (StatusCodeEnum). Anger kvaliteten på de uppgifter som returnerats från denna logiska adress." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "code" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://fhir.inera.se/ig/interoperability-headers/ValueSet/processingstatuscode-vs" ;
           fhir:link <https://fhir.inera.se/ig/interoperability-headers/ValueSet/processingstatuscode-vs>
         ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "processingstatus.processingStatusList.isResponseFromCache" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus.processingStatusList.isResponseFromCache" ] ;
       fhir:ElementDefinition.short [ fhir:value "Svaret kommer från cache" ] ;
       fhir:ElementDefinition.definition [ fhir:value "true om svaret för denna logiska adress kommer från cachen, antingen direkt utan anrop till källsystemet\neller efter ett misslyckat anrop till källsystemet under denna bearbetning.\nfalse om källsystemet anropades under bearbetningen och returnerade aktuella uppgifter, eller om inga\nuppgifter kunde returneras, varken från cache eller källsystem." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "processingstatus.processingStatusList.isResponseInSynch" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus.processingStatusList.isResponseInSynch" ] ;
       fhir:ElementDefinition.short [ fhir:value "Svaret är aktuellt" ] ;
       fhir:ElementDefinition.definition [ fhir:value "true om svaret är aktuellt: antingen var uppgifterna i cachen redan aktuella, eller så lyckades anropet\ntill källsystemet under denna bearbetning.\nfalse om anropet till källsystemet misslyckades; se lastUnsuccessfulSynchError för felinformation." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "processingstatus.processingStatusList.lastSuccessfulSynch" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus.processingStatusList.lastSuccessfulSynch" ] ;
       fhir:ElementDefinition.short [ fhir:value "Senaste lyckade synkronisering" ] ;
       fhir:ElementDefinition.definition [ fhir:value "XSD: xs:string, obligatorisk (minOccurs=1). Modellerad som 0..1 eftersom statustabellen anger värdet\nsom tomt vid NoDataSynchFailed (se ASSUME-IH-002). Tidsstämpel för det senaste lyckade anropet från den\naggregerande tjänsten till källsystemet, om något.\nTypen är string i schemat trots att innehållet är en tidsstämpel (se ASSUME-IH-001)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "processingstatus.processingStatusList.lastUnsuccessfulSynch" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus.processingStatusList.lastUnsuccessfulSynch" ] ;
       fhir:ElementDefinition.short [ fhir:value "Senaste misslyckade synkronisering" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Anges bara om isResponseInSynch är false. Tidsstämpel för det senaste misslyckade anropet från den\naggregerande tjänsten till källsystemet. XSD-typ xs:string (se ASSUME-IH-001)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "processingstatus.processingStatusList.lastUnsuccessfulSynchError" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus.processingStatusList.lastUnsuccessfulSynchError" ] ;
       fhir:ElementDefinition.short [ fhir:value "Fel vid senaste misslyckade synkronisering" ] ;
       fhir:ElementDefinition.definition [ fhir:value "XSD: LastUnsuccessfulSynchErrorType. Anges bara om isResponseInSynch är false.\nBeskriver felet som uppstod vid anropet till källsystemet under denna bearbetning." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "BackboneElement" ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "processingstatus.processingStatusList.lastUnsuccessfulSynchError.causingAgent" ] ;
       fhir:ElementDefinition.path [ fhir:value "processingstatus.processingStatusList.lastUnsuccessfulSynchError.causingAgent" ] ;
       fhir:ElementDefinition.short [ fhir:value "Felande komponent" ] ;
