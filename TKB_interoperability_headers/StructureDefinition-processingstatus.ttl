       fhir:ElementDefinition.definition [ fhir:value "XSD: code. Beskriver felet med en kod som är meningsfull för causingAgent.\nOmdöpt från code enligt konventionen för reserverade namn." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
