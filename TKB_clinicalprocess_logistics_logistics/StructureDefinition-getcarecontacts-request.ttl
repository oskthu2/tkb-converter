     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getcarecontacts-request.patientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcarecontacts-request.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "patientId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för patienten där fältet id sätts till patientens identifierare. Anges med 12 tecken utan avskiljare.\n\nFältet type sätts till OID för typ av identifierare.\n\n1) För personnummer ska Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas.\n\n2) För samordningsnummer ska Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas.\n\n3) Tjänsteproducenter ska även stödja sökning på reservnummer med hjälp av att ange lokalt definierade OID’ar för reservnummer, exempelvis SLL reservnummer (1.2.752.97.3.1.3).\n\nOBS reservnummer kan ej användas tillsammans med EI och aggregerande tjänster då dessa komponenter idag inte är anpassade för att stödja typ av id, inga uppdateringar till EI ska göras av en tjänsteproducent för reservnummer.\n\nEn tjänstekonsument som vill begära mha reservnummer måste därmed använda sig av systemadressering och ha vetskap om vilken reservnummer- OID som gäller vid anrop mot en specifik tjänsteproducent." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `patientId` (`PersonIdType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getcarecontacts-request.patientId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/PersonIdType" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getcarecontacts-request.datePeriod" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcarecontacts-request.datePeriod" ] ;
       fhir:ElementDefinition.short [ fhir:value "datePeriod" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till det angivna intervallet. Begränsningen innebär att endast poster returneras där datumintervallet, som bildas av tidpunkterna authorTime, careContactTimePeriod.start och careContactTimePeriod.end i svaret, helt eller delvis överlappar med det angivna sökintervallet, dvs.\n\ndet bildade intervallets startdatum ligger inom sökintervallets start- och slutdatum\n\ndet bildade intervallets slutdatum ligger inom sökintervallets start- och slutdatum\n\ndet bildade intervallets startdatum ligger före sökintervallets startdatum och slutdatum ligger efter sökintervallets slutdatum\n\ncareContactTimePeriod.start ligger före eller inom sökintervallets start- och slutdatum samt careContactTimePeriod.end saknas.\n\ncareContactTimePeriod.end ligger inom eller efter sökintervallets start- och slutdatum samt careContactTimePeriod.start saknas.\n\nNotera att sökintervallet beskrivs som ett datumintervall. Vid jämförelse konverteras datapostens tidpunkter till datum." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `datePeriod` (`DatePeriodType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getcarecontacts-request.datePeriod" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/clinicalprocess-logistics-logistics/StructureDefinition/DatePeriodType" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "getcarecontacts-request.sourceSystemHSAId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcarecontacts-request.sourceSystemHSAId" ] ;
       fhir:ElementDefinition.short [ fhir:value "sourceSystemHSAId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till aktivitet som är skapad i det angivna källsystemet. Tjänsteproducenten förväntas enbart returnera poster som tillhör efterfrågat källsystem.\n\nVärdet på detta fält måste överensstämma med värdet på logicalAddress i anropets tekniska kuvertering (ex. SOAP-header).\n\nDet innebär i praktiken att aggregerande tjänster inte används när detta fält anges.\n\nFältet är tvingande om careContactId angivits.\n\nFältet är tvingande vid begäran på reservnummer." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `sourceSystemHSAId` (`HSAIdType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getcarecontacts-request.sourceSystemHSAId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType>
         ]
       ]
     ], [
       fhir:index 6 ;
