       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för requestparametrar i tjänstekontraktet GetCareContacts\n(RIV-TA urn:riv:clinicalprocess:logistics:logistics:GetCareContacts:3).\nRepresenterar GetCareContactsType i GetCareContactsResponder_3.0.xsd." ] ;
