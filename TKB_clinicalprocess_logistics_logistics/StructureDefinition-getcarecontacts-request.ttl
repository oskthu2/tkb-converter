     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getcarecontacts-request.careGiverHSAId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcarecontacts-request.careGiverHSAId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careGiverHSAId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Filtrering på informationsägande vårdgivare, vilket motsvarar careGiverHSAId i healthcareProfessionalType" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careGiverHSAId` (`HSAIdType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getcarecontacts-request.careGiverHSAId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
