       fhir:ElementDefinition.short [ fhir:value "careContactCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Kod som anger på vilket sätt vårdkontakten är planerad att ske, alternativt skedde. KV Vårdkontakttyp (1.2.752.129.2.2.2.25) ska användas. Se referens [R6].\n\nUtelämnat värde betyder att värdet är okänt." ] ;
