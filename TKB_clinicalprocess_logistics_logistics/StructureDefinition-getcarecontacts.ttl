       fhir:Element.id [ fhir:value "getcarecontacts.careContact" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcarecontacts.careContact" ] ;
       fhir:ElementDefinition.short [ fhir:value "Vårdkontakter som matchar begäran" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Lista med vårdkontakter för patienten. Varje post innehåller header (basinformation)\noch body (kontaktspecifik information).\nKardinalitet: Valfri lista (0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
