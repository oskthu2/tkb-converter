       fhir:ElementDefinition.short [ fhir:value "utsattning" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information om eventuell historikskapande händelse (utsättning). Endast en typ av historikskapande-information (makluering, förändring eller utsättning) kan förekomma. Utsättning innehållande enbart utsättningstidpunkt kan dock förekomma i kombination med annat historikskapande objekt." ] ;
