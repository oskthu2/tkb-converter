  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getlogs" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlogs" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetLogs — Response" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för svaret i GetLogs\n(urn:riv:informationsecurity:auditing:log:GetLogsResponder:2, GetLogsResponseType)." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getlogs.logsResult" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlogs.logsResult" ] ;
       fhir:ElementDefinition.short [ fhir:value "LogsResultType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Resultatobjekt med status huruvida tjänsten returnerar ok eller om fel uppstått. Om tjänsten utförts utan fel returneras en lista med loggposter samt resultatkod OK.\n\nVid eventuella fel i tjänsteanropet returneras inga loggposter. Statuskod som beskriver orsaken till fel returneras då tillsammans med ett felmeddelande." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `logsResult` (`urn:riv:informationsecurity:auditing:log:2:LogsResultType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getlogs.logsResult.reportResult" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlogs.logsResult.reportResult" ] ;
       fhir:ElementDefinition.short [ fhir:value "ReportResultType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "reportResult" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../reportResult` (`ReportResultType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getlogs.logsResult.reportResult.result" ] ;
       fhir:ElementDefinition.path [ fhir:value "getlogs.logsResult.reportResult.result" ] ;
       fhir:ElementDefinition.short [ fhir:value "ResultType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Datatyp som returneras som ett generellt svar från alla förändrande tjänster, t.ex. skapa, radera, etc. En anropande klient skall alltid kontrollera att resultatkoden inte innehåller fel för att på så sätt veta om anropet lyckades. Alla svarskoder förutom OK och INFO betyder att åtgärden inte genomfördes." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../result` (`ResultType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
