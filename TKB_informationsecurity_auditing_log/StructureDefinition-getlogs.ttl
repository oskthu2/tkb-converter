       fhir:ElementDefinition.path [ fhir:value "getlogs.logsResult.reportResult.result.resultCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "resultCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "resultCode Tillåtna värden: OK, INFO, ERROR, VALIDATION_ERROR, ACCESSDENIED, REPORT_ON_QUEUE, REPORT_IN_PROCESS, REPORT_NOT_FOUND, MAX_QUERY_RESULT_EXCEEDED." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../resultCode` (`ResultCodeType`, kardinalitet 1..1).\n\n**Modellanteckning:** resultCode Tillåtna värden: OK, INFO, ERROR, VALIDATION_ERROR, ACCESSDENIED, REPORT_ON_QUEUE, REPORT_IN_PROCESS, REPORT_NOT_FOUND, MAX_QUERY_RESULT_EXCEEDED." ] ;
