  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getaccesslogsforpatient" ] ;
       fhir:ElementDefinition.path [ fhir:value "getaccesslogsforpatient" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetAccessLogsForPatient — Response" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för svaret i GetAccessLogsForPatient\n(urn:riv:informationsecurity:auditing:log:GetAccessLogsForPatientResponder:2, GetAccessLogsForPatientResponseType)." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getaccesslogsforpatient.accessLogsResult" ] ;
       fhir:ElementDefinition.path [ fhir:value "getaccesslogsforpatient.accessLogsResult" ] ;
       fhir:ElementDefinition.short [ fhir:value "AccessLogsResultType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Resultatobjekt med status huruvida tjänsten returnerar ok eller om fel uppstått. Om tjänsten utförts korrekt returneras en lista med patientinformation och resultatkod OK.\n\nVid eventuella fel i tjänsteanropet returneras ingen patientinformation. Statuskod som beskriver orsaken till fel returneras då tillsammans med ett felmeddelande." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `accessLogsResult` (`urn:riv:informationsecurity:auditing:log:2:AccessLogsResultType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getaccesslogsforpatient.accessLogsResult.reportResult" ] ;
       fhir:ElementDefinition.path [ fhir:value "getaccesslogsforpatient.accessLogsResult.reportResult" ] ;
       fhir:ElementDefinition.short [ fhir:value "ReportResultType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "reportResult" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../reportResult` (`ReportResultType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getaccesslogsforpatient.accessLogsResult.reportResult.result" ] ;
       fhir:ElementDefinition.path [ fhir:value "getaccesslogsforpatient.accessLogsResult.reportResult.result" ] ;
       fhir:ElementDefinition.short [ fhir:value "ResultType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Datatyp som returneras som ett generellt svar från alla förändrande tjänster, t.ex. skapa, radera, etc. En anropande klient skall alltid kontrollera att resultatkoden inte innehåller fel för att på så sätt veta om anropet lyckades. Alla svarskoder förutom OK och INFO betyder att åtgärden inte genomfördes." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../result` (`ResultType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 4 ;
