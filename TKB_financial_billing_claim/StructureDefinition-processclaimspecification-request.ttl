       fhir:ElementDefinition.short [ fhir:value "diagnosisCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Diagnoskod\n\nKod för diagnos.\n\nDet kodsystem som styr vilken diagnos som angivits.\n\nI sluten vård ska det alltid vara kod enligt ICD10-SE. I öppen vård bör det vara enligt ICD10-SE men även\n\nandra koddiagnoser kan finnas.\n\nCode:\n\ncodesystem: ”1.2.752.116.1.1.1.1.3”\n\nObligatoriskt fält." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../../../diagnosisCode` (`CVType`, kardinalitet 1..1)." ] ;
