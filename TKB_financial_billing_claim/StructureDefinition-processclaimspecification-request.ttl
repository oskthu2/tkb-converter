       fhir:ElementDefinition.short [ fhir:value "patientSpecificCareCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Typ av patient specifik åtgärd\n\nKod när debiteringen avser patientspecifika åtgärder, besök, vårddagar mm.\n\nUppgiften ifylls när vårdinsatsens debitering inte avser fakturering enligt DRG-priser.\n\nObligatoriskt fält under nämnda förutsättningar." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../../patientSpecificCareCode` (`string`, kardinalitet 0..1)." ] ;
