       fhir:Element.id [ fhir:value "requestexemptionstatuses-request" ] ;
       fhir:ElementDefinition.path [ fhir:value "requestexemptionstatuses-request" ] ;
       fhir:ElementDefinition.short [ fhir:value "RequestExemptionStatuses — Request" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för begäran i RequestExemptionStatuses\n(urn:riv:financial:patientfees:exemption:RequestExemptionStatusesResponder:1, RequestExemptionStatusesType), inklusive SOAP-huvuden enligt WSDL." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "Base" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.isModifier [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "requestexemptionstatuses-request.requestId" ] ;
       fhir:ElementDefinition.path [ fhir:value "requestexemptionstatuses-request.requestId" ] ;
       fhir:ElementDefinition.short [ fhir:value "requestId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Unikt Id för begäran om utlämnandet. Det är konsuments ansvar att säkerställa identifierarens unikitet. Producent kommer därefter att använda denna identifierare i sitt svar som sker asynkront via tjänstekontraktet ProcessExemptionStatuses" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `requestId` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "requestexemptionstatuses-request.requestId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "requestexemptionstatuses-request.patientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "requestexemptionstatuses-request.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "patientId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för patienten där fältet id sätts till patientens identifierare. Anges med 12 tecken utan avskiljare.\n\nTjänsteproducenten skall i svaret leverera all information på en begäran riktad mot individens huvudidentitet, dvs även information som tidigare har registrerats på andra till individen kopplade identiteter (LRID, NRID, tidigare SNR, eller tidigare PNR)\n\nFältet type sätts till OID för typ av identifierare.\n\n1) För PNR skall Skatteverkets oid för PNR (1.2.752.129.2.1.3.1) användas.\n\n2) För SNR skall Skatteverkets oid för SNR (1.2.752.129.2.1.3.3) användas.\n\n3) För NRID skall Ineras oid för NRID (1.2.752.74.9.1) användas.\n\n4) Tjänsteproducenter skall även stödja sökning på LRID med hjälp av att ange lokalt definierade oid’ar för LRID, exempelvis SLL’s LRID(1.2.752.97.3.1.3).\n\nOBS LRID kan ej användas tillsammans med EI och aggregerande tjänster då dessa komponenter idag inte är anpassade för att stödja typ av id, inga uppdateringar till EI skall göras av en tjänsteproducent för LRID.\n\nEn tjänstekonsument som vill begära mha LRID måste därmed använda sig av systemadressering och ha vetskap om vilken LRID-oid som gäller vid anrop mot en specifik tjänsteproducent." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `patientId` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "requestexemptionstatuses-request.patientId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "requestexemptionstatuses-request.actor" ] ;
       fhir:ElementDefinition.path [ fhir:value "requestexemptionstatuses-request.actor" ] ;
       fhir:ElementDefinition.short [ fhir:value "ActorType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Aktören som begär utlämnandet.\n\nAktören är antingen invånare som begär ut sin information alternativt vårdnadshavare som begär ut barnets information.\n\nAktören kan även vara en vårdgivare som begär ut patients information från annan vårdgivare." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `actor` (`ActorType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "requestexemptionstatuses-request.actor" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "requestexemptionstatuses-request.actor.actorTypeEnum" ] ;
       fhir:ElementDefinition.path [ fhir:value "requestexemptionstatuses-request.actor.actorTypeEnum" ] ;
       fhir:ElementDefinition.short [ fhir:value "actorTypeEnum" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Enumeration som visar typ av aktör. Kan vara en av följande:\n\nCITIZEN\n\nGUARDIAN\n\nCAREGIVER" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `actor.actorTypeEnum` (`ActorTypeEnum`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "requestexemptionstatuses-request.actor.actorTypeEnum" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "code" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://fhir.inera.se/ig/financial-patientfees-exemption/ValueSet/patientfees-exemption-actortype-vs" ;
           fhir:link <https://fhir.inera.se/ig/financial-patientfees-exemption/ValueSet/patientfees-exemption-actortype-vs>
         ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "requestexemptionstatuses-request.actor.actorId" ] ;
       fhir:ElementDefinition.path [ fhir:value "requestexemptionstatuses-request.actor.actorId" ] ;
       fhir:ElementDefinition.short [ fhir:value "actorId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Beroende på typ av aktör anges antingen aktörens personnummer eller HSAId.\n\nFör CITIZEN och GUARDIAN anges ett personnummer, se attributet patientId för hur personnummer anges.\n\nFör CAREGIVER anges ett HSAId för vårdpersonal. I det fall sätts:\n\nactor.actorId.root = 1.2.752.129.2.1.4.1\n\nactor.actorId.extension = `<HSA Id>`" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `actor.actorId` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "requestexemptionstatuses-request.actor.actorId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "requestexemptionstatuses-request.actor.careGiverId" ] ;
       fhir:ElementDefinition.path [ fhir:value "requestexemptionstatuses-request.actor.careGiverId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careGiverId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Om aktören är CAREGIVER ska HSAId för vårdgivare anges. Annars ska detta fält utelämnas.\n\nFör vårdgivare sätts:\n\nactor.careGiverId.root = 1.2.752.129.2.1.4.1\n\nactor.careGiverId.extension = `<HSA Id>`" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `actor.careGiverId` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "requestexemptionstatuses-request.actor.careGiverId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "requestexemptionstatuses-request.responseLogicalAddress" ] ;
       fhir:ElementDefinition.path [ fhir:value "requestexemptionstatuses-request.responseLogicalAddress" ] ;
       fhir:ElementDefinition.short [ fhir:value "responseLogicalAddress" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk adress dit utlämnandet senare ska skickas. Anropande part av detta tjänstekontrakt måste således även vara producent för tjänstekontraktet ProcessExemptionStatuses, dit svaret/utlämnandet senare skickas asynkront. Det betyder att anropande part behöver vara upplagd i tjänsteadresseringskatalogen (TAK) som producent samt att konsument av ProcessExemptionStatuses givits anropsbehörighet till anropande part." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `responseLogicalAddress` (`String`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "requestexemptionstatuses-request.responseLogicalAddress" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ]
  ] ;
