       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.author.name" ] ;
       fhir:ElementDefinition.short [ fhir:value "name" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Namn på hälso- och sjukvårdspersonal." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../name` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
