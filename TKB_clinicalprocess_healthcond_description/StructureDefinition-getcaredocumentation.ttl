       fhir:ElementDefinition.short [ fhir:value "id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "HSA-id för hälso- och sjukvårdspersonal.\n\nFältet root sätts till oid för HSA-id (1.2.752.129.2.1.4.1) och fältet extension sätts till HSA-id." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../id` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
