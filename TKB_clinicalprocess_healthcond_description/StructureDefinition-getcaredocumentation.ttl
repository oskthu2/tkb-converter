       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../orgUnit` (`OrgUnitType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
