       fhir:ElementDefinition.short [ fhir:value "AuthorType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Hälso- och sjukvårdspersonal som ansvarar för information i patientjournal. Notera att den som registrerar informationen från annan källa, exempelvis en medicinsk sekreterare som transkriberar ett diktat, inte är författare." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../author` (`AuthorType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
