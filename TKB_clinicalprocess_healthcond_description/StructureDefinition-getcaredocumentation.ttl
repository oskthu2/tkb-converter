       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader" ] ;
       fhir:ElementDefinition.short [ fhir:value "AccessControlHeaderType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information för kontroll av åtkomst.\n\nSyftet med denna del av headern är att den ska innehålla den information som behövs för konsumentens filtrering av informationen innan den visas upp för slutanvändaren eller på annat vis behandlas vidare, exempelvis för kontroll av spärrar (avseende vårdpersonals åtkomst till information; PDL) eller om informationen får visas för patienten eller inte (verksamhetens rätt till rådrum och menprövning).\n\nEn konsument (en konsumerande tjänst/applikation) har inte rätt att ta del av något annat än innehållet i accessControlHeader innan de för ändamålet nödvändiga säkerhetskontrollerna har utförts." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../accessControlHeader` (`AccessControlHeaderType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.accountableHealthcareProvider" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.accountableHealthcareProvider" ] ;
       fhir:ElementDefinition.short [ fhir:value "accountableHealthcareProvider" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för informationsägande vårdgivare.\n\nI första hand HSAid alternativt i andra hand organisationsnummer.\n\nOm HSA-id används sätts fältet root till oid för HSA-katalogen (1.2.752.129.2.1.4.1) och fältet extension sätts till HSA-id.\n\nOm organisationsnummer används skall fältet root sättas till OID för organisationsnummer (1.2.752.29.4.3) och fältet extension sättas till organisationsnumret.\n\nEnskild näringsidkare har i rollen som juridisk person sitt personnummer som organisationsnummer.\n\nSe även regel Spärrhantering." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../accountableHealthcareProvider` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.accountableCareUnit" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.accountableCareUnit" ] ;
       fhir:ElementDefinition.short [ fhir:value "accountableCareUnit" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för informationsägande vårdenhet angivet med HSA-id.\n\nFältet root sätts OID för HSA-katalogen (1.2.752.129.2.1.4.1) och fältet extension sätts till HSA-id.\n\nFältet används för spärrkontroll och är obligatorisk om uppgiften i patientjournal ska kunna ses via sammanhållen journalföring.\n\nSe även regel Spärrhantering." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../accountableCareUnit` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.patientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "patientId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Patientens identitetsbeteckning. Den identitetsbeteckning som denna uppgift lagrades under när uppgiften skapades ska om möjligt anges. Exempel på en situation då detta förekommer är exempelvis då patienten tidigare erhållit vård dokumenterat under ett samordningsnummer för att sedan bli folkbokförd i Sverige och få ett personnummer.\n\nFältet root sätts till OID för kodverket för identifieraren:\n\n1) För personnummer skall Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas.\n\n2) För samordningsnummer skall Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas.\n\nFältet extension sätts till patientens identifierare. Anges med 12 tecken utan avskiljare." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../patientId` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.careProcessId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.careProcessId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careProcessId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för den individanpassad vårdprocess som informationen journalförts inom ramen för. Består av ett lokalt genererat UUID.\n\nUUID anges i root och extension lämnas tomt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../careProcessId` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "blockComparisonTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den tidpunkt mot vilken spärrkontroll sker vid åtkomst med syftet sammanhållen journalföring för kontroll av patientens (ev.) spärrade information, såväl yttre (mellan vårdgivare) som inre (mellan vårdenheter) spärr.\n\nTidpunkten ska i så hög grad som möjligt överensstämma med den tidpunkt som ur patientens synvinkel är den mest naturliga. Detta är vanligtvis tidpunkten för patientens vårdkontakt som låg till grund för dokumentationen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../blockComparisonTime` (`TimeStampType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType>
         ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.accessControlHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.short [ fhir:value "approvedForPatient" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ansvarig vårdpersonals beslut, alternativt baserat på verksamhetens policy och regler (men-/sekretessprövning), huruvida informationen får delas till patient för ändamålet Patients åtkomst (Individens direktåtkomst).\n\nOm information beslutas delas sätts värdet i sådant fall till true, i annat fall till false. False innebär att informationen inte får delas till patient.\n\nNotera att flaggans värde kan, för samma information, förändras med tiden på grund av att rådrumstid har passerats, eller att verksamheten ändrat policy för vad som lämnas ut till patient.\n\nI sådana fall skall källsystemet uppdatera engagemangsindex för att konsumenter skall kunna bli notifierade därom." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../approvedForPatient` (`boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.sourceSystemId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.sourceSystemId" ] ;
       fhir:ElementDefinition.short [ fhir:value "sourceSystemId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Det källsystem som informationen lagras i.\n\nFältet root sätts till OID för HSA-katalogen (1.2.752.129.2.1.4.1) och fältet extension sätts till källsystemets HSA-id." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../sourceSystemId` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.record" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.record" ] ;
       fhir:ElementDefinition.short [ fhir:value "RecordType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Uppgift i patientjournal\n\nMetainformation avseende den dokumenterade informationen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../record` (`RecordType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.record.id" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.record.id" ] ;
       fhir:ElementDefinition.short [ fhir:value "id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Unik och beständig identifierare för uppgift i patientjournal.\n\nFör att vara konsistent och beständig med tidigare majorversioner ska tjänsteproducenter av tidigare majorversioner av GetCareDocumentation endast ange root på samma sätt som documentId i tidigare majorversioner.\n\nExtension utelämnas. Denna hantering krävs för att tjänstekonsumenten ska kunna filtrera bort dubbletter.\n\nIdentifieraren ska vara konsistent och beständigt mellan olika kontrakt. Ett exempel på detta är att samma remiss-identitet ska användas i ett tjänstekontrakt för att läsa remisser, samt tjänstekontraktet som läser remissvar som refererar till den ursprungliga remissen.\n\nSe även regel Verify unique recordId." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../id` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 13 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.header.record.timestamp" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.header.record.timestamp" ] ;
       fhir:ElementDefinition.short [ fhir:value "timestamp" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Första tidpunkten då denna journalinformation skapades hos tjänsteproducenten." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../timestamp` (`TimeStampType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
