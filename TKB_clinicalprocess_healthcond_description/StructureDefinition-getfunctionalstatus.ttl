       fhir:ElementDefinition.path [ fhir:value "getfunctionalstatus.functionalStatusAssessment.functionalStatusAssessmentHeader" ] ;
       fhir:ElementDefinition.short [ fhir:value "Dokumenthuvud (PatientSummaryHeader)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Innehåller basinformation om dokumentet" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../functionalStatusAssessmentHeader` (`PatientSummaryHeaderType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
