  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getfunctionalstatus" ] ;
       fhir:ElementDefinition.path [ fhir:value "getfunctionalstatus" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetFunctionalStatus" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för tjänstekontraktet GetFunctionalStatus\n(RIV-TA urn:riv:clinicalprocess:healthcond:description:GetFunctionalStatusResponder:2).\nRepresenterar responsens informationsstruktur: dokumenterade bedömningar av\nfunktionsnedsättningar och/eller aktivitetsförmåga (PADL) för en patient.\nBedömningskategori styrs av assessmentCategory: 'pad-pad' (PADL) eller 'fun-fun' (funktionsnedsättning).\nEn tjänsteproducent måste använda samma värde för categorization i engagemangsindex som\nför assessmentCategory i svaret." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getfunctionalstatus.functionalStatusAssessment" ] ;
       fhir:ElementDefinition.path [ fhir:value "getfunctionalstatus.functionalStatusAssessment" ] ;
       fhir:ElementDefinition.short [ fhir:value "Funktionsstatusbedömning" ] ;
       fhir:ElementDefinition.definition [ fhir:value "De funktionsstatusbedömningar som matchar begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `functionalStatusAssessment` (`FunctionalStatusAssessmentTime`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
