       ]
     ]
  ] ;
  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getdiagnosis-request" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis-request" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetDiagnosis — Request" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för requestparametrar i GetDiagnosis\n(RIV-TA urn:riv:clinicalprocess:healthcond:description:GetDiagnosisResponder:2).\nSöker diagnoser för en patient med valfri filtrering." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getdiagnosis-request.careUnitHSAId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis-request.careUnitHSAId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Filtrering på vårdenhet" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Filtrering på vårdenhet vilket motsvarar careUnitHSAId i healthcareProfessionalType." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careUnitHSAId` (`HSAIdType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getdiagnosis-request.patientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis-request.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patientens id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för patienten där fältet id sätts till patientens identifierare. Anges med 12 tecken utan avskiljare.\n\nFältet type sätts till OID för typ av identifierare.\n\n1) För personnummer ska Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas), [R14].\n\n2) För samordningsnummer ska Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas), [R14].\n\n3) Tjänsteproducenter ska även stödja sökning på reservnummer med hjälp av att ange lokalt definierade OID’ar för reservnummer, exempelvis SLL reservnummer (1.2.752.97.3.1.3), [R14].\n\nOBS reservnummer kan ej användas tillsammans med EI och aggregerande tjänster då dessa komponenter idag inte är anpassade för att stödja typ av id, inga uppdateringar till EI ska göras av en tjänsteproducent för reservnummer.\n\nEn tjänstekonsument som vill begära mha reservnummer måste därmed använda sig av systemadressering och ha vetskap om vilken reservnummer-OID som gäller vid anrop mot en specifik tjänsteproducent." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `patientId` (`PersonIdType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getdiagnosis-request.timePeriod" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis-request.timePeriod" ] ;
       fhir:ElementDefinition.short [ fhir:value "Tidsperiod för sökning" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till det angivna intervallet. Begränsningen innebär att endast poster returneras där någon av tidpunkterna authorTime, signatureTime eller diagnosisTime i svaret ligger inom sökintervallets start- och slutdatum.\n\nNotera att sökintervallet beskrivs som ett datumintervall. Vid jämförelse konverteras datapostens tidpunkter till datum." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `timePeriod` (`DatePeriodType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Period" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getdiagnosis-request.sourceSystemHSAId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis-request.sourceSystemHSAId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Källsystem HSA-id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till diagnoser som tillgängliggörs av angivet källsystem.\n\nVärdet på detta fält måste överensstämma med värdet på logicalAddress i anropets tekniska kuvertering (ex. SOAP-header).\n\nDet innebär i praktiken att aggregerande tjänster inte används när detta fält anges.\n\nSka anges om careContactId angivits.\n\nSka anges vid begäran på reservnummer.\n\nOm sourceSystemHSAId och logicalAddress är olika ska ett svar endast innehålla en resultType med result.resultCode satt till ERROR samt result.errorCode satt till INVALID_REQUEST\n\nOm careContactId är satt och sourceSystemHSAId är tomt ska ett svar endast innehålla en resultType med  result.resultCode satt till ERROR samt result.errorCode satt till INVALID_REQUEST." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `sourceSystemHSAId` (`HSAIdType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "getdiagnosis-request.careContactId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis-request.careContactId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Vårdkontakts-id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till de diagnoser som dokumenterades vid hälso- och sjukvårdskontakt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careContactId` (`string`, kardinalitet 0..*).\n\n**Modellanteckning:** Begränsar sökningen till de diagnoser som dokumenterats vid angiven vårdkontakt." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ]
  ] .

