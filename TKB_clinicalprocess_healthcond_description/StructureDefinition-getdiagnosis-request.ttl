     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getdiagnosis-request.sourceSystemHSAId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis-request.sourceSystemHSAId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Källsystem HSA-id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till diagnoser som tillgängliggörs av angivet källsystem.\n\nVärdet på detta fält måste överensstämma med värdet på logicalAddress i anropets tekniska kuvertering (ex. SOAP-header).\n\nDet innebär i praktiken att aggregerande tjänster inte används när detta fält anges.\n\nSka anges om careContactId angivits.\n\nSka anges vid begäran på reservnummer.\n\nOm sourceSystemHSAId och logicalAddress är olika ska ett svar endast innehålla en resultType med result.resultCode satt till ERROR samt result.errorCode satt till INVALID_REQUEST\n\nOm careContactId är satt och sourceSystemHSAId är tomt ska ett svar endast innehålla en resultType med  result.resultCode satt till ERROR samt result.errorCode satt till INVALID_REQUEST." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `sourceSystemHSAId` (`HSAIdType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getdiagnosis-request.sourceSystemHSAId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "getdiagnosis-request.careContactId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis-request.careContactId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Vårdkontakts-id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Begränsar sökningen till de diagnoser som dokumenterades vid hälso- och sjukvårdskontakt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careContactId` (`string`, kardinalitet 0..*).\n\n**Modellanteckning:** Begränsar sökningen till de diagnoser som dokumenterats vid angiven vårdkontakt." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getdiagnosis-request.careContactId" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
