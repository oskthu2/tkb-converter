       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för requestparametrar i GetDiagnosis\n(RIV-TA urn:riv:clinicalprocess:healthcond:description:GetDiagnosisResponder:2).\nSöker diagnoser för en patient med valfri filtrering." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
