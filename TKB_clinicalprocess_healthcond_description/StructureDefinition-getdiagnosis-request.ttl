       fhir:ElementDefinition.short [ fhir:value "Filtrering på vårdenhet" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Filtrering på vårdenhet vilket motsvarar careUnitHSAId i healthcareProfessionalType." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careUnitHSAId` (`HSAIdType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
