  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getdiagnosis" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetDiagnosis" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för svaret i tjänstekontraktet GetDiagnosis version 2.0 (RIV-TA urn:riv:clinicalprocess:healthcond:description:GetDiagnosisResponder:2), enligt fältreglerna i TKB clinicalprocess:healthcond:description 2.1.18. Representerar svarets informationsstruktur: diagnoser för en patient samt resultat." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getdiagnosis.diagnosis" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis.diagnosis" ] ;
       fhir:ElementDefinition.short [ fhir:value "DiagnosisType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "De diagnoser som matchar begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `diagnosis` (`DiagnosisType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getdiagnosis.diagnosis.diagnosisHeader" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis.diagnosis.diagnosisHeader" ] ;
       fhir:ElementDefinition.short [ fhir:value "PatientSummaryHeaderType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Innehåller basinformation om dokumentet" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../diagnosisHeader` (`PatientSummaryHeaderType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getdiagnosis.diagnosis.diagnosisHeader.documentId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdiagnosis.diagnosis.diagnosisHeader.documentId" ] ;
       fhir:ElementDefinition.short [ fhir:value "documentId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Dokumentets identitet som är unik inom källsystemet.\n\nIdentifieraren ska vara konsistent och beständigt mellan olika majorversioner av ett kontrakt. Ett exempel på detta är att en vårdkontakt ska ha samma identifierare i majorversion 3 och 4 av ett tjänstekontrakt för att läsa vårdkontakter.\n\nIdentifieraren ska vara konsistent och beständigt mellan olika kontrakt. Ett exempel på detta är att samma remiss-identitet ska användas i ett tjänstekontrakt för att läsa remisser, samt tjänstekontraktet som läser remissvar som refererar till den ursprungliga remissen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../documentId` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
