       fhir:ElementDefinition.path [ fhir:value "getalertinformation-request" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetAlertInformation — Request" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för begäran i tjänstekontraktet GetAlertInformation version 2.0 (RIV-TA urn:riv:clinicalprocess:healthcond:description:GetAlertInformationResponder:2), enligt fältreglerna i TKB clinicalprocess:healthcond:description 2.1.18." ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "getalertinformation-request-carecontact-requires-sourcesystem" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "sourceSystemHSAId ska anges om careContactId angivits (TKB, fältregler för begäran)." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "careContactId.exists() implies sourceSystemHSAId.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://fhir.inera.se/ig/clinicalprocess-healthcond-description/StructureDefinition/getalertinformation-request" ;
           fhir:link <https://fhir.inera.se/ig/clinicalprocess-healthcond-description/StructureDefinition/getalertinformation-request>
         ]
