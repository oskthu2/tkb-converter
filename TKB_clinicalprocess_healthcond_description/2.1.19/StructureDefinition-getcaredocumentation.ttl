       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader.documentTitle" ] ;
       fhir:ElementDefinition.short [ fhir:value "documentTitle" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Titel som beskriver den information som sänds i dokumentet." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../documentTitle` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader.documentTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader.documentTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "documentTime" ] ;
