       fhir:ElementDefinition.short [ fhir:value "sourceSystemHSAid" ] ;
       fhir:ElementDefinition.definition [ fhir:value "HSA-id för det system som dokumentet är skapat i.\n\nNotera att elementnamnet i de andra kontrakten är sourceSystemHSAId (med ett versalt I). Skälet till avvikelsen här är p.g.a. behovet av detta kontrakts bakåtkompatibilitet med kontraktet i version 2.0." ] ;
