       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader.sourceSystemHSAid" ] ;
       fhir:ElementDefinition.short [ fhir:value "HSA-id för det system som dokumentet är skapat i" ] ;
       fhir:ElementDefinition.definition [ fhir:value "HSA-id för det system som dokumentet är skapat i. / Notera att elementnamnet i de andra kontrakten är sourceSystemHSAId (med ett versalt I). Skälet till avvikelsen här är p.g.a. behovet av detta kontrakts bakåtkompatibilitet med kontraktet i version 2.0. TKB-typ: HSAIdType. Kardinalitet: 1..1." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
