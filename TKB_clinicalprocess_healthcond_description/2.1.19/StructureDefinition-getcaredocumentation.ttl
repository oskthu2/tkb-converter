  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getcaredocumentation" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetCareDocumentation" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för svaret i tjänstekontraktet GetCareDocumentation version 2.1 (RIV-TA urn:riv:clinicalprocess:healthcond:description:GetCareDocumentationResponder:2), enligt fältreglerna i TKB clinicalprocess:healthcond:description 2.1.18. Representerar svarets informationsstruktur: hälso- och sjukvårdsdokument för en patient samt resultat." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation" ] ;
       fhir:ElementDefinition.short [ fhir:value "CareDocumentationType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "De hälso- och sjukvårdsdokument som matchar begäran." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `careDocumentation` (`CareDocumentationType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader" ] ;
       fhir:ElementDefinition.short [ fhir:value "CPatientSummaryHeaderType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Innehåller basinformation om dokumentet" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../careDocumentationHeader` (`PatientSummaryHeaderType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader.documentId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader.documentId" ] ;
       fhir:ElementDefinition.short [ fhir:value "documentId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Dokumentets identitet som är unik inom källsystemet.\n\nIdentifieraren ska vara konsistent och beständigt mellan olika majorversioner av ett kontrakt. Ett exempel på detta är att en vårdkontakt ska ha samma identifierare i majorversion 3 och 4 av ett tjänstekontrakt för att läsa vårdkontakter.\n\nIdentifieraren ska vara konsistent och beständigt mellan olika kontrakt. Ett exempel på detta är att samma remiss-identitet ska användas i ett tjänstekontrakt för att läsa remisser, samt tjänstekontraktet som läser remissvar som refererar till den ursprungliga remissen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../documentId` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader.sourceSystemHSAid" ] ;
       fhir:ElementDefinition.path [ fhir:value "getcaredocumentation.careDocumentation.careDocumentationHeader.sourceSystemHSAid" ] ;
       fhir:ElementDefinition.short [ fhir:value "sourceSystemHSAid" ] ;
       fhir:ElementDefinition.definition [ fhir:value "HSA-id för det system som dokumentet är skapat i.\n\nNotera att elementnamnet i de andra kontrakten är sourceSystemHSAId (med ett versalt I). Skälet till avvikelsen här är p.g.a. behovet av detta kontrakts bakåtkompatibilitet med kontraktet i version 2.0." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../sourceSystemHSAid` (`HSAIdType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/HSAIdType>
         ]
       ]
     ], [
       fhir:index 5 ;
