       fhir:ElementDefinition.short [ fhir:value "clinicalDocumentTypeCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Obligatoriskt om clinicalDocumentNoteCode saknas. Får annars inte anges samtidigt med clinicalDocumentNoteCode.\n\nEpikris = epi\n\nIntagninganteckning = int\n\nDaganteckning = dag\n\nÖppenvårdsanteckning = ova Öppenvårdssammanfattning = ovs\n\nÖvrigt document = ovr" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../clinicalDocumentTypeCode` (`ClinicalDocumentTypeCodeEnum`, kardinalitet 0..0).\n\n**Modellanteckning:** clinicalDocumentTypeCode Tillåtna värden: epi, int, dag, ova, ovs, ovr." ] ;
