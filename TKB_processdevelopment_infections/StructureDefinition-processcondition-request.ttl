       fhir:index 0 ;
       fhir:Element.id [ fhir:value "processcondition-request" ] ;
       fhir:ElementDefinition.path [ fhir:value "processcondition-request" ] ;
       fhir:ElementDefinition.short [ fhir:value "ProcessCondition — Request" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för requestparametrar i ProcessCondition. Registrerar ett\neller flera nya bedömt hälsorelaterat tillstånd med information om\npatient, organisatorisk enhet och tillstånd. Ett befintligt tillstånd kan\nuppdateras genom att ett nytt meddelande med samma tillståndsid skickas in." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "processcondition-request.logicalAddress" ] ;
       fhir:ElementDefinition.path [ fhir:value "processcondition-request.logicalAddress" ] ;
       fhir:ElementDefinition.short [ fhir:value "Logisk adress" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk adress till tjänsteimplementationen. HSA-id för organisationspost\nmotsvarande vårdgivare i HSA-trädet." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
