       fhir:ElementDefinition.definition [ fhir:value "RIV-specifikation: Bedömt hälsorelaterat tillstånd.tillståndstid. Då detta\nanges i elementet start_time och meddelandet omfattar flera tillstånd\nska det första (i tid mätt) tillståndets tid anges." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
