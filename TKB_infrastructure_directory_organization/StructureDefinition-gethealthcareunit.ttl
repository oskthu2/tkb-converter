       fhir:ElementDefinition.short [ fhir:value "unitIsHealthCareUnit" ] ;
       fhir:ElementDefinition.definition [ fhir:value "True, om enheten (funktionen) själv är en vårdenhet. Om enheten (funktionen) inte är vårdenhet kommer inget värde att returneras. Ref. hjälpklassen Vårdenhet (hsaHealthCareUnit) [R5]" ] ;
