       fhir:ElementDefinition.short [ fhir:value "Textuell beskrivning av beslutsunderlaget" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Varje beslutsunderlag beskrivs i textuell form, som omfattar alla villkor och rekommendationer\nsom omfattas av beslutsunderlag samt annan information som är relevant i beslutsfattandet." ] ;
