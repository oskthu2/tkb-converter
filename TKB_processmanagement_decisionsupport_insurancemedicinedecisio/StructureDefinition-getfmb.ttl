       fhir:ElementDefinition.short [ fhir:value "Giltighetstid — starttid" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Starttid för giltighetstiden. Starttiden skall alltid anges." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "date" ]
       ]
     ], [
       fhir:index 4 ;
