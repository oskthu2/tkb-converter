       fhir:ElementDefinition.path [ fhir:value "getfmb.beslutsunderlag.giltighetstidSlut" ] ;
       fhir:ElementDefinition.short [ fhir:value "Giltighetstid — sluttid" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Sluttid för giltighetstiden. Om sluttid ej anges är beslutsrekommendationen aktiv.\nEtt beslutsunderlag som inte är aktiv skall innehålla ett slutdatum som ligger tidigare\nän aktuellt datum, eller ett startdatum som ligger senare än aktuellt datum." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "date" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "getfmb.beslutsunderlag.version" ] ;
       fhir:ElementDefinition.path [ fhir:value "getfmb.beslutsunderlag.version" ] ;
       fhir:ElementDefinition.short [ fhir:value "Versionsnummer för beslutsunderlaget" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Versionen räknas upp när ett beslutsunderlag förändrats i sin innebörd eller ändrar giltighetstid." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
