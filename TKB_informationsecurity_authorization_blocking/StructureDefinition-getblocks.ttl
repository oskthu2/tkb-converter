       fhir:ElementDefinition.short [ fhir:value "ResultType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Datatyp som returneras som ett generellt svar från alla förändrande tjänster, t.ex. skapa, radera, etc. En tjänstekonsument skall alltid kontrollera att resultatkoden inte innehåller fel för att på så sätt veta om anropet lyckades. Alla svarskoder förutom OK och INFO betyder att åtgärden inte genomfördes." ] ;
