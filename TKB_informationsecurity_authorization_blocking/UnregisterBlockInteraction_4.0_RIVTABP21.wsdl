<wsdl:definitions name='UnregisterBlockInteraction'
    xmlns:wsdl='http://schemas.xmlsoap.org/wsdl/'
    xmlns:soap='http://schemas.xmlsoap.org/wsdl/soap/'
    xmlns:xs='http://www.w3.org/2001/XMLSchema'
    xmlns:tjsr='urn:riv:informationsecurity:authorization:blocking:UnregisterBlockResponder:4'
    xmlns:itr='urn:riv:itintegration:registry:1'
    xmlns:tns='urn:riv:informationsecurity:authorization:blocking:UnregisterBlock:4:rivtabp21'
    targetNamespace='urn:riv:informationsecurity:authorization:blocking:UnregisterBlock:4:rivtabp21'>

    <wsdl:documentation>
         Tjänsteinteraktionens namn: UnregisterBlock
         Beskrivning: 
           Tjänst som avregistrerar/raderar en befintlig spärr i den nationella spärrtjänsten, om spärren finns.
           Tjänsten används för att synkronisera borttag av en lokal spärr till den nationella spärrtjänsten.
           Tjänsten realiseras på nationell nivå.
         Revisioner: 
         Tjänstedomän: informationsecurity:authorization:blocking
         Tjänsteinteraktionstyp: Fråga-Svar
         WS-profil: RIVTABP21
         Förvaltas av: Inera AB
    </wsdl:documentation>
    
    <wsdl:types>
        <xs:schema targetNamespace='urn:riv:informationsecurity:authorization:blocking:UnregisterBlock:4:rivtabp21'>
            <xs:import schemaLocation='UnregisterBlockResponder_4.0.xsd' namespace='urn:riv:informationsecurity:authorization:blocking:UnregisterBlockResponder:4' />
            <xs:import schemaLocation='../../core_components/itintegration_registry_1.0.xsd' namespace='urn:riv:itintegration:registry:1' />
        </xs:schema>
    </wsdl:types>
    
        
    <wsdl:message name='UnregisterBlockRequest'>
        <wsdl:part name='LogicalAddress' element='itr:LogicalAddress'>
            <wsdl:documentation>Som logisk adress anges SE165565594230-1000.</wsdl:documentation>
        </wsdl:part>
    
        <wsdl:part name='parameters' element='tjsr:UnregisterBlock' />
    </wsdl:message>

    <wsdl:message name='UnregisterBlockResponse'>
        <wsdl:part name='parameters' element='tjsr:UnregisterBlockResponse' />
    </wsdl:message>

    <wsdl:portType name='UnregisterBlockResponderInterface'>
        <wsdl:operation name='UnregisterBlock'>
            <wsdl:input message='tns:UnregisterBlockRequest' />
            <wsdl:output message='tns:UnregisterBlockResponse' />
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name='UnregisterBlockResponderBinding' type='tns:UnregisterBlockResponderInterface'>
        <soap:binding style='document' transport='http://schemas.xmlsoap.org/soap/http' />
        <wsdl:operation name='UnregisterBlock'>
            <soap:operation soapAction='urn:riv:informationsecurity:authorization:blocking:UnregisterBlockResponder:4:UnregisterBlock' style='document' />
            <wsdl:input>
                <soap:header use='literal' message='tns:UnregisterBlockRequest' part='LogicalAddress' />
                <soap:body use='literal' parts='parameters' />
            </wsdl:input>
            <wsdl:output>
                <soap:body use='literal' />
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name='UnregisterBlockResponderService'>
        <wsdl:port name='UnregisterBlockResponderPort' binding='tns:UnregisterBlockResponderBinding'>
            <soap:address location='http://tempuri.org' />
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
