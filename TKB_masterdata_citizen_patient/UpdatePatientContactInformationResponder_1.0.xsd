<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="urn:riv:masterdata:citizen:patient:UpdatePatientContactInformationResponder:1"
	xmlns:core="urn:riv:masterdata:citizen:patient:1"
	xmlns:codes="urn:riv:masterdata:citizen:patient:enums:1"
	targetNamespace="urn:riv:masterdata:citizen:patient:UpdatePatientContactInformationResponder:1"
	elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">

	<xs:import schemaLocation="../../core_components/masterdata_citizen_patient_1.0.xsd"
		namespace="urn:riv:masterdata:citizen:patient:1"/>
	<xs:import schemaLocation="../../core_components/masterdata_citizen_patient_enum_1.0.xsd"
		namespace="urn:riv:masterdata:citizen:patient:enums:1"/>

	<xs:element name="UpdatePatientContactInformation"
		type="tns:UpdatePatientContactInformationType"/>
	<xs:element name="UpdatePatientContactInformationResponse"
		type="tns:UpdatePatientContactInformationResponseType"/>

	<xs:complexType name="UpdatePatientContactInformationType">
		<xs:annotation>
			<xs:documentation>
				editor:
					type-fältet skall vara "hsaid" eller "pnr"
					id-fältet skall vara HSA-Id eller personnummer på den person som utför uppdateringen.
				patient: 
					Den patient som kontaktuppgifterna avser
				contactInfos: 
					Patientens egna kontaktuppgifter
				contactPersons:
					Patientens kontaktpersoner, samt telefonnummer till dessa
				version :
					Skall vara samma värde som Patient-entitetens version vid senaste hämtning.
					Används för optimistisk låsning, dvs för att avgöra om någon annan uppdaterat 
					informationen sedan den senast hämtades.
					Då man skapar kontaktinformation för ny patient skall version sättas till 0
					som betyder att det inte finns någon tidigare version. Version 1 kommer att
					skapas.
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="editor" type="core:IIType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="patient" type="core:PatientType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="contactInformation" type="core:ContactInfoType" minOccurs="0"
				maxOccurs="unbounded"/>
			<xs:element name="contactPerson" type="core:ContactPersonType" minOccurs="0"
				maxOccurs="unbounded"/>
			<xs:element name="version" type="xs:long" minOccurs="1" maxOccurs="1"/>
			<xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="UpdatePatientContactInformationResponseType">
		<xs:annotation>
			<xs:documentation>
				message: 
					Meddelande som skall visas upp för användaren vid resultCode INFO eller ERROR
				resultCode:
					OK, INFO eller ERROR
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="message" type="xs:string" minOccurs="0"/>
			<xs:element name="resultCode" type="codes:ResultCodeEnumType" maxOccurs="1"/>
			<xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>



</xs:schema>
