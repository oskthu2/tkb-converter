       fhir:ElementDefinition.short [ fhir:value "type" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remisstyp. Kod och klartext som anger vilken typ av remiss som avses.\n\nAnges med Kv framställantyp [R5]\n\nOID: 1.2.752.129.2.2.2.24\n\nGiltiga värden:\n\n1 = röntgenremiss\n\n2 = labbremiss\n\n4 = allmänremiss\n\nExempel:\n\nrequest.type.codesystem = 1.2.752.129.2.2.2.24\n\nrequest.type.code = 4\n\nrequest.type.displayName = allmänremiss" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../type` (`CVType`, kardinalitet 0..1)." ] ;
