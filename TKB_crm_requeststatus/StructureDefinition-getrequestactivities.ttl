         ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "blockComparisonTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den tidpunkt mot vilken spärrkontroll sker vid åtkomst med syftet sammanhållen journalföring. Gäller både yttre (mellan vårdgivare) och inre (mellan vårdenheter) spärr.\n\nInformationsägaren väljer själv en lämplig tidpunkt, t.ex. tidpunkten då remissen först skickades." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../blockComparisonTime` (`TimeStampType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.blockComparisonTime" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType>
         ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.short [ fhir:value "approvedForPatient" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ansvarig vårdpersonals beslut, alternativt verksamhetens policy och regler (men- och sekretessprövning), huruvida remisstatusen får delas till patient för ändamålet patients åtkomst (Individens direktåtkomst).\n\nOm remisstatusen beslutas delas sätts värdet till true, i annat fall till false. False innebär att uppgiften inte får delas till patient.\n\nNotera att värdet kan, för samma uppgift, förändras med tiden på grund av att rådrumstid har passerats, eller att verksamheten ändrat policy för vad som lämnas ut till patient. I sådana fall skall källsystemet uppdatera engagemangsindex." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../approvedForPatient` (`boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.approvedForPatient" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
