       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.accountableHealthcareProvider" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.accountableHealthcareProvider" ] ;
       fhir:ElementDefinition.short [ fhir:value "accountableHealthcareProvider" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för uppgiftsägande vårdgivare [R11].\n\nI första hand HSA-id, i andra hand organisationsnummer.\n\nOm HSA-id används:\n\nroot sätts till OID för HSA-katalogen (1.2.752.129.2.1.4.1)\n\nextension sätts till HSA-id\n\nOm organisationsnummer används:\n\nroot sätts till OID för organisationsnummer (1.2.752.29.4.3)\n\nextension sätts till organisationsnumret. Enskild näringsidkare har i rollen som juridisk person sitt personnummer som organisationsnummer.\n\nRegel 2.1" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../accountableHealthcareProvider` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.accountableCareUnit" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.accountableCareUnit" ] ;
       fhir:ElementDefinition.short [ fhir:value "accountableCareUnit" ] ;
       fhir:ElementDefinition.definition [ fhir:value "HSA-id för vårdenheten [R11] där uppgiften är dokumenterad.\n\nroot sätts till OID för HSA-katalogen (1.2.752.129.2.1.4.1)\n\nextension sätts till HSA-id\n\nRegel 2.1" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../accountableCareUnit` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.originalPatientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.originalPatientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "originalPatientId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Personidentifieraren som den tillgängliggjorda remisstatusen lagrades under då den skapades. Detta fält anges endast då det skiljer sig från patientId, exempelvis då patienten tidigare erhållit vård som dokumenterats under ett samordningsnummer för att sedan bli folkbokförd i Sverige och få ett personnummer.\n\nroot sätts till OID för typ av personidentifierare.\n\nFör personnummer ska Skatteverkets OID för personnummer (1.2.752.129.2.1.3.1) användas.\n\nFör samordningsnummer skall Skatteverkets OID för samordningsnummer (1.2.752.129.2.1.3.3) användas.\n\nFör andra typer av personidentifierare sätts root till aktuell OID.\n\nextension sätts till patientens identifierare. Anges med 12 tecken utan avskiljare." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../originalPatientId` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.careProcessId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.careProcessId" ] ;
       fhir:ElementDefinition.short [ fhir:value "careProcessId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för den individanpassade vårdprocess som remisstatusen journalförts inom ramen för. Består av ett lokalt genererat UUID.\n\nroot sätts till UUID\n\nextension anges ej" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../careProcessId` (`IIType`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.lockTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.lockTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "lockTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ska ej användas!\n\nRegel 2.2" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../lockTime` (`TimeStampType`, kardinalitet 0..0)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType>
         ]
       ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.blockComparisonTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "blockComparisonTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den tidpunkt mot vilken spärrkontroll sker vid åtkomst med syftet sammanhållen journalföring. Gäller både yttre (mellan vårdgivare) och inre (mellan vårdenheter) spärr.\n\nInformationsägaren väljer själv en lämplig tidpunkt, t.ex. tidpunkten då remissen först skickades." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../blockComparisonTime` (`TimeStampType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType>
         ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader.approvedForPatient" ] ;
       fhir:ElementDefinition.short [ fhir:value "approvedForPatient" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ansvarig vårdpersonals beslut, alternativt verksamhetens policy och regler (men- och sekretessprövning), huruvida remisstatusen får delas till patient för ändamålet patients åtkomst (Individens direktåtkomst).\n\nOm remisstatusen beslutas delas sätts värdet till true, i annat fall till false. False innebär att uppgiften inte får delas till patient.\n\nNotera att värdet kan, för samma uppgift, förändras med tiden på grund av att rådrumstid har passerats, eller att verksamheten ändrat policy för vad som lämnas ut till patient. I sådana fall skall källsystemet uppdatera engagemangsindex." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../approvedForPatient` (`boolean`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.sourceSystemId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.sourceSystemId" ] ;
       fhir:ElementDefinition.short [ fhir:value "sourceSystemId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Det källsystem som remisstatusen lagras i.\n\nroot sätts till OID för HSA-katalogen (1.2.752.129.2.1.4.1)\n\nextension sätts till källsystemets HSA-id" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../sourceSystemId` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.record" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.record" ] ;
       fhir:ElementDefinition.short [ fhir:value "RecordType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information avseende remisstatusen som tillgängliggörs." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../record` (`RecordType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 13 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.record.id" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.record.id" ] ;
       fhir:ElementDefinition.short [ fhir:value "id" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Identifierare för remisstatus.\n\nIdentifieraren ska vara konsistent och beständig mellan olika majorversioner av ett tjänstekontrakt. Detta för att en tjänstekonsument ska kunna ta bort dubbletter från de tjänsteproducenter som producerar via flera majorversioner. Ett exempel på detta är att en vårdkontakt ska ha samma identifierare i majorversion 3 och 4 av ett tjänstekontrakt för att läsa vårdkontakter.\n\nIdentifieraren ska även vara konsistent och beständig mellan olika tjänstekontrakt. Ett exempel på detta är att samma remiss-identitet ska användas i ett tjänstekontrakt för att läsa remisser, samt tjänstekontraktet som läser remissvar som refererar till den ursprungliga remissen.\n\nRoot sätts till systemHSA-id\n\nExtension sätts till id för remissen" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../id` (`IIType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/IIType" ]
       ]
     ], [
       fhir:index 14 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.record.timestamp" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.record.timestamp" ] ;
       fhir:ElementDefinition.short [ fhir:value "timestamp" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den tidpunkt då remisstatusen skapades i tjänsteproducentens källsystem." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../timestamp` (`TimeStampType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType" ;
           fhir:index 0 ;
           fhir:link <https://fhir.inera.se/ig/rivta-datatypes/StructureDefinition/TimeStampType>
         ]
       ]
     ], [
       fhir:index 15 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.author" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.author" ] ;
       fhir:ElementDefinition.short [ fhir:value "AuthorType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information avseende dokumentation av remisstatus som tillgängliggörs.\n\nNotera att den som registrerar uppgiften från annan källa, exempelvis en medicinsk sekreterare som transkriberar ett diktat, inte avses." ] ;
