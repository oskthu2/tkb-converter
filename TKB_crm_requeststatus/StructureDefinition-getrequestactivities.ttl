       fhir:ElementDefinition.short [ fhir:value "medium" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Medium. Kod och klartext som anger medium för remissen.\n\nAnges med Kv Form av framställan [R5]\n\nOID: 1.2.752.129.2.2.2.7\n\nGiltiga värden:\n\n3 = skriftligt elektroniskt\n\n4 = skriftligt papper\n\nExempel:\n\nmedium.codesystem = 1.2.752.129.2.2.2.7\n\nmedium.code = 3\n\nmedium.displayName = skriftligt elektroniskt" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../medium` (`CVType`, kardinalitet 0..1)." ] ;
