       fhir:ElementDefinition.short [ fhir:value "Uppgiftsägande vårdgivare" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id för uppgiftsägande vårdgivare. I första hand HSA-id, i andra hand organisationsnummer.\nOm HSA-id: root = 1.2.752.129.2.1.4.1, extension = HSA-id.\nOm org.nr: root = 1.2.752.29.4.3, extension = organisationsnumret.\nRegel 2.1: Krävs för spärrhantering, åtkomstkontroll och loggning (PDL)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
