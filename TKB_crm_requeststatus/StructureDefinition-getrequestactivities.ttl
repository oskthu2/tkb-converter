       fhir:ElementDefinition.short [ fhir:value "byRole" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information om hälso- och sjukvårdspersonalens befattning så som den var angiven i HSA-katalogen vid dokumentationstidpunkten.\n\nAnges med HSAs kodverk Befattning (OID: 1.2.752.129.2.2.1.4).\n\nOm kod inte är tillgänglig anges befattning som klartext i datatypens attribut originalText." ] ;
