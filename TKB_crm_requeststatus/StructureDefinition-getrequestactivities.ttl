  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "getrequestactivities" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities" ] ;
       fhir:ElementDefinition.short [ fhir:value "GetRequestActivities" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Logisk modell för tjänstekontraktet GetRequestActivities\n(RIV-TA urn:riv:crm:requeststatus:GetRequestActivities:2).\nRepresenterar responsens informationsstruktur — en lista med statusrader för en patients remisser." ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity" ] ;
       fhir:ElementDefinition.short [ fhir:value "RequestActivityType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Remisstatus som matchar begäran" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `requestActivity` (`RequestActivityType`, kardinalitet 0..*)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header" ] ;
       fhir:ElementDefinition.short [ fhir:value "HeaderType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Innehåller information som är gemensam för remisstatusen som tillgängliggörs, exempelvis information om vilken hälso- och sjukvårdspersonal som är angiven som författare av en remisstatus samt information om signering." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../header` (`HeaderType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader" ] ;
       fhir:ElementDefinition.path [ fhir:value "getrequestactivities.requestActivity.header.accessControlHeader" ] ;
       fhir:ElementDefinition.short [ fhir:value "AccessControlHeaderType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Information som används för kontroll av åtkomst." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../accessControlHeader` (`AccessControlHeaderType`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
