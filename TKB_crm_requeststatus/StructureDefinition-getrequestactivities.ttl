       fhir:ElementDefinition.short [ fhir:value "Vårdenhet" ] ;
       fhir:ElementDefinition.definition [ fhir:value "HSA-id för vårdenhet där uppgiften är dokumenterad.\nroot = 1.2.752.129.2.1.4.1 (HSA OID), extension = HSA-id.\nRegel 2.1: Krävs för PDL-hantering." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
