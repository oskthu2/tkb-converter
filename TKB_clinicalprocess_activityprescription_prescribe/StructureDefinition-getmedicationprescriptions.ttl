     ], [
       fhir:index 36 ;
       fhir:Element.id [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.writeTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.writeTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "writeTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tidpunkt då det medicinska beslutet fattades.\n\nNormalfallet bör vara att Läkemedelsordinationen registreras i NOD i samband med att beslutet fattas varvid ordinationstidpunkt och registreringstidpunkt kommer att vara lika (sånär som på den tid det tar att genomföra tjänsteanropet).\n\nI vissa fall kommer de dock att skilja sig åt, t.ex. då en ordination som finns i ett vårdsystem och efterregistreras i NOD, eller då en ordination återskapas baserat på information från ett NEF-recept. I dessa fall skall ordinationstidpunkt, så gott det går, sättas till den tidpunkt då ordinationen ursprungligen skapades." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../writeTime` (`dateTime`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.writeTime" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
