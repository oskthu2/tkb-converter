     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "getmedicationprescriptions.medicationList.patientId" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.patientId" ] ;
       fhir:ElementDefinition.short [ fhir:value "patientId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Identifiering av patienten.\n\nPatienter i NOD identifieras initialt med svenskt personnummer och samordningsnummer. På sikt kommer även andra typer av identitet att kunna användas, i första hand reservnummer och katastrofnummer.\n\nAttributet system i datatypen Identifier (från FHIR) anger vilken typ av identifiering som används, dvs. om det t.ex. är personnummer eller samordningsnummer.\n\nVid enbart förskrivning, vilket är möjligt för patienter utan personnummer, används istället klassen Patientinformation." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../patientId` (`Identifier`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ]
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "getmedicationprescriptions.medicationList.version" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.version" ] ;
       fhir:ElementDefinition.short [ fhir:value "version" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Version på patientens samlade läkemedelslista.\n\nÄndras av NOD vid varje förändring i någon av de ingående Läkemedelsbehandlingarna dvs. då en ny Läkemedelsordination eller ett nytt Expedieringsunderlag kopplat till en Läkemedelsbehandling registreras.\n\nDäremot medför inte statusförändringar kopplade till ett Expedieringsunderlag eller expediering av läkemedel att underlagsversion ändras. Ej heller registrering av lösa Expedieringsunderlag, dvs sådana som ej är kopplade till en Läkemedelsbehandling\n\nSyftet med underlagsversion är att vårdsystemet ska kunna säkerställa att det har rätt underlag vid ordination.\n\nVårdsystemet ska inte basera någon logik på underlagsversionens format, utan endast på kontroll av likhet.\n\nDet bör noteras att underlagsversion alltid baseras på patientens samlade läkemedelslista, oberoende av eventuella urvalskriterier." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../version` (`Identifier`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ]
       ]
     ], [
