       fhir:ElementDefinition.short [ fhir:value "tradeName" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Namn vid det tillfälle då ordinationen upprättades. Hämtas från SIL och sparas i NOD för att spårbarheten ska behållas även om benämningen ändras över tid.\n\nMöjlighet att utnyttja detta fält för \"fritextordination\" måste testas (t.ex. för studieläkemedel eller \"okänt läkemedel\")." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../../../tradeName` (`string`, kardinalitet 1)." ] ;
