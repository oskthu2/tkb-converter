       fhir:ElementDefinition.short [ fhir:value "HealthcareProfessionalType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den person som registrerat det omgivande objektet. Denna måste vara starkt autentiserad och det är informationen från autentiseringen som används. Det är vårdgivare och vårdenhet för registrerad av som utgör vårdgivare och vårdenhet för det omgivande objektet som helhet.\n\nVärdet sätts av NOD baserat på den Autentiseringsinformation som bifogas vid anrop av NOD:s tjänster." ] ;
