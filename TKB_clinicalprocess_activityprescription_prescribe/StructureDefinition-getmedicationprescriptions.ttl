       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.treamentReason.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "code" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vid användning som ordinationsorsak ska Snomed CT-koden för vald ordinationsorsak anges.\n\nAnges enligt Socialstyrelsens kodsystem för ordinationsorsaker (NKOO)." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../../code` (`CodeableConcept`, kardinalitet 1).\n\n**Modellanteckning:** Vid användning som ordinationsorsak ska Snomed CT-koden för vald ordinationsorsak anges. Anges enligt Socialstyrelsens kodsystem för ordinationsorsaker (NKOO). Om ordinationsorsak anges till Annan orsak är det obligatorisk att ange orsaken som fritext (i fältet CodeableConcept.text) i annat fall ska fritext inte anges." ] ;
