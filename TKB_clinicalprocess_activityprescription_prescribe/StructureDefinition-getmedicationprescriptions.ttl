       fhir:ElementDefinition.short [ fhir:value "revocationComment" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Fritextbeskrivning som preciserar makuleringsorsak som angivits som \"annan orsak\".\n\nObligatorisk parameter för Orsakskod = 4\n\nFår ej anges för Orsakskod = 1, 2 eller 3." ] ;
