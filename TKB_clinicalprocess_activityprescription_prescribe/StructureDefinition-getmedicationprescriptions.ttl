       fhir:ElementDefinition.short [ fhir:value "MedicationDispenseCase" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Expedieringsärenden inom den pågående Läkemedelsbehandlingen. Exakt vilka beror på hur urvalet sker i NOD-tjänsterna.\n\nExpedieringsärendena är inte en del av Läkemedelsbehandlingen i formell mening, dvs. inte ett äkta aggregat. Ändringar i Expedieringsärendena påverkar inte heller underlagsversionen för läkemedelslistan." ] ;
