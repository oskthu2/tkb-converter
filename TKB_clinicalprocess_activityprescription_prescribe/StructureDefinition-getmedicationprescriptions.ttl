       fhir:ElementDefinition.short [ fhir:value "Behandlingsändamål i klartext.Ingår i Expedieringsunderlag som Ändamål klartext" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Behandlingsändamål i klartext.\n\nIngår i Expedieringsunderlag som Ändamål klartext" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../purpose` (`string`, kardinalitet 0..1)." ] ;
