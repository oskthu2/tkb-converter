     ], [
       fhir:index 664 ;
       fhir:Element.id [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForPackage-attr.prescriber.personalPrescriptionCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForPackage_attr.prescriber.personalPrescriptionCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "personalPrescriptionCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens individuella förskrivarkod (7 tecken), legitimationskod (6 tecken) eller förskrivarens gruppförskrivarkod då individuell kod saknas. Obligatorisk parameter om teknisk sprit eller läkemedel förskrivs.Gruppförskrivarkod används då förskrivaren saknar individuell förskrivarkod men via sin roll har erhållit förskrivningsrätt. Kan exempelvis vara en AT-läkare eller förskrivare med förordnande. Förskrivarkoden definieras av Socialstyrelsen och gruppförskrivarkoden definieras av EHM.För användare som har gruppförskrivarkod gäller:befattningskod är obligatorisk För läkare (LK) - yrkeskod (dvs LK) är obligatorisk.Vid övriga yrken – yrkeskod och giltig legitimationskod är obligatoriskaValideras i AFFHSA: förskrivarkod, även kallat personalPrescriptionCode RR: förskrivarkod" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForPackage_attr.prescriber.personalPrescriptionCode" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 665 ;
       fhir:Element.id [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForPackage-attr.prescriber.legitimationCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForPackage_attr.prescriber.legitimationCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "legitimationCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens 7-ställiga förskrivarkod alternativt 6-ställiga legitimationskod. Legitimationskod för förskrivare är annars de 6 första siffrorna i förskrivarkoden.Se gruppförskrivarkod för villkor.HSA: Legitimationskod för leg.vårdpersonal (sjuksköterskor) saknas i HSA. Det finns grupplegitimationskoder som kan användas.yrkeskodGruppkodyrkeskod klartextSJ971000SjuksköterskaAP972000ApotekareRC973000ReceptarieRR: legitimationskod" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
