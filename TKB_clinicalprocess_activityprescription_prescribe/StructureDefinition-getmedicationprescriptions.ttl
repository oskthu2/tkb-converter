         fhir:ElementDefinition.base.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForPackage_attr.prescriber.legitimationCode" ] ;
