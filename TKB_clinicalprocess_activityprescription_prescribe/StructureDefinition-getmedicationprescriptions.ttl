     ], [
       fhir:index 47 ;
       fhir:Element.id [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.reason" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.reason" ] ;
       fhir:ElementDefinition.short [ fhir:value "Reason" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Orsaken till beslutet.\n\nSyftet är att ordinatören ska kunna ange orsak till en ändring av en läkemedelsbehandling, t.ex. ändring av doseringen, byte av läkemedelsfabrikat eller utsättning av andra skäl än planerad utsättning. Fältet ska inte förväxlas med ordinationsorsak som avser den orsaken till behandlingen som helhet. Tillsammans med ordinationsorsak kommer samtliga beslutsorsaker att utgöra en slags läkemedelsjournal för läkemedelsbehandlingen.\n\nFältet ingår inte i Expedieringsunderlag och kan t.ex. inte skrivas ut på etiketten vid expediering.\n\nVid makulering av expedieringsunderlag härleds dock expedieringsunderlagets makuleringsorsak (1-4) från beslutsorsak." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../reason` (`Reason`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 48 ;
       fhir:Element.id [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.reason.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.reason.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "code" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vid användning som ordinationsorsak ska Snomed CT-koden för vald ordinationsorsak anges.\n\nAnges enligt Socialstyrelsens kodsystem för ordinationsorsaker (NKOO)." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../../code` (`CodeableConcept`, kardinalitet 1).\n\n**Modellanteckning:** Vid användning som ordinationsorsak ska Snomed CT-koden för vald ordinationsorsak anges. Anges enligt Socialstyrelsens kodsystem för ordinationsorsaker (NKOO). Om ordinationsorsak anges till Annan orsak är det obligatorisk att ange orsaken som fritext (i fältet CodeableConcept.text) i annat fall ska fritext inte anges." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "CodeableConcept" ]
       ]
     ], [
       fhir:index 49 ;
       fhir:Element.id [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.reason.primaryReason" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.medicationPrescriptionSequences.medicationPrescriptions.reason.primaryReason" ] ;
       fhir:ElementDefinition.short [ fhir:value "Uppgift om huruvida orsaken är ”huvudorsak”, dvs. viktigare än andra angivna orsaker" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Uppgift om huruvida orsaken är \"huvudorsak\", dvs. viktigare än andra angivna orsaker" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../../primaryReason` (`boolean`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
