       fhir:ElementDefinition.short [ fhir:value "HSA-id för den vårdgivare (enligt PDL) som personen är uppdragstagare för." ] ;
       fhir:ElementDefinition.definition [ fhir:value "HSA-id för den vårdgivare (enligt PDL) som personen är uppdragstagare för." ] ;
