       fhir:ElementDefinition.path [ fhir:value "getmedicationprescriptions.medicationList.lastModified" ] ;
       fhir:ElementDefinition.short [ fhir:value "Tidpunkt för senaste ändring i läkemedelslistan. Ändras samtidigt med underlagsversion." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tidpunkt för senaste ändring i läkemedelslistan. Ändras samtidigt med underlagsversion." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../lastModified` (`dateTime`, kardinalitet 1)." ] ;
