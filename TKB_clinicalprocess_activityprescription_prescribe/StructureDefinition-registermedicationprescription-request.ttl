       fhir:ElementDefinition.path [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.purpose" ] ;
       fhir:ElementDefinition.short [ fhir:value "Behandlingsändamål i klartext.Ingår i Expedieringsunderlag som Ändamål klartext" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Behandlingsändamål i klartext.Ingår i Expedieringsunderlag som Ändamål klartext" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
