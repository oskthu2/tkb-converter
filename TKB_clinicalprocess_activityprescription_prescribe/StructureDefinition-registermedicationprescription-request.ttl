     ], [
       fhir:index 597 ;
       fhir:Element.id [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.treamentReason" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.treamentReason" ] ;
       fhir:ElementDefinition.short [ fhir:value "Reason" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ordinationsorsak enligt separat struktur.Det bör påpekas att ordinationsorsak (i förekommande fall) ska anges av vårdsystemet för ny instans av Läkemedelsordination inom samma läkemedelsbehandling. Principen att det senast beslutet ska innehålla en komplett beskrivning av den pågående läkemedelsbehandlingen gäller även här. Även vid utsättning ska följaktligen ordinationsorsak anges.Även om det är ovanligt att ordinationsorsaken ändras inom en läkemedelsbehandling så finns det inget hinder (i modellen) för detta.Om ordinationsorsak anges ska minst en, eventuellt flera, anges som huvudorsak. Ordinationsorsak får inte överföras till receptregistret eller finnas på recept/expedieringsunderlag.Se även not 4." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 598 ;
       fhir:Element.id [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.treamentReason.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.treamentReason.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "code" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vid användning som ordinationsorsak ska Snomed CT-koden för vald ordinationsorsak anges. Anges enligt Socialstyrelsens kodsystem för ordinationsorsaker (NKOO). Om ordinationsorsak anges till Annan orsak är det obligatorisk att ange orsaken som fritext (i fältet CodeableConcept.text) i annat fall ska fritext inte anges." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
