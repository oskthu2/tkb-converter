         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "dateTime" ]
       ]
     ], [
       fhir:index 80 ;
       fhir:Element.id [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.evaluationTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.evaluationTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "evaluationTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tidpunkt då läkemedelsbehandlingen senast bör utvärderas. Tidpunkten får, om den anges, inte vara före insättningstidpunkt.Syftet är t.ex. att vårdsystemen ska kunna uppmärksamma ansvarig ordinatör när utvärderingstidpunkten närmar sig." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
