         fhir:ElementDefinition.base.path [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.writeTime" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "dateTime" ]
       ]
     ], [
       fhir:index 78 ;
       fhir:Element.id [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.treatmentStartTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.treatmentStartTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "treatmentStartTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tidpunkt från vilken patienten ska ta sitt läkemedel.insättningstidpunkt utgör startpunkt för angiven dosering.Vid utsättning ska insättningstidpunkt sättas till samma som utsättningstidpunkt." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.treatmentStartTime" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
