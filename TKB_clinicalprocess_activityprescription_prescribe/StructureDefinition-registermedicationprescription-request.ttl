       fhir:ElementDefinition.path [ fhir:value "registermedicationprescription-request.medicationPrescriptionList.medicationPrescription.medication.DistributedDrug_attr" ] ;
       fhir:ElementDefinition.short [ fhir:value "DistributedDrug" ] ;
       fhir:ElementDefinition.definition [ fhir:value "DistributedDrug_attr" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
