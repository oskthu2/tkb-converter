       fhir:ElementDefinition.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber" ] ;
       fhir:ElementDefinition.short [ fhir:value "MedicalPrescriber" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens namn, yrke, specialiteter och arbetsplats (Krav på presentation i handboken)" ] ;
