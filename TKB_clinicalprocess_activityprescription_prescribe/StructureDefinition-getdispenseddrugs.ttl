       fhir:ElementDefinition.short [ fhir:value "Förskrivarens specialiteter i klartext. Fylls i av NOD vid läsning från LF. Krav vid presentation." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens specialiteter i klartext.\n\nFylls i av NOD vid läsning från LF. Krav vid presentation." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../speciallityCodes` (`string`, kardinalitet 0..*)." ] ;
