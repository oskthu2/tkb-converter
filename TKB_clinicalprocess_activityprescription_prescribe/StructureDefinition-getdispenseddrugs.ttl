     ], [
       fhir:index 19 ;
       fhir:Element.id [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.personalPrescriptionCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.personalPrescriptionCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "personalPrescriptionCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens individuella förskrivarkod (7 tecken), legitimationskod (6 tecken) eller förskrivarens gruppförskrivarkod då individuell kod saknas.\n\nObligatorisk parameter om teknisk sprit eller läkemedel förskrivs.\n\nGruppförskrivarkod används då förskrivaren saknar individuell förskrivarkod men via sin roll har erhållit förskrivningsrätt. Kan exempelvis vara en AT-läkare eller förskrivare med förordnande. Förskrivarkoden definieras av Socialstyrelsen och gruppförskrivarkoden definieras av EHM.\n\nFör användare som har gruppförskrivarkod gäller:\n\nbefattningskod är obligatorisk\n\nFör läkare (LK) - yrkeskod (dvs LK) är obligatorisk.\n\nVid övriga yrken - yrkeskod och giltig legitimationskod är obligatoriska\n\nValideras i AFF\n\nHSA: förskrivarkod, även kallat personalPrescriptionCode\n\nRR: förskrivarkod" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../personalPrescriptionCode` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.personalPrescriptionCode" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 20 ;
       fhir:Element.id [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.legitimationCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.legitimationCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "legitimationCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens 7-ställiga förskrivarkod alternativt 6-ställiga legitimationskod. Legitimationskod för förskrivare är annars de 6 första siffrorna i förskrivarkoden.\n\nSe gruppförskrivarkod för villkor.\n\nHSA: Legitimationskod för leg.vårdpersonal (sjuksköterskor) saknas i HSA. Det finns grupplegitimationskoder som kan användas.\n\nyrkeskod	Gruppkod	yrkeskod klartext\n\nSJ	971000	Sjuksköterska\n\nAP	972000	Apotekare\n\nRC	973000	Receptarie\n\nRR: legitimationskod" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../legitimationCode` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.legitimationCode" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 21 ;
       fhir:Element.id [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.hsaTitleCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.hsaTitleCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "hsaTitleCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Yrkeskod som definierar vilken typ av legitimation som användaren innehar.\n\nSe gruppförskrivarkod för villkor.\n\nKontrolleras i receptregistret att personen har angiven yrkeskod.\n\nValideras i AFF\n\nHSA:Legitimerad yrkesgrupp, även kallad hsaTitle innehåller yrkeskoden i klartext. Detta fält (yrkeskod) avser dock motsvarande tvåställiga kod. Se:\"HSA Innehåll Legitimerad Yrkesgrupp\" på se www.inera.se/hsa.\n\nNotera också att samma användare kan inneha flera yrkesgrupper, t.ex. både Läkare och Sjuksköterska.\n\nRR: yrkeskod" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../hsaTitleCode` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.hsaTitleCode" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 22 ;
