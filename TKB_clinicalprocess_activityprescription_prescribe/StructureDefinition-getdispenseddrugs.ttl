     ], [
       fhir:index 27 ;
       fhir:Element.id [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.placeOfWork" ] ;
       fhir:ElementDefinition.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.placeOfWork" ] ;
       fhir:ElementDefinition.short [ fhir:value "PlaceOfWork" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Arbetsplats" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `placeOfWork` (`PlaceOfWork`, kardinalitet 1..1).\n\nObs: modellen anger 0..1 där TKB:n anger 1..1." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
