       fhir:ElementDefinition.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.familyName" ] ;
       fhir:ElementDefinition.short [ fhir:value "Förskrivarens efternamn.Valideras i AFF HSA: efternamnRR: efternamn" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens efternamn.\n\nValideras i AFF\n\nHSA: efternamn\n\nRR: efternamn" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../familyName` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
