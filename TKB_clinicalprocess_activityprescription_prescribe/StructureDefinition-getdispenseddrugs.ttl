       fhir:ElementDefinition.short [ fhir:value "Förskrivarens tilltalsnamn.HSA: tilltalsnamn (givenName)RR: förnamn" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens tilltalsnamn.\n\nHSA: tilltalsnamn (givenName)\n\nRR: förnamn" ] ;
