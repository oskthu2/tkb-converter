       fhir:ElementDefinition.path [ fhir:value "getdispenseddrugs.dispensedDrugs.presciber.paTitleCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "paTitleCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens befattningskod.\n\nSe gruppförskrivarkod för villkor.\n\nHSA: befattningskod, även kallat paTitleCode.\n\nNotera också att samma användare kan inneha flera befattningskoder.\n\nRR: befattningskod" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../paTitleCode` (`string`, kardinalitet 0..1)." ] ;
