       fhir:ElementDefinition.short [ fhir:value "revocationCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "1 = Fel patient2 = Fel läkemedel/vara /dosering/styrka/ändamål. Patienten informerad3 = Utsatt lm/Inaktuell medicinering. Patienten informerad4 = Annan orsak. Patienten informerad{1,2,3,4}Se även Läkemedelsordination.utsättningsorsak Tillåtna värden: 1, 2, 3, 4." ] ;
