         fhir:ElementDefinition.base.path [ fhir:value "getmedicationdispenseauthorizations.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForDoseDispensing_attr.prescriber.legitimationCode" ] ;
