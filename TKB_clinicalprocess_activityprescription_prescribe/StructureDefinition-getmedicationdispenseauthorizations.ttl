       fhir:Element.id [ fhir:value "getmedicationdispenseauthorizations.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForPackage-attr.prescriber" ] ;
       fhir:ElementDefinition.path [ fhir:value "getmedicationdispenseauthorizations.medicationDispenseCase.medicationDispenseAuthorizations.MedicationDispenseAuthorizationForPackage_attr.prescriber" ] ;
       fhir:ElementDefinition.short [ fhir:value "MedicalPrescriber" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Sätts av NOD-tjänsten till inloggad användare (samma som registrerad av) för att säkerställa att förskrivaren är starkt autentiserad." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
