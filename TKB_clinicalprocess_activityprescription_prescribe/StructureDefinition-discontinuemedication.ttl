         fhir:ElementDefinition.type.code [ fhir:value "dateTime" ]
       ]
     ], [
       fhir:index 29 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.treatmentStartTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.treatmentStartTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "treatmentStartTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tidpunkt från vilken patienten ska ta sitt läkemedel.\n\ninsättningstidpunkt utgör startpunkt för angiven dosering.\n\nVid utsättning ska insättningstidpunkt sättas till samma som utsättningstidpunkt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../ treatmentStartTime` (`dateTime`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "discontinuemedication.medicationPrescription.treatmentStartTime" ] ;
