       ]
     ], [
       fhir:index 30 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.treatmentEndTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.treatmentEndTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "treatmentEndTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Om utsättning sker i framtiden så måste denna skickas med, och går endast att använda för att förkorta en behandling." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `treatmentEndTime` (`dateTime`, kardinalitet 0..1).\n\n**Modellanteckning:** Planerad tidpunkt vid vilken patienten ska upphöra att ta sitt läkemedel.Det är utsättningstidpunkten i den gällande Läkemedelsordinationen som är styrande för om läkemedelsbehandlingen är avlutad.Om attributet inte anges innebär det att läkemedelsbehandlingen ska pågå tills vidare. Tidpunkten får, om den anges, inte vara före insättningstidpunkt." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
