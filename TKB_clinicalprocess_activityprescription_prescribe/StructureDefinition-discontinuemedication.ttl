     ], [
       fhir:index 28 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.writeTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.writeTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "writeTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tidpunkt då det medicinska beslutet fattades." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `writeTime` (`dateTime`, kardinalitet 0..1).\n\nObs: modellen anger 1..1 där TKB:n anger 0..1.\n\n**Modellanteckning:** Tidpunkt då det medicinska beslutet fattades. Normalfallet bör vara att Läkemedelsordinationen registreras i NOD i samband med att beslutet fattas varvid ordinationstidpunkt och registreringstidpunkt kommer att vara lika (sånär som på den tid det tar att genomföra tjänsteanropet). I vissa fall kommer de dock att skilja sig åt, t.ex. då en ordination som finns i ett vårdsystem och efterregistreras i NOD, eller då en ordination återskapas baserat på information från ett NEF-recept. I dessa fall skall ordinationstidpunkt, så gott det går, sättas till den tidpunkt då ordinationen ursprungligen skapades." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "dateTime" ]
       ]
     ], [
       fhir:index 29 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.treatmentStartTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.treatmentStartTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "treatmentStartTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tidpunkt från vilken patienten ska ta sitt läkemedel.\n\ninsättningstidpunkt utgör startpunkt för angiven dosering.\n\nVid utsättning ska insättningstidpunkt sättas till samma som utsättningstidpunkt." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../ treatmentStartTime` (`dateTime`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "dateTime" ]
       ]
     ], [
       fhir:index 30 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.treatmentEndTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.treatmentEndTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "treatmentEndTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Om utsättning sker i framtiden så måste denna skickas med, och går endast att använda för att förkorta en behandling." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `treatmentEndTime` (`dateTime`, kardinalitet 0..1).\n\n**Modellanteckning:** Planerad tidpunkt vid vilken patienten ska upphöra att ta sitt läkemedel.Det är utsättningstidpunkten i den gällande Läkemedelsordinationen som är styrande för om läkemedelsbehandlingen är avlutad.Om attributet inte anges innebär det att läkemedelsbehandlingen ska pågå tills vidare. Tidpunkten får, om den anges, inte vara före insättningstidpunkt." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "dateTime" ]
       ]
     ], [
       fhir:index 31 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.evaluationTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.evaluationTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "evaluationTime" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tidpunkt då läkemedelsbehandlingen senast bör utvärderas.\n\nTidpunkten får, om den anges, inte vara före insättningstidpunkt.\n\nSyftet är t.ex. att vårdsystemen ska kunna uppmärksamma ansvarig ordinatör när utvärderingstidpunkten närmar sig." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../evaluationTime` (`dateTime`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
