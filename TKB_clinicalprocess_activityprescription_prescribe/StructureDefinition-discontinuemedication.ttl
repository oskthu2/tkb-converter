       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.dosage.dosageSteps.regularDosage.DosageByOccasion-attr.occasions.dayInPeriod" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.dosage.dosageSteps.regularDosage.DosageByOccasion_attr.occasions.dayInPeriod" ] ;
       fhir:ElementDefinition.short [ fhir:value "dayInPeriod" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Dag i perioden när intag skall ske. Exempel: Intag ska ske varje måndag och onsdag och startdatum är på en måndag. Måndag Insättningsdatum = 2010-01-01 Periodlängd = 7 Dag i period = 1 Onsdag Insättningsdatum = 2010-01-01 Periodlängd = 7 Dag i period = 3 dag i period <= Tillfällesdosering.periodlängd" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
