     ], [
       fhir:index 39 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.reason" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.reason" ] ;
       fhir:ElementDefinition.short [ fhir:value "Reason" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Utsättningsorsak i kodad form." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `reason` (`Reason`, kardinalitet 1..*).\n\nObs: modellen anger 0..1 där TKB:n anger 1..*.\n\n**Modellanteckning:** Orsaken till beslutet.Syftet är att ordinatören ska kunna ange orsak till en ändring av en läkemedelsbehandling, t.ex. ändring av doseringen, byte av läkemedelsfabrikat eller utsättning av andra skäl än planerad utsättning. Fältet ska inte förväxlas med ordinationsorsak som avser den orsaken till behandlingen som helhet. Tillsammans med ordinationsorsak kommer samtliga beslutsorsaker att utgöra en slags läkemedelsjournal för läkemedelsbehandlingen.Fältet ingår inte i Expedieringsunderlag och kan t.ex. inte skrivas ut på etiketten vid expediering. Vid makulering av expedieringsunderlag härleds dock expedieringsunderlagets makuleringsorsak (1-4) från beslutsorsak." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 40 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.reason.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.reason.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "code" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Vid användning som ordinationsorsak ska Snomed CT-koden för vald ordinationsorsak anges.\n\nAnges enligt Socialstyrelsens kodsystem för ordinationsorsaker (NKOO)." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../code` (`CodeableConcept`, kardinalitet 1).\n\n**Modellanteckning:** Vid användning som ordinationsorsak ska Snomed CT-koden för vald ordinationsorsak anges. Anges enligt Socialstyrelsens kodsystem för ordinationsorsaker (NKOO). Om ordinationsorsak anges till Annan orsak är det obligatorisk att ange orsaken som fritext (i fältet CodeableConcept.text) i annat fall ska fritext inte anges." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "CodeableConcept" ]
       ]
     ], [
       fhir:index 41 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.reason.primaryReason" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.reason.primaryReason" ] ;
       fhir:ElementDefinition.short [ fhir:value "Uppgift om huruvida orsaken är ”huvudorsak”, dvs. viktigare än andra angivna orsaker" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Uppgift om huruvida orsaken är \"huvudorsak\", dvs. viktigare än andra angivna orsaker" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../primaryReason` (`boolean`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 42 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.annotation" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.annotation" ] ;
       fhir:ElementDefinition.short [ fhir:value "annotation" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ordinatörens kommentarer i fritext kopplade till en specifik ordination.\n\nSyftet är t.ex. att ordinatören i fritext ska kunna ange sådant som inte framgår av beslutsorsak eller ordinationsorsak och som är av intresse för annan vård- och omsorgspersonal.\n\nFältet är avsett att beskriva nuläget för läkemedelsbehandlingen utan att användaren ska behöva ta del av notatfältet i tidigare läkemedelsordinationer.\n\nFältet ingår inte i Expedieringsunderlag och kan t.ex. inte skrivas ut på etiketten vid expediering." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../annotation` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 43 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.use" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.use" ] ;
       fhir:ElementDefinition.short [ fhir:value "use" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Anvisningar i fri text som för patienten beskriver hur läkemedlet skall användas eller administreras t.ex. \"sväljes hela\", \"påstrykes i armvecket\". Fältet kan även rymma andra anvisningar, t.ex. sic[1] (eller obs).\n\nEtt förslag till text är tänkt att i vårdsystemet hämtas från SIL baserat på det läkemedel som valts, men kan behöva kompletteras manuellt.\n\nIngår i Expedieringsunderlag som en del av doseringstext 1." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../use` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 44 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.purpose" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.purpose" ] ;
       fhir:ElementDefinition.short [ fhir:value "Behandlingsändamål i klartext.Ingår i Expedieringsunderlag som Ändamål klartext" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Behandlingsändamål i klartext.\n\nIngår i Expedieringsunderlag som Ändamål klartext" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../purpose` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
