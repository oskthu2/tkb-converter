         fhir:ElementDefinition.base.path [ fhir:value "discontinuemedication.medicationPrescription.annotation" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 43 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.use" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.use" ] ;
       fhir:ElementDefinition.short [ fhir:value "use" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Anvisningar i fri text som för patienten beskriver hur läkemedlet skall användas eller administreras t.ex. \"sväljes hela\", \"påstrykes i armvecket\". Fältet kan även rymma andra anvisningar, t.ex. sic[1] (eller obs).\n\nEtt förslag till text är tänkt att i vårdsystemet hämtas från SIL baserat på det läkemedel som valts, men kan behöva kompletteras manuellt.\n\nIngår i Expedieringsunderlag som en del av doseringstext 1." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../use` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "discontinuemedication.medicationPrescription.use" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
