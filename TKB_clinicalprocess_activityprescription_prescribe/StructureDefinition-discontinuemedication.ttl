       ]
     ], [
       fhir:index 47 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.medication.DistributedDrug-attr.NPLid" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.medication.DistributedDrug_attr.NPLid" ] ;
       fhir:ElementDefinition.short [ fhir:value "NPLid" ] ;
       fhir:ElementDefinition.definition [ fhir:value "id som identifierar läkemedelsprodukt.\n\nHämtas från SIL.\n\nEx. Alvedon tablett 500 mg.\n\nObligatorisk parameter om Varunr saknas (dvs. om ordinationen ej gäller handelsvara).\n\nNPL = Nationellt Produktregister för Läkemedel, registrerade på Läkemedelsverket.\n\nObs att ingen interaktionskontroll i Sfinx kan göras utan NPL-id.\n\nÄr obligatorisk även vid ordination i NOD 1.0 (annars funkar inte interaktionskoll i SIL/Sfinx)\n\nIngår i Expedieringsunderlag." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../NPLid` (`Identifier`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ]
       ]
     ], [
       fhir:index 48 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.medication.DistributedDrug-attr.tradeName" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.medication.DistributedDrug_attr.tradeName" ] ;
       fhir:ElementDefinition.short [ fhir:value "tradeName" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Namn vid det tillfälle då ordinationen upprättades. Hämtas från SIL och sparas i NOD för att spårbarheten ska behållas även om benämningen ändras över tid.\n\nMöjlighet att utnyttja detta fält för \"fritextordination\" måste testas (t.ex. för studieläkemedel eller \"okänt läkemedel\")." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../tradeName` (`string`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 49 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.medication.DistributedDrug-attr.notInterchangable" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.medication.DistributedDrug_attr.notInterchangable" ] ;
       fhir:ElementDefinition.short [ fhir:value "notInterchangable" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Markering att ordinerad vara ej får bytas ut vid expediering\n\nFalskt = Får bytas ut\n\nSant = Får ej bytas ut\n\nNotera att beslutet att produkten inte får bytas ut normalt sker av medicinska skäl och att det därför inte enbart kan finnas på Expedieringsunderlaget." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../notInterchangable` (`boolean`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
