       fhir:ElementDefinition.short [ fhir:value "DistributedDrug" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Den Läkemedelsprodukt som Läkemedelsartikeln baseras på.(se not 1)" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../distributedDrug` (`DistributedDrug`, kardinalitet 1)." ] ;
