       ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "boolean" ]
       ]
     ], [
       fhir:index 42 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.annotation" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.annotation" ] ;
       fhir:ElementDefinition.short [ fhir:value "annotation" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ordinatörens kommentarer i fritext kopplade till en specifik ordination.\n\nSyftet är t.ex. att ordinatören i fritext ska kunna ange sådant som inte framgår av beslutsorsak eller ordinationsorsak och som är av intresse för annan vård- och omsorgspersonal.\n\nFältet är avsett att beskriva nuläget för läkemedelsbehandlingen utan att användaren ska behöva ta del av notatfältet i tidigare läkemedelsordinationer.\n\nFältet ingår inte i Expedieringsunderlag och kan t.ex. inte skrivas ut på etiketten vid expediering." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../annotation` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
