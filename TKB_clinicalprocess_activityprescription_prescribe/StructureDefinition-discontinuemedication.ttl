       fhir:ElementDefinition.short [ fhir:value "HealthcareProfessionalType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Ordinatör är den som är ansvarig för det medicinska beslutet för just den här den Läkemedelsordinationen och som (verksamhetsmässigt) signerat den.\n\nOrdinatören kan i undantagsfall sakna hsa-id och behöva anges med för- och efternamn i klartext.\n\nSe not 1." ] ;
