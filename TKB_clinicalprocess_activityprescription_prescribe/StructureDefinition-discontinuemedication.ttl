       ]
     ], [
       fhir:index 45 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.medication" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.medication" ] ;
       fhir:ElementDefinition.short [ fhir:value "Medication_virtual" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Det läkemedel (eller handelsvara) som Läkemedelsordinationen avser.\n\nDet finns i modellen ingen begränsning för vilka läkemedel som kan anges eller vilka byten som får ske inom en Läkemedelsbehandling. Det är dock rimligt att anta att någon form av begränsning är på sin plats (t.ex. att byte bara får ske inom samma ATC-kod), men en sådan begränsning är en verksamhetsregel som kan realiseras som en del av tjänsterna NOD eller i vårdsystemet.\n\nVid utsättning anges det läkemedel som sätts ut, dvs. det som angavs i den föregående Läkemedelsordinationen." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../medication` (`Medication_virtual`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 46 ;
       fhir:Element.id [ fhir:value "discontinuemedication.medicationPrescription.medication.DistributedDrug-attr" ] ;
       fhir:ElementDefinition.path [ fhir:value "discontinuemedication.medicationPrescription.medication.DistributedDrug_attr" ] ;
       fhir:ElementDefinition.short [ fhir:value "DistributedDrug" ] ;
       fhir:ElementDefinition.definition [ fhir:value "DistributedDrug_attr" ] ;
