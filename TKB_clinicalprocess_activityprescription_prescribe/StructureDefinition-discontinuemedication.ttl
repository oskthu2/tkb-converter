       fhir:ElementDefinition.short [ fhir:value "angiven kortnotation som beskriver doseringen" ] ;
       fhir:ElementDefinition.definition [ fhir:value "angiven kortnotation som beskriver doseringen" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
