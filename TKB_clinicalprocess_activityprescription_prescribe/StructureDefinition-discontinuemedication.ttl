       fhir:ElementDefinition.short [ fhir:value "NPLPackid" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id som identifierar läkemedelsartikel.\n\nHämtas från SIL.\n\nAnger läkemedel på nivån : Alvedon tablett 500 mg, 16 st blister." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../../NPLPackid` (`Identifier`, kardinalitet 1)." ] ;
