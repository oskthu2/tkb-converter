       fhir:ElementDefinition.short [ fhir:value "prescriberComment" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens kommentar till farmaceut.\n\nKommentaren skrivs ut på receptblanketten om e-receptet omvandlas till ett pappersrecept (dvs. skrivs ut på en receptblankett på apoteket)" ] ;
