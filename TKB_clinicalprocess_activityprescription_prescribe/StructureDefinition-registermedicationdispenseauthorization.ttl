       fhir:ElementDefinition.path [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber.hsaTitle" ] ;
       fhir:ElementDefinition.short [ fhir:value "Förskrivarens yrke i klartext. Fylls i av NOD vid läsning från LF. Krav vid presentation." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens yrke i klartext.\n\nFylls i av NOD vid läsning från LF. Krav vid presentation." ] ;
