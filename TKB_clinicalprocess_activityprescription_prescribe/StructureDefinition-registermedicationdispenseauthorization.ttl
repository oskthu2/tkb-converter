       ]
     ], [
       fhir:index 13 ;
       fhir:Element.id [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.medicationPrescriptionId" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.medicationPrescriptionId" ] ;
       fhir:ElementDefinition.short [ fhir:value "medicationPrescriptionId" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id på ursprunglig läkemedelsordination oavsett om läkemedelsordinationen ursprungligen skapats i NOD eller i ett vårdsystem och skickats som e-recept till OR/RR. Expedieringsunderlag som återskapas på information från OR/RR kan sakna ordinationsid.\n\nOm expedieringsunderlaget skapas av vårdsystemet \"löst\", dvs. utan referens till en Läkemedelsordination i NOD, ska vårdsystemet ange ordinationsid (som separat argument) för spårbarhet och för att kunna upptäcka dubbletter.\n\nOm Läkemedelsordination finns i NOD skapas ordinationsid av NOD-tjänsten." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../medicationPrescriptionId` (`Identifier`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ]
       ]
     ], [
       fhir:index 14 ;
       fhir:Element.id [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber" ] ;
       fhir:ElementDefinition.short [ fhir:value "MedicalPrescriber" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Sätts av NOD-tjänsten till inloggad användare (samma som registrerad av) för att säkerställa att förskrivaren är starkt autentiserad." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../prescriber` (`MedicalPrescriber`, kardinalitet 1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Base" ]
       ]
     ], [
       fhir:index 15 ;
       fhir:Element.id [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber.personalPrescriptionCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber.personalPrescriptionCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "personalPrescriptionCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens individuella förskrivarkod (7 tecken), legitimationskod (6 tecken) eller förskrivarens gruppförskrivarkod då individuell kod saknas.\n\nObligatorisk parameter om teknisk sprit eller läkemedel förskrivs.\n\nGruppförskrivarkod används då förskrivaren saknar individuell förskrivarkod men via sin roll har erhållit förskrivningsrätt. Kan exempelvis vara en AT-läkare eller förskrivare med förordnande. Förskrivarkoden definieras av Socialstyrelsen och gruppförskrivarkoden definieras av EHM.\n\nFör användare som har gruppförskrivarkod gäller:\n\nbefattningskod är obligatorisk\n\nFör läkare (LK) - yrkeskod (dvs LK) är obligatorisk.\n\nVid övriga yrken - yrkeskod och giltig legitimationskod är obligatoriska\n\nValideras i AFF\n\nHSA: förskrivarkod, även kallat personalPrescriptionCode\n\nRR: förskrivarkod" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../personalPrescriptionCode` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 16 ;
       fhir:Element.id [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber.legitimationCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber.legitimationCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "legitimationCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens 7-ställiga förskrivarkod alternativt 6-ställiga legitimationskod. Legitimationskod för förskrivare är annars de 6 första siffrorna i förskrivarkoden.\n\nSe gruppförskrivarkod för villkor.\n\nHSA: Legitimationskod för leg.vårdpersonal (sjuksköterskor) saknas i HSA. Det finns grupplegitimationskoder som kan användas.\n\nyrkeskod	Gruppkod	yrkeskod klartext\n\nSJ	971000	Sjuksköterska\n\nAP	972000	Apotekare\n\nRC	973000	Receptarie\n\nRR: legitimationskod" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../legitimationCode` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 17 ;
       fhir:Element.id [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber.hsaTitleCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber.hsaTitleCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "hsaTitleCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Yrkeskod som definierar vilken typ av legitimation som användaren innehar.\n\nSe gruppförskrivarkod för villkor.\n\nKontrolleras i receptregistret att personen har angiven yrkeskod.\n\nValideras i AFF\n\nHSA:Legitimerad yrkesgrupp, även kallad hsaTitle innehåller yrkeskoden i klartext. Detta fält (yrkeskod) avser dock motsvarande tvåställiga kod. Se:\"HSA Innehåll Legitimerad Yrkesgrupp\" på se www.inera.se/hsa.\n\nNotera också att samma användare kan inneha flera yrkesgrupper, t.ex. både Läkare och Sjuksköterska.\n\nRR: yrkeskod" ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../hsaTitleCode` (`string`, kardinalitet 1..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
       fhir:index 18 ;
       fhir:Element.id [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber.hsaTitle" ] ;
       fhir:ElementDefinition.path [ fhir:value "registermedicationdispenseauthorization.medicationDispenseAuthorization.prescriber.hsaTitle" ] ;
       fhir:ElementDefinition.short [ fhir:value "Förskrivarens yrke i klartext. Fylls i av NOD vid läsning från LF. Krav vid presentation." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Förskrivarens yrke i klartext.\n\nFylls i av NOD vid läsning från LF. Krav vid presentation." ] ;
       fhir:ElementDefinition.comment [ fhir:value "TKB-fält: `../../hsaTitle` (`string`, kardinalitet 0..1)." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "string" ]
       ]
     ], [
