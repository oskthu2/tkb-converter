       fhir:ElementDefinition.short [ fhir:value "Id på expedieringsunderlaget. Skapas av NOD-tjänsten (eller underliggande tjänster såsom av RR)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Id på expedieringsunderlaget. Skapas av NOD-tjänsten (eller underliggande tjänster såsom av RR)" ] ;
